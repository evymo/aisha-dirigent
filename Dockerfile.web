#
# Dockerfile.web — Builds Vite app and serves via nginx (SPA routing)
#
# Standalone 3-stage Dockerfile to avoid Coolify's ARG injection explosion.
# (Coolify adds ARG declarations for ALL env vars to EVERY stage; splitting into
# separate files keeps each build small enough for the shell argument limit.)
#
# Each build step is a separate RUN for better Docker cache and Coolify log visibility.
#

ARG REGISTRY_PROXY=
FROM ${REGISTRY_PROXY}library/node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# Copy scripts needed by postinstall hook (kept for compat though no postinstall script
# is currently defined in package.json — only `prepare: husky` which would fail in CI/Docker).
COPY scripts/ ./scripts/
# Production builds run `npm ci` which would trigger `prepare: husky` from
# package.json — but husky CLI isn't yet on PATH (chicken-and-egg) and we
# don't need git hooks in CI/Docker anyway.
#
# Strategy: delete just the prepare script then run npm ci normally. This
# keeps all bin symlinks (vite, eslint, etc.) intact unlike --ignore-scripts.
# --include=dev forces installation of devDependencies (vite, eslint, ...) even
# when NODE_ENV=production is set by Coolify or other CI; build stage needs them.
RUN npm pkg delete scripts.prepare && npm ci --include=dev

FROM deps AS build
WORKDIR /app

# Vite environment variables must be available at build time (vite build bakes them into the bundle).
# These are provided via Docker build args (e.g., by Coolify/docker-compose).
ARG VITE_AISHA_BACKEND_URL
ARG VITE_AISHA_BACKEND_ANON_KEY
ARG VITE_AISHA_BACKEND_PUBLISHABLE_KEY
ARG VITE_AISHA_POSTGREST_URL
ARG VITE_AISHA_POSTGREST_ANON_KEY
ARG VITE_AISHA_POSTGREST_PUBLISHABLE_KEY
ARG VITE_AISHA_GATEWAY_URL
ARG VITE_AISHA_GATEWAY_KEY
ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_PUBLIC_SITE_URL
ARG PUBLIC_SITE_URL
ARG VITE_SENTRY_DSN
ARG VITE_WEB_PUSH_VAPID_PUBLIC_KEY
ARG VITE_REQUIRE_AISHA_BACKEND_ENV=false
ARG VITE_REQUIRE_AISHA_POSTGREST_ENV=false

# Keycloak OIDC — baked into the Vite bundle at build time
ARG VITE_KC_URL
ARG VITE_KC_AUTHORITY
ARG VITE_KC_CLIENT_ID
ARG VITE_AUTH_REDIRECT_URI
ARG VITE_AUTH_POST_LOGOUT_URI

# ── Brand SEO/OG placeholders for index.html ─────────────────
# Consumed by brandPlaceholderPlugin in vite.config.ts at build time.
# Missing ARG → Coolify passes empty string → the plugin falls back to
# BRAND_PLACEHOLDER_DEFAULTS (upstream AISHA / Evymo identity). Tenant
# instances set the corresponding env in their
# Coolify app config and the plugin substitutes brand-specific values
# into the shipped index.html — crawler-visible, no JS dependency.
ARG VITE_PUBLIC_BRAND_LANG
ARG VITE_PUBLIC_BRAND_TITLE
ARG VITE_PUBLIC_BRAND_DESCRIPTION
ARG VITE_PUBLIC_BRAND_AUTHOR
ARG VITE_PUBLIC_BRAND_PRIMARY
ARG VITE_PUBLIC_BRAND_THEME_COLOR
ARG VITE_PUBLIC_BRAND_OG_LOCALE
ARG VITE_PUBLIC_BRAND_OG_SITE_NAME
ARG VITE_PUBLIC_BRAND_OG_DESCRIPTION
ARG VITE_PUBLIC_BRAND_OG_IMAGE

# Sentry source maps upload.
# SENTRY_AUTH_TOKEN is deliberately NOT an ARG: an ARG value is recorded in the
# image metadata and `docker history` hands it to anyone who can read the image.
# It comes in as a BuildKit secret instead (see the step 4/4 RUN below), which
# is written to no layer. It is a sentry-cli credential used to create a release
# — it never enters the browser bundle, and must not enter the image either.
ARG SENTRY_DSN
ARG SENTRY_URL
ARG SENTRY_ORG=sentry
ARG SENTRY_PROJECT=platform-web
ARG GIT_SHA

COPY . .

# ── Step 1/4: Design tokens ──────────────────────────────────
RUN echo "[1/4] design-tokens:build" && node packages/design-tokens/build.mjs

# ── Step 2/4: i18n check ─────────────────────────────────────
# For local/dev Docker builds we can skip the strict content SQL seed parity
# (demo data / local dev often intentionally drift from full prod content seeds).
# Prod/CI builds keep SKIP_I18N_CHECK=false (or unset) so the full gate runs
# and guarantees images are i18n-consistent.
ARG SKIP_I18N_CHECK=false
RUN if [ "$SKIP_I18N_CHECK" != "true" ]; then \
      echo "[2/4] i18n:check" && npm run i18n:check; \
    else \
      echo "[2/4] i18n:check (skipped for local/dev build)"; \
    fi

# ── Step 2b/4: render public app-config from env (operator-baked) ────
# Substitutes ${VAR} placeholders in public/.well-known/app-config.template.json
# with the deployment env values (API_DOMAIN_PUBLIC, KEYCLOAK_DOMAIN, ...). The
# committed app-config.json is a stub overwritten here so the SPA ships with
# the operator's URLs already baked in (mobile-app + dirigent extension fall
# back to this static file when the gateway's dynamic endpoint is unavailable).
# Declared as ARGs (not just consumed in the RUN): the build INPUT must be
# explicit so the per-app env filter (extract_dockerfile_arg_vars) delivers
# the values to this app — relying on Coolify's implicit ARG injection alone
# left them unsynced and failed the cold-start here (2026-06-11).
ARG KEYCLOAK_REALM=aisha
ARG MATRIX_DOMAIN=""
ARG DIRIGENT_DOMAIN=""
# GATEWAY_DOMAIN_PUBLIC (ask.${PUBLIC_TLD}) backs the template's ask_url. Declared
# as an explicit ARG — like the domains above — so extract_dockerfile_arg_vars
# delivers it to THIS app's build. It was added to app-config.template.json but
# not here, so render-app-config FATAL'd ("missing values for: GATEWAY_DOMAIN_PUBLIC")
# on the aisha-edge web build when Coolify's implicit ARG injection didn't cover it
# (2026-07-13 cold-start outage). Optional/capability-gated: derive-domains always
# emits a value (real ask.<tld> or the gateway-disabled.invalid sentinel).
ARG GATEWAY_DOMAIN_PUBLIC=""
RUN echo "[2b/4] render-app-config" && \
	API_DOMAIN_PUBLIC="${VITE_API_URL#https://}" \
	API_DOMAIN_PUBLIC="${API_DOMAIN_PUBLIC%/*}" \
	APP_DOMAIN="${VITE_PUBLIC_SITE_URL#https://}" \
	APP_DOMAIN="${APP_DOMAIN%/*}" \
	KEYCLOAK_DOMAIN="${VITE_KC_URL#https://}" \
	KEYCLOAK_DOMAIN="${KEYCLOAK_DOMAIN%/*}" \
	KEYCLOAK_REALM="${KEYCLOAK_REALM:?jméno realmu je identita instance — nedosazuje se}" \
	ANON_KEY="${VITE_AISHA_BACKEND_ANON_KEY:-${VITE_AISHA_POSTGREST_ANON_KEY:-}}" \
	MATRIX_DOMAIN="${MATRIX_DOMAIN:-}" \
	DIRIGENT_DOMAIN="${DIRIGENT_DOMAIN:-}" \
	GATEWAY_DOMAIN_PUBLIC="${GATEWAY_DOMAIN_PUBLIC:-}" \
	node scripts/render-app-config.mjs
# NOTE: no `|| echo` swallow here — render-app-config.mjs is designed to FATAL
# on missing domain keys and the coolify-env-contract gate documents that the
# image build MUST abort then (otherwise the SPA ships the invalid __VAR__ stub
# as the static fallback consumed by mobile-app + dirigent extension).

# ── Step 3/4: Vite build ─────────────────────────────────────
# Coolify injects empty ARG values that shadow compose build args.
# We use explicit self-hosted defaults so the build always targets
# the correct AISHA backend instance even when Coolify nukes the ARGs.
RUN VITE_AISHA_POSTGREST_URL="${VITE_AISHA_BACKEND_URL:-${VITE_AISHA_POSTGREST_URL:-}}" \
	VITE_AISHA_POSTGREST_PUBLISHABLE_KEY="${VITE_AISHA_BACKEND_PUBLISHABLE_KEY:-${VITE_AISHA_POSTGREST_PUBLISHABLE_KEY:-}}" \
	VITE_AISHA_POSTGREST_ANON_KEY="${VITE_AISHA_BACKEND_ANON_KEY:-${VITE_AISHA_POSTGREST_ANON_KEY:-${VITE_AISHA_POSTGREST_PUBLISHABLE_KEY:-}}}" \
	VITE_AISHA_GATEWAY_URL="${VITE_AISHA_GATEWAY_URL:-}" \
	VITE_AISHA_GATEWAY_KEY="${VITE_AISHA_GATEWAY_KEY:-}" \
	VITE_API_URL="${VITE_API_URL:-${VITE_AISHA_GATEWAY_URL:-}}" \
	VITE_WS_URL="${VITE_WS_URL:-}" \
	VITE_PUBLIC_SITE_URL="${VITE_PUBLIC_SITE_URL:-}" \
	PUBLIC_SITE_URL="${PUBLIC_SITE_URL:-}" \
	VITE_SENTRY_DSN="${VITE_SENTRY_DSN:-}" \
	VITE_WEB_PUSH_VAPID_PUBLIC_KEY="${VITE_WEB_PUSH_VAPID_PUBLIC_KEY:-}" \
	VITE_REQUIRE_AISHA_POSTGREST_ENV="${VITE_REQUIRE_AISHA_BACKEND_ENV:-${VITE_REQUIRE_AISHA_POSTGREST_ENV:-false}}" \
	VITE_KC_URL="${VITE_KC_URL:-}" \
	VITE_KC_AUTHORITY="${VITE_KC_AUTHORITY:-}" \
	VITE_KC_CLIENT_ID="${VITE_KC_CLIENT_ID:-aisha-app}" \
	VITE_AUTH_REDIRECT_URI="${VITE_AUTH_REDIRECT_URI:-}" \
	VITE_AUTH_POST_LOGOUT_URI="${VITE_AUTH_POST_LOGOUT_URI:-}" \
	VITE_PUBLIC_BRAND_LANG="${VITE_PUBLIC_BRAND_LANG:-}" \
	VITE_PUBLIC_BRAND_TITLE="${VITE_PUBLIC_BRAND_TITLE:-}" \
	VITE_PUBLIC_BRAND_DESCRIPTION="${VITE_PUBLIC_BRAND_DESCRIPTION:-}" \
	VITE_PUBLIC_BRAND_AUTHOR="${VITE_PUBLIC_BRAND_AUTHOR:-}" \
	VITE_PUBLIC_BRAND_THEME_COLOR="${VITE_PUBLIC_BRAND_THEME_COLOR:-}" \
	VITE_PUBLIC_BRAND_OG_LOCALE="${VITE_PUBLIC_BRAND_OG_LOCALE:-}" \
	VITE_PUBLIC_BRAND_OG_SITE_NAME="${VITE_PUBLIC_BRAND_OG_SITE_NAME:-}" \
	VITE_PUBLIC_BRAND_OG_DESCRIPTION="${VITE_PUBLIC_BRAND_OG_DESCRIPTION:-}" \
	VITE_PUBLIC_BRAND_OG_IMAGE="${VITE_PUBLIC_BRAND_OG_IMAGE:-}" \
	sh -c ' \
		echo "[3/4] vite build"; \
		echo "  env: urlLen=${#VITE_AISHA_POSTGREST_URL} anonLen=${#VITE_AISHA_POSTGREST_ANON_KEY} apiLen=${#VITE_API_URL} gwLen=${#VITE_AISHA_GATEWAY_URL} siteLen=${#VITE_PUBLIC_SITE_URL} sentryLen=${#VITE_SENTRY_DSN} kcLen=${#VITE_KC_AUTHORITY}"; \
		echo "  brand: titleLen=${#VITE_PUBLIC_BRAND_TITLE} ogSiteLen=${#VITE_PUBLIC_BRAND_OG_SITE_NAME} themeLen=${#VITE_PUBLIC_BRAND_THEME_COLOR} (0 = nedeklarováno → brandPlaceholderPlugin dosadí default šablony; deklaruj VITE_PUBLIC_BRAND_* a bude tam značka instance)"; \
		./node_modules/.bin/vite build \
	'

# ── Step 4/4: Sentry release (optional) ──────────────────────
RUN --mount=type=secret,id=sentry_auth_token,required=false \
	SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token 2>/dev/null || true)"; \
	if [ -n "${SENTRY_AUTH_TOKEN:-}" ]; then \
		echo "[4/4] Creating Sentry release..."; \
		apk add --no-cache curl bash; \
		curl -sL https://sentry.io/get-cli/ | bash; \
		VERSION="${GIT_SHA:-unknown}"; \
		export SENTRY_URL="${SENTRY_URL:-}" SENTRY_ORG="${SENTRY_ORG:-sentry}" \
			SENTRY_PROJECT="${SENTRY_PROJECT:-platform-web}" SENTRY_AUTH_TOKEN="${SENTRY_AUTH_TOKEN}"; \
		sentry-cli releases new "$VERSION" || true; \
		sentry-cli releases set-commits "$VERSION" --auto || true; \
		sentry-cli releases finalize "$VERSION" || true; \
		echo "Sentry release created: $VERSION"; \
	else \
		echo "[4/4] Skipping Sentry release (no SENTRY_AUTH_TOKEN)"; \
	fi

FROM ${REGISTRY_PROXY}library/nginx:1.27-alpine AS web
WORKDIR /usr/share/nginx/html
COPY --from=build /app/dist ./
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

# ⛔ SKOŘÁPKA PRO GENERÁTOR musí být z TOHOTO buildu. Vite hashuje jména
# chunků (`shared-BL9zUP3B.js`), takže generátor je nesmí hádat — čte je
# z index.html, který právě servírujeme. Kopie do sdíleného volume `/shell`
# se obnovuje při každém startu, takže po redeploy nikdy neodkazuje na
# soubory z předchozí verze.
# `|| true`: bez připojeného volume (např. samostatný běh obrazu) se webserver
# nesmí odmítnout spustit — generátor je volitelná vrstva, ne podmínka.
CMD ["/bin/sh", "-c", "mkdir -p /shell && cp /usr/share/nginx/html/index.html /shell/index.html || true; exec nginx -g 'daemon off;'"]
