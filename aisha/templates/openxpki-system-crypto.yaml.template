# System wide crypto config — rendered runtime by pki-init from ENV.
#
# Source: https://github.com/openxpki/openxpki-config/blob/community/config.d/system/crypto.yaml
# Modifications: __PKI_SVAULT_KEY__ placeholder for sed substitution by
#                pki-init entrypoint (docker-compose.coolify-pki.yml).
#
# DO NOT EDIT this file in /etc/openxpki/ — it gets overwritten on every
# pki-init run. Edit this template and redeploy.
#
# Secret variant B (state of the art): all secrets from Coolify ENV, NEVER in git.
# PKI_SVAULT_KEY is auto-generated by aisha-cold-start.sh + persisted to .env.coolify
# (per-instance unique). Rotation = update env + redeploy + re-encrypt vault data.

token:
    default:
        backend: OpenXPKI::Crypto::Backend::OpenSSL
        api:     OpenXPKI::Crypto::Backend::API
        engine:  OpenSSL
        key_store: OPENXPKI

        # OpenSSL binary location
        shell: /usr/bin/openssl

        # OpenSSL binary call gets wrapped with this command
        wrapper: ''

        # random file to use for OpenSSL
        randfile: /var/openxpki/rand

    javaks:
        backend: OpenXPKI::Crypto::Tool::CreateJavaKeystore
        api: OpenXPKI::Crypto::Tool::CreateJavaKeystore::API
        engine:  OpenSSL
        key_store: OPENXPKI
        shell: /usr/bin/keytool
        randfile: /var/openxpki/rand

# Secret group to be shared in all realms
secret:
    # `default` is the password OpenXPKI uses to *decrypt* every CA issuer
    # private key (vault-1.pem, rootca-<realm>.key) at sign time. The
    # pki-realm-bootstrap.sh script generates and encrypts those PEM files
    # at first boot — and the encryption password MUST match what OpenXPKI
    # provides via this `default` secret, or `openssl ca` fails with
    # PKCS12 `bad decrypt` / "maybe wrong password" and the workflow
    # exhausts its retry budget without ever issuing a certificate
    # (operator-visible as a hung pki-bridge /v1/issue HTTP 504).
    #
    # Upstream ships `value: root` for demo installs. AISHA collapses
    # `default` onto the same per-instance hex as `svault` below (the
    # datapool master) — the two secrets share Coolify's encryption-at-rest
    # and the same Coolify env-store threat surface, so keeping them
    # distinct adds no real defense-in-depth. pki-realm-bootstrap.sh
    # encrypts CA keys with `${PKI_SVAULT_KEY}` to match.
    default:
        label: Global secret group
        export: 0
        method: literal
        value: __PKI_SVAULT_KEY__

    # Vault secret for encrypting confidential data in the database.
    # Rendered from PKI_SVAULT_KEY env (Coolify per-app, .env.coolify auto-generated).
    svault:
        label: Secret group for datavault encryption
        method: literal
        value: __PKI_SVAULT_KEY__
