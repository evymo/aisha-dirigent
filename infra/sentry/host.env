# host.env — DEKLARACE hostitele self-hosted Sentry. Jediný domov těchto hodnot;
# `apply-host-config.sh` je čte odsud a bez nich skončí (žádné výchozí hodnoty
# v kódu). Není to tajemství — je to popis stroje, proto je verzovaný.
#
# Naměřeno 2026-09-01/02: 28GB disk, ~10 GB obrazy + ~9 GB data ⇒ retence 90
# dní se nevejde; žurnál bez stropu narostl na 2,6 GB.
SENTRY_DIR=/root/self-hosted
RETENTION_DAYS=30
JOURNAL_MAX=200M
JOURNAL_KEEP_FREE=2G
SWAPFILE=/swapfile
SWAP_SIZE=4G
