    {
      "parameters": {
        "category": "custom",
        "functionName": "get_audit_aggregates",
        "rpcParams": "={{ JSON.stringify({ p_window_days: 7, p_min_occurrences: 5 }) }}",
        "authMode": "service_role",
        "options": {
          "timeout": 30000,
          "auditTrail": true
        },
        "onError": "continueRegularOutput"
      },
      "id": "fetch-aggregates",
      "name": "Fetch Audit Aggregates",
      "type": "n8n-nodes-aisha.aishaRpc",
      "typeVersion": 1,
      "position": [
        440,
        300
      ],
      "credentials": {
        "aishaPostgrestApi": {
          "id": "__REMAP__",
          "name": "AISHA PostgREST"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Pattern detection: classify each action aggregate into proposal kind\n//\n// Heuristics:\n//   - Action ending in '_failed' / '_error' that has corresponding success → propose hook (block + suggest)\n//   - Action sequence with high occurrence + success rate → propose skill\n//   - Frequently-paired actions (A always followed by B) → propose command\n//\n// This is a v1 stub — replace with proper pattern miner per\n// docs/AISHA_SELF_TOOLING.md.\n\nconst aggregates = $input.all().map(i => i.json);\nconst proposals = [];\n\nfor (const agg of aggregates) {\n  const action = agg.action;\n  const count = agg.occurrence_count;\n  const successRate = parseFloat(agg.success_rate || 0);\n\n  // Skip system/internal actions\n  if (action.startsWith('aisha_self_') || action.includes('audit')) continue;\n\n  // Pattern: high-frequency action with high success → skill candidate\n  if (count >= 10 && successRate >= 0.8) {\n    proposals.push({\n      pattern_kind: 'recurring_procedure',\n      target_factory: 'WF_AISHA_SKILL_FACTORY',\n      pattern: {\n        action,\n        occurrence_count: count,\n        success_rate: successRate,\n        unique_users: agg.unique_users,\n        first_seen: agg.first_seen,\n        last_seen: agg.last_seen,\n        recent_metadata: agg.recent_metadata,\n      },\n    });\n  }\n\n  // Pattern: action with low success rate → hook candidate\n  if (count >= 5 && successRate < 0.5) {\n    proposals.push({\n      pattern_kind: 'repeated_mistake',\n      target_factory: 'WF_AISHA_HOOK_FACTORY',\n      pattern: {\n        action,\n        occurrence_count: count,\n        success_rate: successRate,\n        recent_metadata: agg.recent_metadata,\n      },\n    });\n  }\n\n  // Pattern: multi-step action sequence → command candidate\n  // Heuristic: action_name contains both verb + noun (e.g., 'deploy_story', 'restore_app_state')\n  // and the metadata indicates step_index/sequence_number → likely a procedure\n  const isMultiStep = /^(deploy|restore|bootstrap|migrate|switch|rotate|configure|provision)_/.test(action);\n  if (isMultiStep && count >= 6 && successRate >= 0.7) {\n    proposals.push({\n      pattern_kind: 'paired_sequence',\n      target_factory: 'WF_AISHA_COMMAND_FACTORY',\n      pattern: {\n        action,\n        actions: [action],\n        occurrence_count: count,\n        success_rate: successRate,\n        recent_metadata: agg.recent_metadata,\n      },\n    });\n  }\n}\n\nreturn proposals.map(p => ({ json: p }));"
      },
      "id": "detect-patterns",
      "name": "Detect Patterns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
