        "url": "={{ $env?.AISHA_POSTGREST_URL || '' }}/functions/v1/mcp-knowledge-server",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"route_task\",\n    \"arguments\": {\n      \"task_kind\": \"pr_gate\",\n      \"risk_profile\": \"medium\",\n      \"story_id\": {{ $json.story_id ? '\"' + $json.story_id + '\"' : 'null' }}\n    }\n  }\n}",
        "options": {}
      },
      "id": "route-task",
      "name": "Route Task (PR Gate)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Z7oSSowoqk0ZgB8X",
          "name": "AISHA Supabase (Service Role)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract story_id from PR branch name or labels\nconst pr = $('GitHub PR Webhook').item.json.body.pull_request;\nconst branch = pr.head.ref || '';\nconst labels = (pr.labels || []).map(l => l.name);\n\n// Try to extract story_id from branch pattern: story/<uuid> or feature/<uuid>\nconst uuidPattern = /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i;\nconst branchMatch = branch.match(uuidPattern);\nconst labelMatch = labels.find(l => l.match(uuidPattern));\n\nconst storyId = branchMatch ? branchMatch[0] : (labelMatch ? labelMatch.match(uuidPattern)[0] : null);\n\nreturn {\n  story_id: storyId,\n  pr_number: pr.number,\n  pr_title: pr.title,\n  repo_full_name: $('GitHub PR Webhook').item.json.body.repository.full_name,\n  head_sha: pr.head.sha,\n  diff_text: $('Get PR Diff').item.json.data?.substring(0, 50000) || '(no diff)',\n};"
      },
      "id": "extract-context",
      "name": "Extract PR Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env?.AISHA_POSTGREST_URL || '' }}/functions/v1/mcp-knowledge-server",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"validate_compliance\",\n    \"arguments\": {\n      \"story_id\": {{ $('Extract PR Context').item.json.story_id ? '\"' + $('Extract PR Context').item.json.story_id + '\"' : '\"00000000-0000-0000-0000-000000000000\"' }}\n    }\n  }\n}",
        "options": {}
      },
      "id": "validate-compliance",
