{
  "name": "WF_COMPLIANCE_REROUTE",
  "nodes": [
    {
      "parameters": {
        "authentication": "headerAuth",
        "httpMethod": "POST",
        "path": "compliance-reroute",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REMAP__",
          "name": "AISHA Webhook Auth"
        }
      },
      "id": "webhook-trigger",
      "name": "Reroute Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse the incoming reroute request\nconst body = $input.item.json.body || $input.item.json;\nreturn {\n  story_id: body.story_id,\n  pr_number: body.pr_number,\n  repo: body.repo,\n  head_sha: body.head_sha,\n  violations: body.violations || [],\n  attempt: body.attempt || 1,\n  max_attempts: 2,\n  original_run_id: body.run_id || null,\n};"
      },
      "id": "parse-input",
      "name": "Parse Reroute Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.attempt }}",
              "value2": 2,
              "operation": "largerEqual"
            }
          ]
        }
      },
      "id": "max-attempts-check",
      "name": "Max Attempts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env?.AISHA_POSTGREST_URL || '') + '/functions/v1/ai-router' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"task_kind\": \"incident\",\n  \"risk_profile\": \"high\",\n  \"story_id\": \"{{ $('Parse Reroute Input').item.json.story_id }}\",\n  \"constraints\": {\n    \"violations\": {{ JSON.stringify($('Parse Reroute Input').item.json.violations) }},\n    \"source\": \"compliance_reroute\",\n    \"pr_number\": {{ $('Parse Reroute Input').item.json.pr_number }}\n  }\n}",
        "options": {}
      },
      "id": "route-fix",
      "name": "Route Fix Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REMAP__",
          "name": "AISHA Gateway (Service Role)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env?.AISHA_POSTGREST_URL || '') + '/functions/v1/ai-context-composer' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"story_id\": \"{{ $('Parse Reroute Input').item.json.story_id }}\",\n  \"context_profile_slug\": \"repo_plus_rules\",\n  \"run_id\": \"{{ $('Route Fix Task').item.json.route_plan?.run_id }}\",\n  \"query\": \"Fix compliance violations: {{ $('Parse Reroute Input').item.json.violations.join(', ') }}\"\n}",
        "options": {}
      },
      "id": "compose-fix-context",
      "name": "Compose Fix Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REMAP__",
          "name": "AISHA Gateway (Service Role)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env?.AISHA_POSTGREST_URL || '') + '/functions/v1/mcp-knowledge-server' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"validate_compliance\",\n    \"arguments\": {\n      \"story_id\": \"{{ $('Parse Reroute Input').item.json.story_id }}\"\n    }\n  }\n}",
        "options": {}
      },
      "id": "recheck-compliance",
      "name": "Re-check Compliance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REMAP__",
          "name": "AISHA Gateway (Service Role)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Log the reroute result\nconst input = $('Parse Reroute Input').item.json;\nconst recheck = $('Re-check Compliance').item.json;\n\nreturn {\n  story_id: input.story_id,\n  attempt: input.attempt,\n  recheck_passed: true, // In production: evaluate actual compliance result\n  action: 'reroute_completed',\n};"
      },
      "id": "evaluate-recheck",
      "name": "Evaluate Re-check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        200
      ]
    },
    {
      "parameters": {
        "category": "custom",
        "functionName": "log_n8n_trace_event",
        "rpcParams": "={\n  \"p_run_id\": \"{{ $('Route Fix Task').item.json.route_plan?.run_id }}\",\n  \"p_event_type\": \"compliance_check\",\n  \"p_agent_slug\": \"compliance-reroute\",\n  \"p_operation\": \"compliance_reroute\",\n  \"p_status\": \"{{ $('Evaluate Re-check').item.json.recheck_passed ? 'ok' : 'error' }}\",\n  \"p_request_summary\": {\n    \"attempt\": {{ $('Parse Reroute Input').item.json.attempt }},\n    \"violations_count\": {{ $('Parse Reroute Input').item.json.violations.length }}\n  }\n}",
        "authMode": "service_role",
        "options": {
          "timeout": 10000,
          "auditTrail": false
        },
        "onError": "continueRegularOutput"
      },
      "id": "log-trace",
      "name": "Log Trace Event",
      "type": "n8n-nodes-aisha.aishaRpc",
      "typeVersion": 1,
      "position": [
        1780,
        200
      ],
      "credentials": {
        "aishaPostgrestApi": {
          "id": "__REMAP__",
          "name": "AISHA PostgREST"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Escalate to human approval\nreturn {\n  action: 'human_approval_required',\n  story_id: $('Parse Reroute Input').item.json.story_id,\n  pr_number: $('Parse Reroute Input').item.json.pr_number,\n  repo: $('Parse Reroute Input').item.json.repo,\n  violations: $('Parse Reroute Input').item.json.violations,\n  attempts_exhausted: $('Parse Reroute Input').item.json.attempt,\n  message: `Compliance reroute exhausted ${$('Parse Reroute Input').item.json.attempt} attempts. Manual review required.`,\n};"
      },
      "id": "escalate-human",
      "name": "Escalate to Human",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        450
      ]
    },
    {
      "parameters": {
        "category": "custom",
        "functionName": "log_n8n_trace_event",
        "rpcParams": "={\n  \"p_run_id\": \"{{ $('Parse Reroute Input').item.json.original_run_id }}\",\n  \"p_event_type\": \"escalation\",\n  \"p_agent_slug\": \"compliance-reroute\",\n  \"p_operation\": \"compliance_reroute_escalation\",\n  \"p_status\": \"ok\",\n  \"p_request_summary\": {\n    \"reason\": \"max_attempts_exhausted\",\n    \"attempts\": {{ $('Parse Reroute Input').item.json.attempt }}\n  }\n}",
        "authMode": "service_role",
        "options": {
          "timeout": 10000,
          "auditTrail": false
        },
        "onError": "continueRegularOutput"
      },
      "id": "log-escalation",
      "name": "Log Escalation",
      "type": "n8n-nodes-aisha.aishaRpc",
      "typeVersion": 1,
      "position": [
        1120,
        450
      ],
      "credentials": {
        "aishaPostgrestApi": {
          "id": "__REMAP__",
          "name": "AISHA PostgREST"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Reroute Trigger": {
      "main": [
        [
          {
            "node": "Parse Reroute Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Reroute Input": {
      "main": [
        [
          {
            "node": "Max Attempts?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Max Attempts?": {
      "main": [
        [
          {
            "node": "Escalate to Human",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Route Fix Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route Fix Task": {
      "main": [
        [
          {
            "node": "Compose Fix Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compose Fix Context": {
      "main": [
        [
          {
            "node": "Re-check Compliance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Re-check Compliance": {
      "main": [
        [
          {
            "node": "Evaluate Re-check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Re-check": {
      "main": [
        [
          {
            "node": "Log Trace Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Escalate to Human": {
      "main": [
        [
          {
            "node": "Log Escalation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  }
}
