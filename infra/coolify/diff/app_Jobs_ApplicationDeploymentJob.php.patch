+            // Confirm what arrived instead of assuming it did. `docker load` can
+            // report success on a truncated archive -- one transfer here died with
+            // "short read: expected 3708 bytes" -- and the images are dropped from
+            // the build server a few lines below, so an unnoticed gap leaves the
+            // only copy nowhere. Checking here fails with the real reason at the
+            // point it happened, rather than later as "pull access denied".
+            $loaded = instant_remote_process(["docker images --filter reference='{$this->application->uuid}_*:{$this->commit}' --format '{{.Repository}}:{{.Tag}}'"], $this->mainServer, false);
