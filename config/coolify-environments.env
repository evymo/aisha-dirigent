# =============================================================================
# coolify-environments.env — Per-environment Coolify endpoints + creds aliases
# =============================================================================
# Single source of truth for mapping AISHA_ENV → concrete Coolify cluster.
# Scripts (aisha-cold-start, redeploy, drift-watch) source this file and
# pick the right values by AISHA_ENV:
#
#   AISHA_ENV=production  → COOLIFY_BASE_URL = production
#   AISHA_ENV=staging     → COOLIFY_BASE_URL = staging
#
# Creds (COOLIFY_API_TOKEN, FORGEJO_API_TOKEN) live in .env-prod-backup
# resp. .env-staging-backup (per-env).
#
# Iter 17 — template-only SoT. All Coolify URLs / project UUIDs / server
# UUIDs are env-templated; the AISHA reference deploy values live in
# `coolify-environments.env.example`. Operator forks the repo and either:
#   (a) Sets the env vars in their .env-prod-backup overlay
#   (b) Copies coolify-environments.env.example → coolify-environments.env
#       and edits with their own Coolify cluster identity
# =============================================================================

# Default environment when AISHA_ENV is not set
AISHA_ENV_DEFAULT=production

# ── Production ──────────────────────────────────────────────────────────────
COOLIFY_PROD_URL=${COOLIFY_PROD_URL:-}
COOLIFY_PROD_PROJECT_UUID=${COOLIFY_PROD_PROJECT_UUID:-}
COOLIFY_PROD_SERVER_UUID_FRONTEND=${COOLIFY_PROD_SERVER_UUID_FRONTEND:-}
COOLIFY_PROD_SERVER_UUID_BACKEND=${COOLIFY_PROD_SERVER_UUID_BACKEND:-}
COOLIFY_PROD_SERVER_UUID_EXPERIMENTAL=${COOLIFY_PROD_SERVER_UUID_EXPERIMENTAL:-}
COOLIFY_PROD_SERVER_UUID_BUILD=${COOLIFY_PROD_SERVER_UUID_BUILD:-}
COOLIFY_PROD_ENV_BACKUP=.env-prod-backup
COOLIFY_PROD_DOMAINS_FILE=${COOLIFY_PROD_DOMAINS_FILE:-config/domains.env}
COOLIFY_PROD_ENV_FILE=${COOLIFY_PROD_ENV_FILE:-.env.coolify}
# Stroj slotu se deklaruje JMÉNEM, ne uuid: uuid se při přeprovizování Coolify
# přerazí, jméno ne — a deklarovaný, ale neexistující server je fail-loud.
# Bez tohohle propadl slot na heuristiku „slot s Traefikem = Coolify host"
# a produkce vznikla na cizím stroji (naměřeno 2026-09-03).
COOLIFY_PROD_SERVER_NAME_FRONTEND=${COOLIFY_PROD_SERVER_NAME_FRONTEND:-}
COOLIFY_PROD_SERVER_NAME_BACKEND=${COOLIFY_PROD_SERVER_NAME_BACKEND:-}
COOLIFY_PROD_SERVER_NAME_EXPERIMENTAL=${COOLIFY_PROD_SERVER_NAME_EXPERIMENTAL:-}

# Story + profil PROSTŘEDÍ. ⛔ NAMĚŘENO 2026-09-04: `aisha-cold-start-env.sh` je
# kanonický vstupní bod, ale bez těchhle klíčů spadl na `story=aisha
# profile=<default>` a sáhl po UPSTREAMOVÉM coolify/manifests/aisha.manifest —
# tedy po cizím inventáři aplikací. Fungovalo to jen proto, že se AISHA_STORY /
# AISHA_PROFILE exportovaly ručně mimo wrapper; ruční export ale není deklarace.
# Hodnoty patří do .env.local / .env-<env>-backup (per instance), sem jen tvar:
# tenhle soubor sdílejí VŠECHNA prostředí i forky.
COOLIFY_PROD_STORY=${COOLIFY_PROD_STORY:-}
COOLIFY_PROD_PROFILE=${COOLIFY_PROD_PROFILE:-}
COOLIFY_STAGING_STORY=${COOLIFY_STAGING_STORY:-}
COOLIFY_STAGING_PROFILE=${COOLIFY_STAGING_PROFILE:-}

# ── Staging ─────────────────────────────────────────────────────────────────
COOLIFY_STAGING_URL=${COOLIFY_STAGING_URL:-}
COOLIFY_STAGING_PROJECT_UUID=${COOLIFY_STAGING_PROJECT_UUID:-}
COOLIFY_STAGING_SERVER_UUID_FRONTEND=${COOLIFY_STAGING_SERVER_UUID_FRONTEND:-}
COOLIFY_STAGING_SERVER_UUID_BACKEND=${COOLIFY_STAGING_SERVER_UUID_BACKEND:-}
COOLIFY_STAGING_SERVER_UUID_EXPERIMENTAL=${COOLIFY_STAGING_SERVER_UUID_EXPERIMENTAL:-}
COOLIFY_STAGING_ENV_BACKUP=.env-staging-backup
COOLIFY_STAGING_DOMAINS_FILE=${COOLIFY_STAGING_DOMAINS_FILE:-config/domains-staging.env}
COOLIFY_STAGING_ENV_FILE=${COOLIFY_STAGING_ENV_FILE:-.env.staging}
COOLIFY_STAGING_SERVER_NAME_FRONTEND=${COOLIFY_STAGING_SERVER_NAME_FRONTEND:-}
COOLIFY_STAGING_SERVER_NAME_BACKEND=${COOLIFY_STAGING_SERVER_NAME_BACKEND:-}
COOLIFY_STAGING_SERVER_NAME_EXPERIMENTAL=${COOLIFY_STAGING_SERVER_NAME_EXPERIMENTAL:-}

# Instanční sekce (endpoint, project/server UUID, manifest, doménový overlay,
# env záloha) do TÉHOHLE souboru NEPATŘÍ — jsou to živé identifikátory jednoho
# nasazení. Instance je drží ve svém vlastním instance-data checkoutu a
# cold-start je bere odtud.
