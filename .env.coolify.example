# ═══════════════════════════════════════════════════════════════════════════════
# .env.coolify.example — AISHA AI Orchestrator (Self-hosted All-in-One)
# ═══════════════════════════════════════════════════════════════════════════════
#
# Tento soubor je ŠABLONA pro Coolify Environment Variables.
# Zkopíruj obsah do Coolify UI → Project → Environment Variables.
#
# Docker-compose.coolify.yml má fallback hodnoty pro všechny interní secrets,
# takže deploy funguje i BEZ tohoto souboru. Pro PRODUKCI ale doporučujeme:
#
#   1. Přegenerovat secrets:  node scripts/generate-deploy-keys.mjs
#   2. Nastavit domény: APP_DOMAIN, API_DOMAIN, STUDIO_DOMAIN
#   3. Nastavit SMTP pro email delivery
#   4. Nastavit AI klíče pro edge functions
#
# ═══════════════════════════════════════════════════════════════════════════════

# ── Domény (POVINNÉ pro produkci) ────────────────────────────────────────────
APP_DOMAIN=web.aisha.guru
API_DOMAIN=api.aisha.guru
STUDIO_DOMAIN=db.aisha.guru

# ── Veřejný web: brand multidoména + import dat/grafiky instance ──────────────
# Veřejné webové hostnames se ODVOZUJÍ z PUBLIC_TLD (nic se nehardcoduje); brand
# subdomény deklaruješ ZDE jako CSV. coolify-deploy-init z nich vyrobí edge
# route + cert (https://<alias>.${PUBLIC_TLD}) a runtime je páruje na
# branding_hostname_mapping. Prázdné → jen kanonický web (web.${PUBLIC_TLD}).
# Pozn.: bez 'corp' v tomto seznamu corp.${PUBLIC_TLD} dostane 404 na edge.
AISHA_WEB_PUBLIC_ALIASES=web,corp
# Apex (holé PUBLIC_TLD) chování:  redirect (308 → APP_DOMAIN)  |  serve
AISHA_WEB_APEX_MODE=redirect
# Folder pod domains/templates/<AISHA_SEED_DOMAIN>/ pro svc-web-artifact
# /seed-default (konvence: = PUBLIC_TLD). Prázdné → neutrální domains/default/.
AISHA_SEED_DOMAIN=
# Privátní repo s DATY instance (operators.json + NN_*.sql vč. 01_web.sql) —
# migrate hook (scripts/deploy/instance-data-hook.sh) ho klonuje (pin #main) a
# aplikuje. Prázdné → community install, hook no-opne. Token NIKDY do gitu.
# Forma: https://oauth2:${FORGEJO_API_TOKEN}@<host>/<org>/aisha-instance-data.git#main
AISHA_INSTANCE_DATA_GIT_URL=
# Privátní repo s GRAFIKOU webu (design folder) — volitelný build-time overlay
# cesty A (svc-web-artifact Dockerfile). Hlavní doručení grafiky je přes
# 01_web.sql (cesta B). Prázdné → žádný overlay.
AISHA_WEB_DESIGN_GIT_URL=

# ── Legacy Supabase naming (current: AISHA_POSTGREST_* / Gateway) ────────────
# Přegeneruj:  node scripts/generate-deploy-keys.mjs
#
# JWT_SECRET=<generate — run: node scripts/generate-deploy-keys.mjs>
# POSTGRES_PASSWORD=<generate — run: node scripts/generate-deploy-keys.mjs>
# ANON_KEY=eyJhbGciOiJIUzI1NiIs...
# SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
# LOGFLARE_API_KEY=<generate — run: node scripts/generate-deploy-keys.mjs>
# REALTIME_SECRET_KEY_BASE=<generate — run: node scripts/generate-deploy-keys.mjs>

# ── JWT ──────────────────────────────────────────────────────────────────────
# JWT_EXP=3600

# ── Auth (Keycloak OIDC) ─────────────────────────────────────────────────────
# DISABLE_SIGNUP=false
# ENABLE_EMAIL_SIGNUP=true
# ENABLE_EMAIL_AUTOCONFIRM=false
# ENABLE_ANONYMOUS_SIGN_INS=false
# ENABLE_PHONE_SIGNUP=false
# RATE_LIMIT_EMAIL_SENT=100
# ADDITIONAL_REDIRECT_URLS=

# ── KeyCloak OIDC (Identity Provider) ───────────────────────────────────────
# KeyCloak je ZAPNUTÝ ve výchozím stavu. Pro vypnutí: ENABLE_KEYCLOAK=false
# Admin konsole: https://<KEYCLOAK_DOMAIN>/admin  (realm: aisha)
# Client secret se generuje v KC Admin → Clients → aisha-app → Credentials
KEYCLOAK_DOMAIN=kc.aisha.guru
# ENABLE_KEYCLOAK=true
# KEYCLOAK_CLIENT_ID=aisha-app
# KEYCLOAK_CLIENT_SECRET=<generate-in-keycloak-admin-console>
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=<generate: openssl rand -hex 16>
# KEYCLOAK_DB_PASSWORD=<generate: openssl rand -hex 32>

# ── Google OAuth (optional) ─────────────────────────────────────────────────
# https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# Redirect URI: https://<API_DOMAIN>/auth/v1/callback
# ENABLE_GOOGLE_OAUTH=true
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ── Apple OAuth (optional) ──────────────────────────────────────────────────
# https://developer.apple.com → Certificates, Identifiers → Services IDs
# Redirect URI: https://<API_DOMAIN>/auth/v1/callback
# ENABLE_APPLE_OAUTH=true
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=

# ── SMTP (email delivery) ───────────────────────────────────────────────────
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxx
# SMTP_ADMIN_EMAIL=admin@aisha.guru
# SMTP_SENDER_NAME=AISHA Platform

# ── Email Templates ─────────────────────────────────────────────────────────
# MAILER_TEMPLATES_INVITE=
# MAILER_TEMPLATES_CONFIRMATION=
# MAILER_TEMPLATES_RECOVERY=
# MAILER_TEMPLATES_MAGIC_LINK=
# MAILER_TEMPLATES_EMAIL_CHANGE=
# MAILER_SUBJECTS_CONFIRMATION=Confirm your email
# MAILER_SUBJECTS_RECOVERY=Reset your password
# MAILER_SUBJECTS_MAGIC_LINK=Your login link
# MAILER_SUBJECTS_EMAIL_CHANGE=Confirm email change
# MAILER_SUBJECTS_INVITE=You have been invited

# ── Auth Hook (send_email via PG function → edge function) ──────────────────

# ── PostgREST ────────────────────────────────────────────────────────────────
# PGRST_DB_SCHEMAS=public,storage,graphql_public
# PGRST_DB_MAX_ROWS=1000

# ── Storage ──────────────────────────────────────────────────────────────────
# STORAGE_FILE_SIZE_LIMIT=52428800
# STORAGE_REGION=local

# ── imgproxy ─────────────────────────────────────────────────────────────────
# IMGPROXY_ENABLE_WEBP_DETECTION=true

# ── Studio (Admin Dashboard) ────────────────────────────────────────────────
# Studio is protected by OAuth2 Proxy + Keycloak OIDC (studio-auth service).
# Access requires 'studio_access' realm role (synced from app permissions).
# STUDIO_DEFAULT_ORG=AISHA
# STUDIO_DEFAULT_PROJECT=AI Orchestrator
STUDIO_OIDC_SECRET=<generate-in-keycloak-or-via-provision-sso.sh>
STUDIO_COOKIE_SECRET=<generate: python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())">

# ── AI / LLM Keys (Edge Functions) ──────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# GOOGLE_AI_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-...

# ── n8n Integration (Dirigent Governor) ──────────────────────────────────────
# n8n is protected by OAuth2 Proxy + Keycloak OIDC (n8n-auth service).
# Access requires 'n8n_access' realm role (synced from app permissions).
# Deployed via docker-compose.coolify-n8n.yml (separate Coolify stack).
N8N_DOMAIN=n8n.backend.id3a.cz
# Public edge-proxy webhook facade: https://mcp.aisha.guru
# N8N_WEBHOOK_URL=https://mcp.aisha.guru
# N8N_API_KEY=
N8N_OIDC_SECRET=<generate-in-keycloak-or-via-provision-sso.sh>
N8N_COOKIE_SECRET=<generate: python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())">

# ── MCP ──────────────────────────────────────────────────────────────────────
# MCP JSON-RPC uses Keycloak/OAuth bearer tokens; no static MCP token is configured.

# ── GitHub Webhook Bridge ────────────────────────────────────────────────────
# GITHUB_WEBHOOK_SECRET=

# ── Edge Functions Runtime ───────────────────────────────────────────────────
# EDGE_VERIFY_JWT=false
# ALLOWED_ORIGINS=
# EDGE_RUNTIME_MODE=production

# ── Push Notifications ──────────────────────────────────────────────────────
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FCM_PROJECT_ID=aisha-dirigent
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:ops@aisha.guru

# ── Stripe ───────────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Sentry (optional) ───────────────────────────────────────────────────────
# VITE_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_URL=
# SENTRY_ORG=sentry
# SENTRY_PROJECT=platform-web

# ── Realtime ─────────────────────────────────────────────────────────────────
# REALTIME_DB_ENC_KEY=supabaserealtime

# ── Logflare ────────────────────────────────────────────────────────────────
# LOGFLARE_RELEASE_COOKIE=cookie

# ═══════════════════════════════════════════════════════════════════════════════
# SHARED INFRASTRUCTURE — ClickHouse, Redis, MinIO
# ═══════════════════════════════════════════════════════════════════════════════

# ── ClickHouse (Analytical DB — Langfuse v3 + future backend analytics) ─────
# CLICKHOUSE_USER=clickhouse
# CLICKHOUSE_PASSWORD=<generate: openssl rand -hex 32>

# ── Redis (Cache, Queue — Langfuse worker + future shared cache) ────────────
# REDIS_PASSWORD=<generate: openssl rand -hex 32>

# ── MinIO / S3 (Object storage — Langfuse blobs + shared) ──────────────────
# MINIO_ROOT_USER=aisha-minio-admin
# MINIO_ROOT_PASSWORD=<generate: openssl rand -hex 32>

# ── Langfuse v3 ─────────────────────────────────────────────────────────────
# LANGFUSE_NEXTAUTH_SECRET=<generate: openssl rand -hex 48>
# LANGFUSE_SALT=<generate: openssl rand -hex 32>
# LANGFUSE_ADMIN_EMAIL=admin@aisha.guru
# LANGFUSE_ADMIN_PASSWORD=<generate: openssl rand -hex 12>
# LANGFUSE_PUBLIC_KEY=pk-lf-aisha-prod
# LANGFUSE_SECRET_KEY=sk-lf-aisha-prod
# LANGFUSE_DOMAIN=langfuse.aisha.guru

# ── Brand SEO / OG (build-time substitution into index.html) ────────────────
# Every VITE_PUBLIC_BRAND_* below is replaced into index.html at `vite build`
# time by the brandPlaceholderPlugin in vite.config.ts. Defaults (kept in
# the plugin) preserve the upstream AISHA / Evymo identity; tenant forks
# override here to bake their own SEO + social-card preview into the
# shipped HTML. Crawlers + share-card previewers (Open Graph, Twitter
# Card, Slack unfurl, Telegram preview) all see the override on first hit
# without needing a JavaScript engine.
#
# Per-hostname SEO (two brand hostnames on the same
# single build) is NOT solved by these placeholders — both hostnames share
# the same shipped index.html and inherit the umbrella brand identity at
# the static layer. Per-host SEO requires SSR or an edge worker rewriting
# HTML by Host header; tracked separately. The runtime useDocumentTitle
# hook + BrandContext keep the <title> in sync per route for JS visitors.
#
# Leave commented to inherit upstream defaults; uncomment and override
# the keys you want to rebrand. The set is intentionally tight — keys
# below cover everything crawler-visible in index.html, no more.
#
# VITE_PUBLIC_BRAND_LANG=en                       # <html lang="...">
# VITE_PUBLIC_BRAND_TITLE="<Brand> — <one-line tagline>"
# VITE_PUBLIC_BRAND_DESCRIPTION="<≤160-char meta description>"
# VITE_PUBLIC_BRAND_AUTHOR="<Legal entity name>"
# VITE_PUBLIC_BRAND_THEME_COLOR=#0f1b2d           # <meta name="theme-color">
# VITE_PUBLIC_BRAND_OG_LOCALE=en_US               # og:locale
# VITE_PUBLIC_BRAND_OG_SITE_NAME="<Brand>"
# VITE_PUBLIC_BRAND_OG_DESCRIPTION="<≤200-char OG description>"
# VITE_PUBLIC_BRAND_OG_IMAGE=https://<your-cdn>/og-cover.png
