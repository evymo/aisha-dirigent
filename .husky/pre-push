#!/bin/sh
# =============================================================================
# Pre-push hook — CÍLENÉ kontroly změny; plné sady běží v CI
# =============================================================================
# ⭐ ROZHODNUTÍ MAJITELE 2026-10-05: „plné sady jen v CI". Celá sada bran (obě
# dráhy), unit, services, build i integrační dávky se měří na runneru a slučuje se
# jen podle závěrů jobů v CI (`npm run ci:verdikt`). Místně běží to, co je levné
# a celorepové, plus testy změněných částí. Důvod: stroj s 11+ relacemi se dusil
# (swap 9,5/11 GB, load 250+) a pre-push integrační dávky spadl na 37 timeoutech
# zátěže — a blokoval produkční opravu.
#
# Tiering — každá úroveň má svůj rozsah:
#   pre-commit = rychlá zpětná vazba per commit (tsc, lint, i18n segmenty, guardy)
#   pre-push   = preflight, tsc, lint, validate:static, i18n (vždy — celorepové a levné)
#                + CÍLENÁ dráha (scripts/ci/prepush-cilene.mjs): brány dotčené změnou ·
#                sady dotčených services/packages/plugins/extensions · unit a script testy,
#                které změněné moduly přímo importují
#   CI         = všechno celé (Web: Brány, Web: Tests, Services: Tests, Web: Build, …)
#
# CO SE MĚNÍ určuje TÝŽ směrovač jako CI (scripts/ci/zmenene-cesty.sh přes
# scripts/ci/prepush-vyber.sh). Báze = společný předek s <remote>/main, takže
# integrační dávka s merge commity se posuzuje rozdílem proti mainu, ne „vše".
# FAIL-CLOSED JINAK: neznámá cesta, rozpor směrování, pád výběru nebo chybějící
# báze → ŠIRŠÍ cílená dráha (celá lehká dráha bran + vybrané těžké + sady dotčených
# workspace), nikdy „nic". Co se místně nepustí, hook VYPÍŠE i s úlohou CI, která to
# změří — žádný tichý skip.
#
# Plnou sadu (jako před 2026-10-05) si vynutíš: AISHA_PREPUSH_VSE=1 git push …
# Skip: HUSKY=0 git push ...   (nebo git push --no-verify)
# =============================================================================

# Ensure Node.js from .nvmrc (shell default may be a stale system version)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
nvm use >/dev/null 2>&1 || true

# Cache zelených stromů (scripts/lib/ci-zelene.mjs): tentýž strom s TÝMIŽ vstupy (node,
# nainstalované závislosti, sestavené packages/*/dist, .env* soubory, proměnné sady,
# schopnosti prostředí) už PLNOU sadou prošel → opakované měření nad stejným vstupem
# nic nového nezjistí (naměřeno 2026-09-25: push téhož commitu do forku i upstreamu
# = 2× ~40 min v těžkém slotu). Jen při úplné shodě klíče a do 24 h. Zapisuje se JEN
# plná sada (REZIM=vse, tedy AISHA_PREPUSH_VSE=1) — cílený běh strom za zelený
# neprohlásí; HIT plné sady přeskočí i cílený běh (plná ⊇ cílená).
# Vynutit běh: AISHA_CI_ZNOVU=1 git push. Serverová CI se nemění.
# ⛔ VYNUCENÁ PLNÁ SADA JE PLNÁ. Přeskoky z prostředí volajícího (shell uživatele, vnější
#    cílený hák, který už exportoval přeskoky stack-smoke) by ji tiše zúžily — a zápis
#    `--rezim vse` by pak do cache dal strom, který celou sadou neprošel. Vynuluje se
#    PŘED klíčem cache, aby klíč popisoval běh, který opravdu proběhne.
vynuluj_vnejsi_preskoky() {
  unset AISHA_SMOKE_SKIP_GATES AISHA_SMOKE_SKIP_UNIT AISHA_SMOKE_SKIP_SERVICES AISHA_SMOKE_SKIP_PREFLIGHT AISHA_SMOKE_SKIP_OFFLINE
}
[ "${AISHA_PREPUSH_VSE:-}" = "1" ] && vynuluj_vnejsi_preskoky

CI_BEH=$$
if node scripts/ci-zelene.mjs --over --beh "$CI_BEH"; then exit 0; fi

echo "Pre-push: kontroly změny (plné sady běží v CI)..."

# 0a. Instalace sedí na lockfile? — za zlomek sekundy, PŘED kontrolami.
#    Symlinkované / zastaralé node_modules jinak padnou na `Cannot find module`
#    v balíku, na který změna nesahá (naměřeno 2026-09-24), a čtou se jako vada
#    kódu. Nelze-li instalaci ověřit, je to taky STOP.
echo "  > Instalace node_modules vs package-lock.json..."
node scripts/lib/instalace-sedi.mjs || exit 1

# ── 0b. Co se mění (fail-closed: nejistota = ŠIRŠÍ dráha, ne nic) ──────────────
# stdin hooku = řádky "<local ref> <local sha> <remote ref> <remote sha>"; $1 = remote.
REZIM=sirsi
DUVOD="výběr se nespustil"
ZMENENO=0
PLAN=$(bash scripts/ci/prepush-vyber.sh "${1:-origin}" 2>/dev/null) || PLAN="rezim=sirsi
duvod=prepush-vyber.sh skončil chybou"
# key=value → proměnné; bereme jen známé klíče (žádný eval nad cizím textem). `set -f`:
# změněná cesta s `*` nebo `[` se nesmí rozvinout na jména souborů.
set -f
OLDIFS=$IFS; IFS='
'
for radek in $PLAN; do
  klic=${radek%%=*}; hodnota=${radek#*=}
  case "$klic" in
    rezim) REZIM=$hodnota ;;
    duvod) DUVOD=$hodnota ;;
    zmeneno) ZMENENO=$hodnota ;;
  esac
done
IFS=$OLDIFS
set +f
# Režim, který hook nezná, je taky nejistota: ŠIRŠÍ dráha a nahlas proč. Do plánu se
# připíše, aby cílená dráha (která plán čte znovu) rozhodla stejně jako hook.
case "$REZIM" in
  vse|vyber|sirsi) ;;
  *) DUVOD="neznámý režim '$REZIM' → širší cílená dráha"; REZIM=sirsi
     PLAN="$PLAN
rezim=sirsi
duvod=$DUVOD" ;;
esac

if [ "$REZIM" = "vse" ]; then
  vynuluj_vnejsi_preskoky
  echo "  > PLNÁ sada — $DUVOD"
  echo "    (preflight, tsc, lint, obě dráhy bran, validate:static, i18n, unit, services, extension, n8n, pluginy, build)"
else
  echo "  > Místně: preflight, tsc, lint, validate:static, i18n + cílená dráha ($ZMENENO změněných cest)"
  # Celé sady jdou do CI; stack-smoke jejich přeskok vypíše a cílená dráha níž pustí dotčené.
  export AISHA_SMOKE_SKIP_GATES=1 AISHA_SMOKE_SKIP_UNIT=1 AISHA_SMOKE_SKIP_SERVICES=1
fi

# 1. Stack-smoke: preflight (submodul, source-truth-report.json) + offline fáze
#    (tsc --noEmit · lint · validate:static · i18n:check; v plné sadě i test:gates,
#    test:run a test:services). Build stack-smoke přeskakuje (AISHA_SMOKE_SKIP_BUILD=1),
#    v plné sadě ho pouští krok 3.
echo "  > Stack-smoke (preflight + offline)..."
# ⛔ „NEZMĚŘENO" SE NESMÍ ZTRATIT NA ROUŘE. `||` slévá každý nenulový kód do
#    jednoho, takže běh, který NIC nenaměřil (zamrzlý worker, nefunkční měřidlo),
#    dostal touž hlášku jako padlá brána: „oprav pred pushem". Člověk pak hledá
#    vadu, která nemusí existovat. Push se nepouští ani tak — neověřeno není
#    ověřeno — ale diagnóza musí sedět. Kód 75 = NEZMĚŘENO (scripts/test/verdikt-kody.mjs).
npm run test:stack:ci
STACK_RC=$?
if [ "$STACK_RC" = "75" ]; then
  echo "NEZMĚŘENO Stack-smoke nic nenaměřila ani při opakování — to NENÍ nález."
  echo "  Žádná brána nespadla; jen se nikdo nedozvěděl, jak dopadly. Zopakuj běh."
  echo "  Na zatíženém stroji se stejnou souběžností jako CI:"
  echo "      VITEST_MAX_WORKERS=2 npm run test:stack:ci"
  exit 75
fi
if [ "$STACK_RC" != "0" ]; then
  echo "FAIL Stack-smoke selhala — oprav pred pushem"
  exit 1
fi

if [ "$REZIM" = "vse" ]; then
  # 2. PLNÁ sada: JS workspace sub-balíčky mimo test:stack:ci (CI je pouští jako
  #    vlastní joby test-extension / n8n-nodes), pluginy mimo npm workspace (doloženo
  #    2026-07-26: eurowag-telematics měl sadu, která nikdy neproběhla) a build.
  echo "  > Extension (offline parity s CI)..."
  npm --prefix extensions/aisha-dirigent test || {
    echo "FAIL Extension testy selhaly — oprav pred pushem"
    exit 1
  }
  echo "  > n8n-nodes (offline parity s CI)..."
  npm --prefix packages/n8n-nodes-aisha test || {
    echo "FAIL n8n-nodes testy selhaly — oprav pred pushem"
    exit 1
  }
  echo "  > Pluginy (offline sady mimo workspace)..."
  npm run test:plugins || {
    echo "FAIL Plugin testy selhaly — oprav pred pushem"
    exit 1
  }
  # 3. Build — jediné, co test:stack:ci přeskakuje (AISHA_SMOKE_SKIP_BUILD=1).
  echo "  > Build..."
  npm run build || {
    echo "FAIL Build selhal — oprav pred pushem"
    exit 1
  }
else
  # 2. CÍLENÁ dráha: dotčené brány (nebo celá lehká dráha + vybrané těžké, když je
  #    výběr nejistý), sady dotčených workspace, testy importující změněné moduly.
  #    Sama vypíše, co přeskočila a která úloha CI to změří.
  printf '%s\n' "$PLAN" | node scripts/ci/prepush-cilene.mjs
  CILENE_RC=$?
  if [ "$CILENE_RC" = "75" ]; then
    echo "NEZMĚŘENO Cílená dráha nic nenaměřila — to NENÍ nález. Zopakuj běh."
    exit 75
  fi
  if [ "$CILENE_RC" != "0" ]; then
    echo "FAIL Cílené testy selhaly — oprav pred pushem"
    exit 1
  fi
fi

# Zapisuje JEN plná sada (REZIM=vse) — cílený běh by strom falešně prohlásil za zelený.
node scripts/ci-zelene.mjs --zapis --beh "$CI_BEH" --rezim "$REZIM" || true
if [ "$REZIM" = "vse" ]; then
  echo "OK Pre-push: plná sada OK — push povolen"
else
  echo "OK Pre-push: cílené kontroly OK — push povolen; plnou sadu změří CI (slučuj podle: npm run ci:verdikt)"
fi
