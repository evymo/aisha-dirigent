+    private function transfer_images_to_deployment_server()
+    {
+        $filter = "docker images --filter reference='{$this->application->uuid}_*:{$this->commit}' --format '{{.Repository}}:{{.Tag}}'";
+
+        // ⛔ OČEKÁVANÁ MNOŽINA SE DEKLARUJE, NEPOZORUJE.
+        //
+        // Dřív se ptalo jedním dotazem build serveru „co tu je" a to se přeneslo.
+        // Jenže obrazy se do úložiště objevují POSTUPNĚ, jak dobíhají cíle
+        // buildu — řádek `Image X Built` v logu neznamená, že už je X v
+        // `docker images`. Když dotaz padne doprostřed, přenese se PODMNOŽINA.
+        //
+        // ⛔ A kontrola pod přenosem to nechytila, protože porovnávala naložené
+        // proti TÉ UŽ ZKRÁCENÉ množině: `$images->diff($loaded)`. Prázdnou
+        // množinu hlídala, neúplnou ne.
+        //
+        // ⭐ NAMĚŘENO 2026-09-05 na `<fork>-exec`, týž commit, dva běhy:
+        //
+        //     běh 1:  3 postavené →  Transferring 1   ⇒ na cíli chyběly DVA
+        //     běh 2:  3 postavené →  Transferring 3   ⇒ prošlo
+        //
+        // Cíl pak obraz zkusil stáhnout (`pull access denied` — na Hubu není)
+        // a pak postavit, jenže tam repo není:
+        //     resolve : lstat /data/coolify/applications/<uuid>/images: no such file
+        // Spadl tím CELÝ stack, ne jedna služba.
+        //
+        // Očekávaná množina se proto bere z compose a na build server se ČEKÁ,
+        // dokud ji nemá celou. Nedočká-li se, je to CHYBA — ne tichý přenos
+        // podmnožiny, který se projeví až na cíli jako úplně jiná porucha.
+        $expected = $this->images_declared_by_compose();
+
+        if ($expected->isEmpty()) {
+            // Compose bez jediné stavěné služby: není co přenášet a je to
+            // DEKLAROVANÉ, ne dohadované.
+            return;
+        }
+
+        // ⛔ ČEKÁ SE NA POSTUP, NE NA HODINKY.
+        //
+        // První podoba měla pevných 300 s. Naměřeno 2026-09-06 na desetiobrazovém
+        // stacku pod zátěží (Soren: load 23, disk 87 %): BuildKit ohlásil všech
+        // 10× `Built` v 00:31:58, ale do úložiště se obrazy objevovaly ještě
+        // o DEVĚT MINUT později. Pevný strop tedy neměřil vadu, ale velikost
+        // stacku a vytížení builderu — a nasazení padalo na zdravém buildu.
+        //
+        // Správná vlastnost není „jak dlouho to trvá", ale „děje se ještě něco".
+        // Hodiny nečinnosti se resetují při KAŽDÉM novém obrazu, takže velký
+        // stack smí trvat, jak potřebuje, kdežto zaseknutý builder padne rychle.
+        // Absolutní strop je jen pojistka proti věčnému čekání.
+        $tichoLimit = 600;   // bez jediného nového obrazu
+        $absolutni  = 3600;  // celkový strop
+        $start      = time();
+        $poslediZmena = time();
+        $melDrive   = -1;
+
+        $onBuildServer = collect();
+        $missingOnBuildServer = $expected;
+
+        while (true) {
+            $onBuildServer = str(instant_remote_process([$filter], $this->build_server, false))
+                ->trim()->explode("\n")->filter();
+            $missingOnBuildServer = $expected->diff($onBuildServer);
+
+            if ($missingOnBuildServer->isEmpty()) {
+                break;
+            }
+
+            $ma = $expected->count() - $missingOnBuildServer->count();
+            if ($ma !== $melDrive) {
+                // Postup: hodiny nečinnosti se resetují.
+                $melDrive = $ma;
+                $poslediZmena = time();
+                $this->application_deployment_queue->addLogEntry(
+                    'Waiting for the build server to materialise images: '.$ma.' of '.$expected->count().
+                    ' ready, still missing '.$missingOnBuildServer->implode(', ')
