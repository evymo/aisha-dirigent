+            $missing = $images->diff($loaded);
+
+            if ($missing->isNotEmpty()) {
+                throw new \RuntimeException(
+                    'the destination is missing '.$missing->count().' of '.$images->count().' image(s) after loading the archive: '.$missing->implode(', ')
+                );
+            }
+
+            // Confirming that what was sent arrived is not the same as confirming the
+            // destination has what it needs. The compose file is the statement of
+            // need: every image it names with this application's prefix is built here
+            // and served by no registry, so its absence is fatal and knowable now.
+            // Without this the deployment carries on to `compose up`, which fails with
+            // "pull access denied" -- a message that blames a registry nobody uses and
+            // buries the real fault one layer down.
