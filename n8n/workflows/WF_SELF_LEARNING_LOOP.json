{
  "name": "WF_SELF_LEARNING_LOOP",
  "nodes": [
    {
      "parameters": {
        "authentication": "headerAuth",
        "path": "self-learning",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REMAP__",
          "name": "AISHA Webhook Auth"
        }
      },
      "id": "sl-trigger",
      "name": "Improvement Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Create improvement proposal via Supabase RPC\nconst input = $input.first().json.body;\n\nconst supabaseUrl = $env.AISHA_POSTGREST_URL || 'http://127.0.0.1:57421';\nconst supabaseKey = $env.AISHA_POSTGREST_SERVICE_KEY;\n\nconst rpcUrl = `${supabaseUrl}/rest/v1/rpc/fn_create_improvement_proposal`;\nconst rpcBody = JSON.stringify({\n  p_agent_slug: input.agent_slug,\n  p_title: input.title,\n  p_description: input.description,\n  p_category: input.category || 'general',\n  p_metadata: input.metadata || {}\n});\n\nlet result;\ntry {\n  if (typeof fetch === 'function') {\n    const response = await fetch(rpcUrl, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json', 'apikey': supabaseKey, 'Authorization': `Bearer ${supabaseKey}` },\n      body: rpcBody\n    });\n    result = await response.json();\n  } else {\n    const https = require('https');\n    const url = new URL(rpcUrl);\n    result = await new Promise((resolve, reject) => {\n      const req = https.request({\n        hostname: url.hostname,\n        port: url.port || 443,\n        path: url.pathname,\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'apikey': supabaseKey,\n          'Authorization': `Bearer ${supabaseKey}`,\n          'Content-Length': Buffer.byteLength(rpcBody)\n        }\n      }, res => {\n        let body = '';\n        res.on('data', c => body += c);\n        res.on('end', () => {\n          try { resolve(JSON.parse(body)); }\n          catch { reject(new Error('Invalid JSON: ' + body.substring(0, 200))); }\n        });\n      });\n      req.on('error', reject);\n      req.write(rpcBody);\n      req.end();\n    });\n  }\n} catch (e) {\n  return [{ json: { ...input, proposal: { error: e.message } } }];\n}\n\nreturn [{ json: { ...input, proposal: result } }];"
      },
      "id": "sl-evaluate",
      "name": "Evaluate Proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "auto-approve-check",
              "leftValue": "={{ $json.proposal.status }}",
              "rightValue": "auto_approved",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "sl-risk-router",
