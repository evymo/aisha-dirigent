+        $archive = "{$archiveDir}/{$this->deployment_uuid}.tar";
+        $localArchive = "/tmp/{$this->deployment_uuid}.tar";
+        $this->application_deployment_queue->addLogEntry('----------------------------------------');
+        // Name them, not just count them. When the filter above matches fewer images
+        // than the build produced, a bare count says nothing about which one is
+        // absent -- measured 2026-09-04: three deployments out of 129 transferred a
+        // subset and then failed on the destination, and nothing in the log recorded
+        // what had actually matched, so the record could not settle the cause
+        // afterwards. Three hypotheses were raised and all three disproved against
+        // it; the names are what the next occurrence needs.
+        $this->application_deployment_queue->addLogEntry("Transferring {$images->count()} built image(s) from {$this->build_server->name} to {$this->mainServer->name}: ".$images->implode(', '));
+        try {
+            instant_remote_process(["mkdir -p {$archiveDir}"], $this->build_server);
+            instant_remote_process(['docker save '.$images->implode(' ')." -o {$archive}"], $this->build_server);
+            instant_scp_from_server($archive, $localArchive, $this->build_server);
