# =============================================================================
# fork-instance-inputs.env.example — the MINIMAL operator input set
# =============================================================================
# GENERATED from scripts/lib/operator-inputs.mjs — DO NOT EDIT BY HAND.
# Regenerate: node scripts/operator-setup.mjs --print-env-example > config/fork-instance-inputs.env.example
#
# Non-secret topology/identity is declared in operator-inputs.mjs; the secret
# credentials below are PARSED from config/external-secrets.required.env (its
# @annotations), so providers are never hardcoded twice.
#
# Copy the values you need into .env.local (gitignored) or your environment,
# then run:  node scripts/operator-setup.mjs   (interactive setup + local verify).
# Every secret and every domain the stack needs to run ITSELF is generated/derived.
# =============================================================================

# ── Infra endpoints — where your Coolify / Forgejo live (the URLs; matching tokens are secrets, below)
# Coolify base URL [REQUIRED] — Your Coolify controller's API base URL — the deploy target (the API TOKEN is a secret, sourced separately).
COOLIFY_URL=https://coolify.example.com

# Forgejo base URL [REQUIRED] — Your Forgejo host — Coolify clones the stack + overlays from here (the TOKEN is a secret, sourced separately).
FORGEJO_URL=https://git.example.com

# ── Topology — the instance's public shape: its 3 TLDs, namespace, admin, and where it deploys
# Public TLD [REQUIRED] — The instance's public apex — every public *.<PUBLIC_TLD> domain derives from it.
PUBLIC_TLD=acme.example.com

# Internal TLD [REQUIRED] — Per-server internal apex (direct Coolify routing, bypasses the public edge).
INTERNAL_TLD=acme.internal.example.com

# Mesh TLD [REQUIRED] — WireGuard mesh apex — every <role>.<MESH_TLD> peer hostname derives from it.
MESH_TLD=mesh.acme.internal

# Instance namespace [REQUIRED] — Short slug that namespaces Coolify scope, mesh ports, and (by default) the overlay repos.
APP_NAME_PREFIX=acme

# Forgejo org for overlays [optional] — Org that holds <org>-instance-data / <org>-guru-web overlays.
#   default: unset → falls back to APP_NAME_PREFIX
AISHA_FORGEJO_ORG=acme

# Primary admin email [optional] — The first admin account — also the Keycloak platform admin identity. Derivable: an instance that declared its apex has already said everything needed to name its own admin, so this is only worth asking when the operator wants a mailbox that is NOT on the instance's own domain.
#   default: unset → admin@<PUBLIC_TLD>
AISHA_PRIMARY_ADMIN_EMAIL=admin@acme.example.com

# Coolify project name [REQUIRED] — Name of the Coolify project the stack's apps live under.
#   default: unset → falls back to APP_NAME_PREFIX
COOLIFY_PROJECT_NAME=acme

# Topology profile [REQUIRED] — Deployment shape (single-host vs multi-host role split) — drives derive-domains.
AISHA_PROFILE=cloud-single

# ── Instance identity — which content/users/overlay make this instance itself (the private overlay repo)
# Operator organization [optional] — Organization that runs this instance. Becomes O= in the internal CA and in every certificate it issues, and the default org shown in the studio.
#   default: unset → APP_NAME_PREFIX upper-cased (the instance namespace)
AISHA_OPERATOR_ORG=Acme Industries

# Operator legal name [optional] — Full legal entity for footers, copyright and e-mail identity. Kept separate from the organization because the legal form belongs in prose, not in a certificate DN.
#   default: unset → AISHA_OPERATOR_ORG
AISHA_OPERATOR_LEGAL_NAME=Acme Industries Ltd.

# Operator country (ISO 3166-1 alpha-2) [optional] — Becomes C= in the CA subject. Optional in X.509 — when unset the attribute is OMITTED rather than defaulted, because guessing a country for someone else's certificate authority is worse than leaving it out.
#   default: unset → C= is omitted from the subject entirely
AISHA_OPERATOR_COUNTRY=GB

# Internal CA name [optional] — Leading part of the internal root CA common name: '<name> Root CA - <realm>'. BOOTSTRAP-ONLY — the CN is part of the CA's identity and the published CRL filename is derived from it, so changing it later means issuing a new CA, not renaming one.
#   default: unset → AISHA_OPERATOR_ORG (which itself falls back to APP_NAME_PREFIX upper-cased)
AISHA_CA_NAME=Acme

# Private overlay repo URL [optional, secret] — The private aisha-instance-data overlay: KB + web content + Keycloak clients + operator roster.
#   default: unset → derived from AISHA_FORGEJO_ORG + FORGEJO_URL + FORGEJO_API_TOKEN (community install → no overlay)
AISHA_INSTANCE_DATA_GIT_URL=

# Operator roster (file) [optional, secret, file] — Top-level operators.json in the overlay: emails + app roles. Missing KC accounts are auto-created.
#   default: lives in the private overlay repo (fallback: config/operators.json). See docs/onboarding/instance-data-template
#   operators.json — see docs/onboarding/instance-data-template/operators.json

# Private tenant list (file) [optional, file] — Optional exact tenant names for belt-and-suspenders leak detection. Gitignored, never committed.
#   default: absent → gates fall back to structural detection. See config/tenant.json.example
#   config/tenant.json — see config/tenant.json.example

# Seed profile [optional] — Which data layers the migrate seeds (platform / demo / instance).
#   default: unset → 'instance' (platform + selected implementation + private overlay)
AISHA_SEED_PROFILE=instance

# ── LLM PROVIDERS (Insight stack — Maestro + Ragnarok)
# Openai API Key [REQUIRED, secret] — Primary LLM backend pro Maestro dialog + Ragnarok RAG
#   get it: https://platform.openai.com/api-keys
#   without it: Maestro story-consult selže, Ragnarok generation neaktivní
OPENAI_API_KEY=

# Anthropic API Key [optional, secret] — Anthropic Claude pro multi-provider routing (svc-ai-chat)
#   get it: https://console.anthropic.com/settings/keys
#   without it: Claude models nedostupné v ai-chat; OpenAI/Maestro pokračují
ANTHROPIC_API_KEY=

# Google Ai API Key [optional, secret] — Google AI (Gemini) pro multi-provider routing
#   get it: https://aistudio.google.com/apikey
#   without it: Gemini models nedostupné; ostatní providers funkční
GOOGLE_AI_API_KEY=

# Cohere API Key [optional, secret] — Cohere rerank backend (Maestro/Ragnarok retrieval boost)
#   get it: https://dashboard.cohere.com/api-keys
#   without it: Reranking off, vector-only retrieval (kvalitativně mírně horší)
COHERE_API_KEY=

# ── BLOCKCHAIN (Cosmos validator)
# Cosmos Signer Mnemonic [REQUIRED, secret] — 24-word BIP39 mnemonic pro Cosmos validator identity
#   get it: openssl rand -hex 32 | xxd -r -p | python3 -c "import bip39; ..." NEBO hardware wallet
#   without it: aisha-ledger app nestartuje, chain neaktivní
COSMOS_SIGNER_MNEMONIC=

# ── MESH NETWORKING (NetBird zero-trust VPN)
# Netbird API Token [REQUIRED, secret] — Personal Access Token pro netbird-bootstrap.sh setup-key generation
#   get it: https://netbird.<your-domain> → Settings → Users → API Tokens
#   without it: netbird-bootstrap.sh selže → setup keys neexistují → cross-server mesh broken
NETBIRD_API_TOKEN=

# ── EMAIL DELIVERY
# Resend API Key [optional, secret] — Resend.com mailer (transactional emails — confirmation, recovery)
#   get it: https://resend.com/api-keys
#   without it: Email signup flow používá SMTP fallback (pomalejší, méně reliable)
RESEND_API_KEY=

# ── 3RD-PARTY MESSAGING BRIDGES (Mautrix Matrix bridges)
# Telegram API Hash [optional, secret] — Telegram bot bridge — propojí AISHA Matrix room s Telegram chatem
#   get it: https://my.telegram.org/apps (API_ID + API_HASH) + @BotFather (BOT_TOKEN)
#   without it: Telegram bridge container nestartuje, Matrix funkce zůstávají
TELEGRAM_API_HASH=

# Telegram API ID [optional, secret] — Telegram API ID (external credential).
TELEGRAM_API_ID=

# Telegram Bot Token [optional, secret] — Telegram Bot Token (external credential).
TELEGRAM_BOT_TOKEN=

# ── ENTERPRISE SOURCE ONBOARDING (svc-source-broker — federation ingest)
# Source API URL [optional, secret] — Federated source app base URL — its users (OTP + mantra) → gateway /token-exchange → authenticated aisha session. Empty on non-federated forks (broker not provisioned).
#   get it: The external source application's public API URL (NOT host.docker.internal)
#   without it: svc-source-broker not provisioned — no external-source ingest
SOURCE_API_URL=

# Source Pg URL [optional, secret] — Read-replica Postgres URL for the source's read-only PG driver (index without exposing).
#   get it: The source DB read-replica connection string, sslmode=require (TLS enforced)
#   without it: PG-driver source reads unavailable (GraphQL/API driver may still work)
SOURCE_PG_URL=

# Source Auth Handshake Out [optional, secret] — Outbound handshake mantra — the phrase svc-source-broker SENDS to authenticate to the source (safe-communication handshake).
#   get it: Agreed out-of-band with the source operator; must match the source's expected inbound value
#   without it: Source auth handshake fails — broker cannot establish the federated session
SOURCE_AUTH_HANDSHAKE_OUT=

# Source Auth Handshake In [optional, secret] — Inbound handshake mantra — the reply phrase svc-source-broker EXPECTS back from the source.
#   get it: Agreed out-of-band; must match the source's outbound reply
#   without it: Source auth handshake fails — inbound replies rejected
SOURCE_AUTH_HANDSHAKE_IN=

# ── OBSERVABILITY (Sentry — error monitoring)
# Sentry Auth Token [optional, secret] — Sentry release tracking + error aggregation
#   get it: https://sentry.io → Settings → Auth Tokens (scope: project:releases)
#   without it: Sentry monitoring off, production errors nejdou do dashboardu
SENTRY_AUTH_TOKEN=

# Sentry URL [optional, secret] — Sentry URL (external credential).
SENTRY_URL=

# Sentry Org [optional, secret] — Sentry Org (external credential).
SENTRY_ORG=

# Sentry Project [optional, secret] — Sentry Project (external credential).
SENTRY_PROJECT=

# Vite Sentry DSN [optional, secret] — Sentry DSN injektovaný do frontend buildu (VITE_*)
#   get it: Sentry → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# ── WEB PUSH (browser notifications)
# Vite Web Push Vapid Public Key [optional, secret] — VAPID public key pro Web Push API (PWA notifications)
#   get it: npx web-push generate-vapid-keys (private key v .env-prod-backup separátně)
#   without it: Push notifications off, in-app notifications fungují
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=

# ── REGISTRY PROXY (your registry-proxy host auth — opt-in private registry)
# Registry Proxy Username [optional, secret] — Pull-through cache credentials pro your registry-proxy host registry
#   get it: AISHA infra admin (interní registr image cache)
#   without it: Image pulls jdou přímo na docker.io/ghcr.io (rate limits možné)
REGISTRY_PROXY_USERNAME=

# Registry Proxy Password [optional, secret] — Registry Proxy Password (external credential).
REGISTRY_PROXY_PASSWORD=

# ── COOLIFY + FORGEJO INFRA TOKENS (cold-start orchestration)
# Coolify API Key [REQUIRED, secret] — Coolify API token — vytváří/synchronizuje aplikace přes API
#   get it: https://<your-coolify-host> → Profile → API Tokens
#   without it: cold-start.sh nemůže vůbec běžet (Phase 0 doctor selže)
COOLIFY_API_KEY=

# Forgejo Token [REQUIRED, secret] — Forgejo API token — sets COOLIFY_WEBHOOK_URL secret v repo
#   get it: https://<your-forgejo-host> → Settings → Applications → Generate Token
#   without it: Coolify auto-deploy on push nebude fungovat; manual redeploy přes UI
FORGEJO_TOKEN=
