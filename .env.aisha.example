# =
# .env.aisha — Konfigurace pro Aisha Dirigent orchestraci
# =
# Tento soubor kopíruj do .env a doplň reálné hodnoty.
# NIKDY necommituj s reálnými klíči!
#
# Quick start:
#   cp .env.aisha .env
#   # Doplň hodnoty podle pokynů níže
#   npm run aisha:setup:check   # Diagnostika
#   npm run aisha:setup         # Plné nastavení
# =

# ── AISHA Gateway / PostgREST (Self-hosted) ─ legacy "SUPABASE" section name kept for migration compatibility ─────────────────────────────────────
# Kde získat: db.aisha.guru → Settings → API
VITE_AISHA_POSTGREST_URL=
VITE_AISHA_POSTGREST_PUBLISHABLE_KEY=
VITE_AISHA_POSTGREST_ANON_KEY=

# Service role key (admin přístup)
# Kde získat: Coolify dashboard → Variables → AISHA_POSTGREST_SERVICE_KEY
# POZOR: Nikomu nesdílet, má plný přístup k DB!
AISHA_POSTGREST_SERVICE_KEY=

# ── n8n Workflow Engine ───────────────────────────────────────────────────
# Produkční n8n instance
N8N_WEBHOOK_URL=

# n8n API klíč pro programatický přístup
# Kde získat: n8n.aisha.guru → Settings → API → Create API Key
# Oprávnění: potřebuješ alespoň Read + Execute
N8N_API_KEY=

# ── LLM Providers ────────────────────────────────────────────────────────
# Primární: OpenAI (GPT-4o, GPT-5-mini)
# Kde získat: platform.openai.com → API Keys
OPENAI_API_KEY=

# Sekundární: Google Gemini
# Kde získat: aistudio.google.com → API Keys
GOOGLE_AI_API_KEY=

# Terciární: Anthropic Claude
# Kde získat: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── AISHA OAuth Access Token (CLI/bootstrap only) ─────────────────────────
# MCP a n8n user-facing calls používají Keycloak/OAuth bearer.
# VS Code extension token spravuje sama přes AISHA ID; CLI smoke/provisioning
# může dočasně použít krátkodobý Keycloak access token v této proměnné.
AISHA_ACCESS_TOKEN=

# ── Verdaccio (Private NPM Registry) ─────────────────────────────────────
# Token pro autentizaci s Verdaccio na npm.id3a.cz
# Kde získat: npm adduser --registry https://npm.id3a.cz/
#   pak zkopíruj token z ~/.npmrc (řádek //npm.id3a.cz/:_authToken=...)
# Použití:
#   1. .npmrc v root projektu — install @evymo/* balíčků
#   2. deploy-to-n8n.mjs --publish — publish na Verdaccio
VERDACCIO_TOKEN=

# ── GitHub Integration (Autonomous — Aisha decides when to use) ──────────
# Webhook secret pro GitHub → n8n bridge
# Kde získat: Vygeneruj náhodný string:
#   openssl rand -hex 32
# Nastav stejný v GitHub repo → Settings → Webhooks → Secret
GITHUB_WEBHOOK_SECRET=

# ── MCP Knowledge Server ────────────────────────────────────────────────
# Používáno v .mcp.json a .vscode/mcp.json pro MCP Knowledge Server.
# Autentizace probíhá přes Keycloak/OAuth, ne přes statický MCP token.
AISHA_MCP_URL=https://api.backend.id3a.cz/functions/v1/mcp-knowledge-server

# ── Dirigent Bootstrap ───────────────────────────────────────────────────
# Preferované hodnoty pro `npm run dirigent:bootstrap`:
#   AISHA_POSTGREST_URL=
#   AISHA_POSTGREST_ANON_KEY=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────
# Kde získat: npx web-push generate-vapid-keys
FCM_PROJECT_ID=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=

# ── Delivery / Payments (optional for Aisha) ─────────────────────────────
PACKETA_API_KEY=
PACKETA_API_PASSWORD=
PACKETA_SENDER_ID=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
DEEPL_API_KEY=

# ── NocoDB (Admin Bridge) ────────────────────────────────────────────────
# Kde získat: NocoDB instance → API Tokens
NOCODB_URL=http://localhost:8080
NOCODB_API_TOKEN=

# ── Appsmith (Admin Bridge) ──────────────────────────────────────────────
# Kde získat: Appsmith instance → Profile → API Key
APPSMITH_URL=http://localhost:8081
APPSMITH_API_KEY=

# ── Langfuse (Observability) ─────────────────────────────────────────────
# Kde získat: Langfuse instance → Settings → API Keys
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Forgejo (Git) ────────────────────────────────────────────────────────
# Kde získat: Forgejo instance → Settings → Applications → Generate Token
FORGEJO_URL=http://localhost:3200
FORGEJO_TOKEN=
