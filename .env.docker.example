# =============================================================================
# .env.docker — Docker/Coolify deployment environment variables
# =============================================================================
# Copy to .env.docker and fill in values for production deploy.
# Coolify: set these in the UI as environment variables.
# =============================================================================

# ── Gate switches ──────────────────────────────────────────────────────────
# Enable/disable pipeline steps (default: false = skip step entirely)
RUN_DB_MIGRATIONS=false

# ── Public routing source-of-truth ─────────────────────────────────────────
PUBLIC_TLD=${PUBLIC_TLD:-}
APP_DOMAIN=${APP_DOMAIN:-web.${PUBLIC_TLD}}
API_DOMAIN=${API_DOMAIN:-api.${PUBLIC_TLD}}
STUDIO_DOMAIN=${STUDIO_DOMAIN:-db.${PUBLIC_TLD}}
MCP_DOMAIN=${MCP_DOMAIN:-mcp.${PUBLIC_TLD}}

# ── Database Connection (self-hosted PostgreSQL) ───────────────────────────
# PostgreSQL connection string (for migrations + runtime)
# Canonical name; legacy AISHA_DB_URL is rejected by migrations-idempotent.gate.test.ts
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-}
AISHA_DB_URL=postgresql://postgres:${POSTGRES_PASSWORD}@${STUDIO_DOMAIN}:5432/postgres
# Optional fallback:
# DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@${STUDIO_DOMAIN}:5432/postgres

# Allow insecure SSL failover (Supabase CLI flag — used by `supabase` binary only)
# SUPABASE_DB_ALLOW_INSECURE_SSL_FAILOVER=true

# ── Vite Build-time (baked into JS bundle) ─────────────────────────────────
VITE_AISHA_POSTGREST_URL=https://${API_DOMAIN}
VITE_AISHA_POSTGREST_ANON_KEY=${ANON_KEY:-}
VITE_PUBLIC_SITE_URL=https://${APP_DOMAIN}
PUBLIC_SITE_URL=https://${APP_DOMAIN}

# ── Edge Functions Deploy — Self-Hosted Remote (SSH) ───────────────────────
# Set SELF_HOSTED_REMOTE_HOST to enable SSH-based deploy to your server:
SELF_HOSTED_REMOTE_HOST=
SELF_HOSTED_REMOTE_USER=root
SELF_HOSTED_REMOTE_PORT=22
SELF_HOSTED_REMOTE_FUNCTIONS_DIR=/root/supabase-project/volumes/functions
SELF_HOSTED_REMOTE_EDGE_CONTAINER=supabase-edge-functions
# Base64-encoded SSH private key (no passphrase):
#   cat ~/.ssh/id_ed25519 | base64 -w0
SELF_HOSTED_SSH_PRIVATE_KEY_B64=
# Optional: known_hosts content for strict host key checking
# SELF_HOSTED_SSH_KNOWN_HOSTS=
# SELF_HOSTED_SSH_DEBUG=false


# ── n8n Workflow Engine (Dirigent Governor) ────────────────────────────────
# Production n8n instance (Aisha)
N8N_WEBHOOK_URL=https://${MCP_DOMAIN}
# n8n API key (Settings → API → Create API Key)
N8N_API_KEY=
# Keycloak/OAuth bearer token for MCP workflow diagnostics/imports.
# Production autonomous workflows should prefer a scoped Keycloak service account.
AISHA_ACCESS_TOKEN=
# GitHub webhook secret (shared with GitHub App)
GITHUB_WEBHOOK_SECRET=

# ── Sentry (optional) ─────────────────────────────────────────────────────
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_URL=
SENTRY_ORG=sentry
SENTRY_PROJECT=platform-web
GIT_SHA=
