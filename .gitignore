# ── Instanční soukromá vrstva (fail-CLOSED) ──────────────────────────────────
# instances/<id>/private/ — VEŠKERÝ obsah je gitignorovaný (tajemství, provozní
# poznámky, cokoli instančně specifického, co NIKDY nesmí nahoru). Sledují se
# jen .gitkeep a README.md, aby struktura existovala v čerstvém klonu.
#
# Konvenci zavedl fork pod SVÝM jménem (`<jmeno>/private/`). Cesta se tady
# ODVOZUJE z instances/, protože upstream je šablona a nesmí znát nájemníka —
# a hlavně: pravidlo pojmenované po jednom forku ostatní instance NECHRÁNÍ.
# Pořadí je nosné: první řádek vyloučí obsah, `!…/*/` vrátí podadresáře do hry,
# aby šla vyjmout jejich .gitkeep — negace neumí vrátit soubor z vyloučeného
# adresáře.
instances/*/private/*
!instances/*/private/.gitkeep
!instances/*/private/README.md
!instances/*/private/*/
instances/*/private/*/*
!instances/*/private/*/.gitkeep

# === z konvergence forků ===
.playwright-mcp/
services/svc-web-artifact/node_modules/
aisha/db/seed/instance/*.sql

# dynamic port allocation (scripts/local/ports.mjs) — machine-local, never commit
scripts/local/.env.ports
scripts/local/.stack-ports.json

# public/assets — content-hashed font/image deploy copies; source of truth lives
# in the instance's own web/design repo (assets/), synced at deploy time. Never commit here.
/public/assets/

# Local deploy/reseed run artifacts (per-machine, never committed)
.last-deploy-uuid
.reseed-deploy-uuid
.reseed*-uuid

# Local pre-wipe vault snapshots (plaintext, mode 600) — never commit
.vault-backups/

# FUSE filesystem deletion artifacts (accidental commits over network mounts)
.fuse_hidden*

# Odkladiště instančního buildu (build-ios.sh → gen:tokens). NENÍ instance:
# nese jen brand.tokens.json, nikdy i18n.json. Bez tohohle řádku zůstane po
# každém instančním buildu v repu neuklizený artefakt (naměřeno 2026-09-03).
instances/_overlay/
