# ============================================
# AISHA GATEWAY (backend API)
# ============================================
# Default production endpoint (overridable at runtime in Settings).
# Canonical var names; the legacy EXPO_PUBLIC_AISHA_POSTGREST_* names are
# still read as a fallback by config/api.ts + the build scripts.
EXPO_PUBLIC_AISHA_GATEWAY_URL=https://api.aisha.guru
EXPO_PUBLIC_AISHA_GATEWAY_ANON_KEY=your_anon_key_here

# ============================================
# OAUTH & DEEP LINKING
# ============================================
EXPO_PUBLIC_REDIRECT_URL=aisha-dirigent://oauth-callback

# ============================================
# LIVEKIT (video consultation calls)
# ============================================
# Media-server WebSocket URL (e.g. wss://livekit.<your-domain>). Required by
# useConsultationCall to join a real Room; the hook fails loud when unset.
# EXPO_PUBLIC_LIVEKIT_URL=wss://livekit.aisha.guru

# ============================================
# FIREBASE (FCM Push Notifications)
# ============================================
# google-services.json (Android) and GoogleService-Info.plist (iOS)
# must be placed in the project root
EXPO_PUBLIC_FCM_SENDER_ID=961409396988

# ============================================
# SENTRY (Error Tracking — self-hosted)
# ============================================
# EXPO_PUBLIC_SENTRY_DSN=https://key@sentry.id3a.cz/project-id
# EXPO_PUBLIC_SENTRY_IOS_DSN=https://key@sentry.id3a.cz/ios-project-id
# EXPO_PUBLIC_SENTRY_ANDROID_DSN=https://key@sentry.id3a.cz/android-project-id
# EXPO_PUBLIC_SENTRY_ENV=development
# SENTRY_AUTH_TOKEN=sntrys_...

# ============================================
# APP INTEGRITY
# ============================================
# EXPO_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=961409396988

# ============================================
# DEVELOPMENT (local gateway)
# ============================================
# EXPO_PUBLIC_AISHA_GATEWAY_URL=http://127.0.0.1:3001
# EXPO_PUBLIC_AISHA_GATEWAY_ANON_KEY=your-local-anon-key

# ============================================
# COSMOS (AISHA App-Chain)
# ============================================
# RPC endpoint for CosmJS signing client (mobile wallet)
EXPO_PUBLIC_COSMOS_RPC=https://rpc.aisha.guru
# REST API for proposal queries
EXPO_PUBLIC_COSMOS_API=https://api.n8n.aisha.guru
# Chain ID
EXPO_PUBLIC_COSMOS_CHAIN_ID=aisha-1
