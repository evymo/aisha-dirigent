{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["aisha", "postgres"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "AISHA Postgres",
  "uid": "aisha-postgres",
  "version": 1,
  "panels": [
    {
      "title": "Active connections",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(pg_stat_activity_count)" }
      ]
    },
    {
      "title": "Cache hit ratio",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(rate(pg_stat_database_blks_hit[5m])) / (sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "title": "Transactions/sec",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum by (datname) (rate(pg_stat_database_xact_commit[5m]))", "legendFormat": "commit/{{datname}}" },
        { "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback[5m]))", "legendFormat": "rollback/{{datname}}" }
      ]
    },
    {
      "title": "Top 10 queries by total time",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "topk(10, pg_stat_statements_total_time_seconds)",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
