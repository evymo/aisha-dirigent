        "jsCode": "// Non-auto-approved proposals are queued for human review.\n// Update proposal status and notify via appropriate channel.\nconst proposal = $json.proposal;\n\nreturn [{\n  json: {\n    action: 'queued_for_review',\n    proposal_id: proposal.proposal_id,\n    risk_level: proposal.risk_level,\n    agent: proposal.agent,\n    message: `Proposal ${proposal.proposal_id} queued for human review (risk: ${proposal.risk_level})`\n  }\n}];"
