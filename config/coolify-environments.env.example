# =============================================================================
# coolify-environments.env — Per-environment Coolify endpointy + creds aliasy
# =============================================================================
# Single source of truth pro mapping AISHA_ENV → konkrétní Coolify cluster.
# Skripty (aisha-cold-start, redeploy, drift-watch) source-ují tenhle soubor
# a podle AISHA_ENV vyberou správné values:
#
#   AISHA_ENV=production  → COOLIFY_BASE_URL = production
#   AISHA_ENV=staging     → COOLIFY_BASE_URL = staging
#
# Creds (COOLIFY_API_TOKEN, GITHUB_TOKEN) zůstávají v .env-prod-backup
# resp. .env-staging-backup (specific per-env).
# =============================================================================

# Default environment when AISHA_ENV is not set
AISHA_ENV_DEFAULT=production

# ── Production ──────────────────────────────────────────────────────────────
# Výchozí: Coolify běžící lokálně (výchozí port Coolify je 8000).
# UUIDs níž doplní coolify-deploy-init / cold-start pro TVOU instanci.
COOLIFY_PROD_URL=http://localhost:8000
COOLIFY_PROD_PROJECT_UUID=
COOLIFY_PROD_SERVER_UUID_FRONTEND=
COOLIFY_PROD_SERVER_UUID_BACKEND=
COOLIFY_PROD_SERVER_UUID_EXPERIMENTAL=
COOLIFY_PROD_SERVER_UUID_BUILD=
COOLIFY_PROD_ENV_BACKUP=.env-prod-backup
COOLIFY_PROD_DOMAINS_FILE=config/domains.env

# ── Staging ─────────────────────────────────────────────────────────────────
# Doplň skutečné UUIDs po setupu staging instance.
COOLIFY_STAGING_URL=
COOLIFY_STAGING_PROJECT_UUID=
COOLIFY_STAGING_SERVER_UUID_FRONTEND=
COOLIFY_STAGING_SERVER_UUID_BACKEND=
COOLIFY_STAGING_SERVER_UUID_EXPERIMENTAL=
COOLIFY_STAGING_ENV_BACKUP=.env-staging-backup
COOLIFY_STAGING_DOMAINS_FILE=config/domains-staging.env
