# ==============================================================================
# config/domains.env — KEY contract for AISHA stack domain SoT.
# ==============================================================================
#
# THIS FILE IS A TEMPLATE — all values are intentionally empty.
#
# Operator populates concrete domains via `.env-prod-backup` (or a per-env
# overlay sourced AFTER this file at cold-start). The repo ships zero
# deployment-specific hostnames so the template can be cloned for any TLD.
#
# Reference values for the AISHA upstream deploy live in
# `config/domains.env.example` — use it as a starting point and adapt for
# your domain. Operators of forks (acme-, staging-, etc.) MUST
# override every key here in their own per-deployment overlay.
#
# Cold-start order (scripts/aisha-cold-start.sh):
#   1. `set -a; source config/domains.env; set +a`       (this file, all empty)
#   2. `set -a; source .env-prod-backup; set +a`         (operator values)
#   3. `derive-domains.mjs` runs against the topology resolver to fill any
#      derived `*_DOMAIN_PUBLIC` / `*_UPSTREAM_*` keys.
#   4. Scripts that consume these keys use `${VAR:?required}` and fail-fast
#      if the operator forgot to supply a needed key.
#
# ZONES (operator decides whose subdomain each tier uses):
#
#   PUBLIC_TLD                      — client-facing routes (web, api, auth)
#   INTERNAL_TLD                    — per-server admin routes (<svc>.<server>.<INTERNAL_TLD>)
#   MESH_TLD                        — NetBird peer-to-peer mesh DNS
#
# RULES (enforced by `src/tests/gates/domain-zoning.gate.test.ts`):
#   1. No INTERNAL service may receive a PUBLIC_TLD subdomain
#   2. No PUBLIC service may receive an INTERNAL_TLD subdomain
#   3. INTERNAL subdomains MUST embed the server's hostname segment
#   4. URLs never carry `:port` — Traefik routes port-less
#
# HOW TO RELOCATE A SERVICE ACROSS SERVERS:
#   1. Move it in `coolify/servers.json` `stacks[]`
#   2. Update its subdomain here (replace the old server segment)
#   3. Re-run `bash scripts/aisha-cold-start.sh --skip-create` (env re-push)
# ==============================================================================

# ── TLD CONVENTION ─────────────────────────────────────────────────────────
# Declarative top-level domains. Compose / scripts reference these instead of
# repeating literals — single place to rotate any TLD on migration.
PUBLIC_TLD=${PUBLIC_TLD:-}
INTERNAL_TLD=${INTERNAL_TLD:-}
MESH_TLD=${MESH_TLD:-}

# Public web design folder (folder-name == domain). svc-web-artifact's
# /seed-default auto-imports domains/templates/<AISHA_SEED_DOMAIN>/ at boot when
# that folder exists, else the neutral domains/default/. The env-doctor
# auto-derives this from PUBLIC_TLD; set it here only to seed a
# differently-named template folder. Empty → neutral default.
# Self-heal: derives from PUBLIC_TLD (resolver-populated) when operator leaves
# it unset — matches the reference PUBLIC_TLD without .example fallback.
AISHA_SEED_DOMAIN=${AISHA_SEED_DOMAIN:-${PUBLIC_TLD}}

# ── PUBLIC ZONE — *.${PUBLIC_TLD} — edge server only ─────────────────────────
# Services accessible from the public internet. Wildcard TLS cert is
# terminated by the edge-server Traefik. Operator deploys these on the
# server marked as edge in `coolify/servers.json`.
APP_DOMAIN=${APP_DOMAIN:-}
# WEB_FQDNS — optional multi-brand domain LIST for the edge `web` service: a
# comma-separated set of brand-variant hostnames (e.g.
# https://brand-a.example.com,https://brand-b.example.com) all bound to the
# same web container. The SPA routes per hostname at runtime via
# branding_hostname_mapping → get_branding_for_hostname, so one bundle serves
# every brand. coolify-deploy-init.sh forwards this list to Coolify so a
# from-scratch cold-start wires ALL brand domains automatically. Instances set
# the concrete value in config/domains-<profile>.env; unset → falls back to the
# single ${APP_DOMAIN} (single-brand behaviour unchanged).
WEB_FQDNS=${WEB_FQDNS:-}
NETBIRD_DOMAIN=${NETBIRD_DOMAIN:-}
# Internal mesh hostname for NetBird control plane. Resolves only via
# per-stack `extra_hosts` to NETBIRD_MGMT_HOST (edge LAN IP). Bypasses
# Coolify Traefik (avoids LE-cert SNI issues on LAN interface) and uses
# cert issued by AISHA PKI. See docker-compose.coolify-netbird.yml.
# Self-heal: derives from MESH_TLD (resolver-populated) when operator unset.
NETBIRD_MESH_HOST=${NETBIRD_MESH_HOST:-netbird.${MESH_TLD}}
REGISTRY_DOMAIN=${REGISTRY_DOMAIN:-cache.${PUBLIC_TLD}}
# Forgejo git server — hosts the orchestrator repo + main org. Used by
# build pipelines (Coolify pulls source) and Node tooling
# (`scripts/lib/env.mjs` derives FORGEJO_URL = https://${FORGEJO_DOMAIN}).
# Self-heal: derives repo.<INTERNAL_TLD> when operator leaves it unset.
FORGEJO_DOMAIN=${FORGEJO_DOMAIN:-repo.${INTERNAL_TLD}}
# Verdaccio private npm registry URL — used by .npmrc, CI publish workflows.
VERDACCIO_URL=${VERDACCIO_URL:-https://npm.${INTERNAL_TLD}/}
# n8n public entrypoint (OAuth2 Proxy → n8n editor); MCP integrations point here.
MCP_DOMAIN=${MCP_DOMAIN:-}
# "Dirigent" — orchestration-layer public alias for the same n8n/MCP service
# (additional Traefik router on the same edge mesh-proxy).
DIRIGENT_DOMAIN=${DIRIGENT_DOMAIN:-}
# Apex host routed by edge-proxy: bare ${PUBLIC_TLD} answers HTTP 308 →
# https://${APP_DOMAIN}${uri}. Resolver-derived (derive-domains.mjs): equals
# PUBLIC_TLD when the apex rule applies (PUBLIC_TLD set and != APP_DOMAIN),
# else the unroutable sentinel apex-redirect-disabled.invalid — community
# installs where the web app itself owns the apex are unaffected.
EDGE_APEX_DOMAIN=${EDGE_APEX_DOMAIN:-}

# ── MESH ZONE — *.${MESH_TLD} — NetBird peer-to-peer ─────────────────────────
# Functional-role peer hostnames. Independent of which physical server hosts
# the stack — name reflects the service role, not its location, so a stack
# can relocate without rename. See feedback_mesh_naming_convention.md.
# Self-heal: each derives <role>.<MESH_TLD> (resolver-populated) when unset.
# ⛔ BACKEND_MESH_HOST ODSTRANĚN 2026-08-25. Byl to backward-compat alias na
# roli SERVERU ("backend") uvnitř mesh zóny — tedy umístění vydávané za identitu.
# Role serveru se z adres ruší celé: jedna cesta dovnitř je mesh, plným jménem.

# ── VNITŘNÍ ZÓNA — <svc>.${MESH_TLD} ────────────────────────────────────────
# Per-server Traefik with a local wildcard cert `*.<server>.${INTERNAL_TLD}`.
# Reached server-side through mesh or directly from inside the operator's
# private network. PUBLIC frontend hits these via the edge proxy through mesh.

# Backend (core, identity, orchestration, observability, messaging, pki)
# DIRECT internal route — used by other backend stacks via mesh.
API_DOMAIN=${API_DOMAIN:-}
# PUBLIC route — same backend, accessed via edge-proxy through mesh.
# Browser / external clients use this; *.${INTERNAL_TLD} is admin/dev only.
API_DOMAIN_PUBLIC=${API_DOMAIN_PUBLIC:-}
# pgAdmin — dual access:
#   PUBLIC (via edge proxy → backend mesh):   STUDIO_DOMAIN
#   DIRECT (on backend Traefik from mesh):    STUDIO_DOMAIN_DIRECT
# Self-heal: public db.<PUBLIC_TLD> + vnitřní db.<MESH_TLD>.
STUDIO_DOMAIN=${STUDIO_DOMAIN:-db.${PUBLIC_TLD}}
STUDIO_DOMAIN_DIRECT=${STUDIO_DOMAIN_DIRECT:-db.${MESH_TLD}}
KEYCLOAK_DOMAIN=${KEYCLOAK_DOMAIN:-}
KEYCLOAK_DOMAIN_PUBLIC=${KEYCLOAK_DOMAIN_PUBLIC:-}
AUTH_DOMAIN_PUBLIC=${AUTH_DOMAIN_PUBLIC:-}
# Realm name — operator-defined SoT (so the stack can be reused for any
# tenant without code edits). Referenced as `${KEYCLOAK_REALM}` in scripts,
# compose files, and product code (Vite/Expo build-time injection).
# Self-heal: defaults to the AISHA reference realm name when operator unset.
KEYCLOAK_REALM=${KEYCLOAK_REALM:-aisha}
N8N_DOMAIN=${N8N_DOMAIN:-}
LANGFUSE_DOMAIN=${LANGFUSE_DOMAIN:-}
MATRIX_DOMAIN=${MATRIX_DOMAIN:-}
ELEMENT_DOMAIN=${ELEMENT_DOMAIN:-}
ELEMENT_CALL_DOMAIN=${ELEMENT_CALL_DOMAIN:-}
# Self-heal: vnitřní livekit/turn na <MESH_TLD>, když je operátor nedeklaruje.
LIVEKIT_DOMAIN=${LIVEKIT_DOMAIN:-livekit.${MESH_TLD}}
TURN_DOMAIN=${TURN_DOMAIN:-turn.${MESH_TLD}}
# PUBLIC face — for clients OUTSIDE the mesh (mobile app, browser). No self-heal
# on purpose: LIVEKIT_DOMAIN above heals to an INTERNAL name, which is right for
# services inside the mesh and unreachable for a phone. A build that needs calls
# must be told the public face; silence here means "this instance publishes no
# LiveKit", not "guess one".
#
# ⛔ NAMĚŘENO 2026-08-20: mobile-app derived EXPO_PUBLIC_LIVEKIT_URL from
# LIVEKIT_DOMAIN, so the app shipped `wss://livekit.backend.<INTERNAL_TLD>` —
# a name no phone can resolve. It surfaces in the field as "cannot join the
# call room". The same variable was correct for one consumer and unreachable
# for the other, and nothing measured the difference.
LIVEKIT_DOMAIN_PUBLIC=${LIVEKIT_DOMAIN_PUBLIC:-}
PKI_DOMAIN=${PKI_DOMAIN:-}
# pki-bridge je na Backend serveru; pki-init (netbird stack, Frontend) ho dosahuji
# přes public Traefik route (Docker DNS nekříží servery).
PKI_BRIDGE_DOMAIN=${PKI_BRIDGE_DOMAIN:-pki-bridge.${MESH_TLD}}
PKI_BRIDGE_URL=${PKI_BRIDGE_URL:-https://${PKI_BRIDGE_DOMAIN}}

# Admin stack (NocoDB + Appsmith + Intranet)
NOCODB_DOMAIN=${NOCODB_DOMAIN:-}
APPSMITH_DOMAIN=${APPSMITH_DOMAIN:-}
INTRANET_DOMAIN=${INTRANET_DOMAIN:-}

# ── Intranet identity (S2 token-exchange isolation) ──────────────────────────
# The gateway /intranet/* endpoints (token-exchange, rpc, mcp) derive identity
# ONLY from a VERIFIED Keycloak access token whose client is the dedicated
# intranet oauth2-proxy client (<OIDC_CLIENT_PREFIX>appsmith-intranet-proxy).
# This env is the gateway's dedicated allow-list for that check
# (config.kcIntranetAllowedClients) — intentionally NARROWER than
# KC_ALLOWED_CLIENTS. Empty here → the gateway fail-loud 401s every intranet
# call until the operator wires the concrete client id in their per-env overlay.
# NOTE (Coolify gateway env): the same intranet client must ALSO be present in
# KC_ALLOWED_CLIENTS so verifyKeycloakClaims accepts it before the narrow check,
# and INTRANET_PROXY_URL (the oauth2-proxy front for the gateway /intranet path)
# must be set for provision-intranet.sh / the Appsmith datasources.
KC_INTRANET_ALLOWED_CLIENTS=${KC_INTRANET_ALLOWED_CLIENTS:-}

# Phase 2 autopilot domains are derived by `scripts/lib/derive-domains.mjs`
# from `config/services.json` + per-profile `service_overrides.legacy_env_var`,
# NOT declared statically here. Resolver emits at cold-start:
#   - GATEWAY_DOMAIN     (llm-gateway, subdomain "gateway")
#   - COMPANION_DOMAIN   (openclaw, subdomain "companion")
#   - GRAFANA_DOMAIN     (grafana)
#   - *_DOMAIN_PUBLIC / *_DOMAIN variants per zone

# Dozzle (logs) — typically deployed on monitoring stack
DOZZLE_DOMAIN=${DOZZLE_DOMAIN:-}
# Sentry error tracking — webhooks used by WF_SENTRY_OBSERVER; full URL in SENTRY_URL
SENTRY_DOMAIN=${SENTRY_DOMAIN:-sentry.${INTERNAL_TLD}}

# ── DERIVED URLs (computed from the above; do not hand-edit) ─────────────────
# Composite values that just glue together other keys. The base keys are
# operator-set; these stay templated as ${X} so they reflect whatever
# operator chose.
# KEYCLOAK_URL honours an operator pin (:- guard) exactly like FORGEJO_DOMAIN
# above. Without it this unconditional assignment CLOBBERED the operator's
# .env.local value: cold-start sources .env.local first, this file after, so a
# pin here lost silently. KEYCLOAK_DOMAIN is the INTERNAL host, which two real
# consumers cannot use — the host-side Phase B bootstrap (runs on the operator
# machine, cannot resolve *.internal at all → /health/ready 000000, cold-start
# stalls retrying) and in-cluster JWKS readers (backend Traefik serves an invalid
# cert for the internal host). Both need the front-served public host, which is
# precisely what an operator pins. Default is unchanged for installs that pin
# nothing.
KEYCLOAK_URL=${KEYCLOAK_URL:-https://${KEYCLOAK_DOMAIN}}
AISHA_API_URL=https://${API_DOMAIN}
AISHA_BACKEND_URL=https://${API_DOMAIN}
NETBIRD_API_URL=https://${NETBIRD_DOMAIN}
TURN_REALM=${TURN_DOMAIN}
SYNAPSE_SERVER_NAME=${MATRIX_DOMAIN}
PUBLIC_SITE_URL=https://${APP_DOMAIN}

# Vite build-time (frontend bundle)
VITE_PUBLIC_SITE_URL=https://${APP_DOMAIN}
VITE_API_URL=https://${API_DOMAIN_PUBLIC}
VITE_AISHA_BACKEND_URL=https://${API_DOMAIN_PUBLIC}
VITE_AISHA_GATEWAY_URL=https://${API_DOMAIN_PUBLIC}
# Storage NA API: kam klient posílá obsah souboru (storage-auth ho streamuje do
# MinIA). Presigned URL MinIA nese MINIO_ENDPOINT — jméno v meshi, které telefon
# z terénu nepřeloží (naměřeno 2026-09-18: fotky předání nikdy neodešly).
STORAGE_PUBLIC_URL=https://${API_DOMAIN_PUBLIC}/storage/v1

VITE_KC_URL=https://${AUTH_DOMAIN_PUBLIC}
VITE_KC_AUTHORITY=https://${AUTH_DOMAIN_PUBLIC}/realms/${KEYCLOAK_REALM}
VITE_AUTH_REDIRECT_URI=https://${APP_DOMAIN}/auth/callback
VITE_AUTH_POST_LOGOUT_URI=https://${APP_DOMAIN}

# CORS / OIDC redirect whitelist
#
# SURFACE_ORIGINS is appended, not listed: a surface SPA (extranet, mobile) is a
# browser origin that calls this same API, and none of the three domains above is
# one. Until 2026-07-28 the extranet was therefore rejected at the CORS preflight
# — it signed in against Keycloak and then could not read a single block. The
# value is derived by scripts/lib/derive-domains.mjs from the profile's
# `surfaces` declaration (the same one provision-surfaces.sh provisions from), so
# it cannot drift from the apps that actually exist. Empty when an instance
# declares no surfaces; the ${VAR:+,${VAR}} form keeps the list comma-clean.
# AUTH_DOMAIN_PUBLIC je tu ze stejného důvodu jako povrchy: přihlašovací stránka
# Keycloaku je prohlížečový origin, který volá TOTÉŽ API. Téma na ní ukazuje
# agregovaný příznak provozu a tahá si ho z ${API_DOMAIN_PUBLIC}/api/health.
# Naměřeno 2026-08-03: `curl -H "Origin: https://auth.<tld>"` vracel 403, takže
# prohlížeč odpověď zahodil a příznak zůstal navždy na „zjišťuje se". Zvenku to
# vypadá jako mrtvá kontrolka, ne jako odmítnutý preflight.
ALLOWED_ORIGINS=https://${APP_DOMAIN},https://${API_DOMAIN_PUBLIC},https://${API_DOMAIN},https://${AUTH_DOMAIN_PUBLIC}${SURFACE_ORIGINS:+,${SURFACE_ORIGINS}}${WEB_ALIAS_ORIGINS:+,${WEB_ALIAS_ORIGINS}}

# CORS_ALLOWLIST — the same list, under the name the SERVICES read.
#
# Every Fastify service declares `CORS_ALLOWLIST: ${CORS_ALLOWLIST:-}` in its
# compose and passes it to applySecurity(). Nothing ever ASSIGNED that variable,
# so the default won: an empty allowlist, which denies every browser origin.
# Measured on a production instance 2026-07-30: svc-ai-chat logged `cors.empty_allowlist` at boot
# and then `cors.deny origin=https://extra.<internal-tld>` for real, authenticated
# requests from the extranet — the answer was computed and thrown away by the
# browser. Two names existed for one concept and the bridge between them did not.
#
# Derived, not listed: ALLOWED_ORIGINS is already composed from the app, the API
# (public + internal) and SURFACE_ORIGINS, which itself comes from the profile's
# `surfaces` declaration. A new hand-kept list would drift from the surfaces the
# instance actually provisions — which is the defect this line exists to close.
# Per-instance and universal: an instance with no surfaces simply gets the three
# base origins, and one with three surfaces gets all of them, with no edit here.
CORS_ALLOWLIST=${ALLOWED_ORIGINS}
ADDITIONAL_REDIRECT_URLS=https://${APP_DOMAIN}/auth/callback,https://${APP_DOMAIN}/auth/v1/callback,https://${API_DOMAIN_PUBLIC}/auth/v1/callback,https://${API_DOMAIN}/auth/v1/callback,aisha-dirigent://oauth-callback,vscode://aisha.aisha-dirigent/did-authenticate,vscode://aisha.aisha-dirigent/did-authenticate/,vscode-insiders://aisha.aisha-dirigent/did-authenticate,vscode-insiders://aisha.aisha-dirigent/did-authenticate/,https://vscode.dev/redirect*,https://insiders.vscode.dev/redirect*

# Webhook URLs (cross-stack)

# Ragnarok se volá ZEVNITŘ, ne přes veřejné API: běží ve stacku integrace a
# poslouchá na 9696. Šablona tu do 2026-08-03 měla `https://${API_DOMAIN}`, což
# je adresa gateway — cold start by tím přepsal funkční hodnotu za takovou,
# která na Ragnarok vůbec nemíří (jiná služba, jiný port, a TLS tam nikdo
# neterminuje). V `.env.coolify` byla po celou dobu správná hodnota
# `http://integration.mesh.<mesh-tld>:9696`, takže se rozpor projevil až při
# rozvinutí šablony proti SoT (scripts/deploy/derive-composites.sh).
#
# `http://` je záměr: uvnitř mesh se nešifruje podruhé, tunel už šifrovaný je.
LIVEKIT_WEBHOOK_URL=https://${API_DOMAIN}/functions/v1/livekit-webhook
MATRIX_WEBHOOK_URL=https://${API_DOMAIN}/functions/v1/matrix-webhook

# ── NOTIFICATION CONFIG (non-domain, but operator-supplied at stack level) ───
# Admin contact email for automated alerts (WF_EXPERT_NOTIFICATION et al.)
AISHA_ADMIN_EMAIL=${AISHA_ADMIN_EMAIL:-}

# ── MESH on/off switch ───────────────────────────────────────────────────────
# Edge-proxy backend reach strategy:
#   false (default): edge-proxy → public *.${INTERNAL_TLD} over TLS via the
#                    backend's Traefik. Cross-server without NetBird-mesh
#                    dependency. The de-facto stable state during cold-start.
#   true:            edge-proxy → mesh-router (DNAT) → wt0 → core peer over
#                    WireGuard. Requires healthy netbird-internal-tls + valid
#                    AISHA PKI cert.
#
# Toggle via:
#   node scripts/aisha-mesh-toggle.mjs --status  # show current
#   node scripts/aisha-mesh-toggle.mjs --on      # enable mesh + redeploy edge
#   node scripts/aisha-mesh-toggle.mjs --off     # disable mesh + redeploy edge
# ⛔ MESH NENÍ PŘEPÍNAČ. Je to PODMÍNKA PROVOZU (rozhodnuto 2026-08-26).
#
# Souvisí to přímo s adresami VÝŠ: vnitřní fallbacky teď míří do ${MESH_TLD}
# (db, livekit, turn, pki-bridge). S vypnutou meshí by tedy neměly kudy téct —
# a hůř, resolver by je tiše nahradil slotovou zónou.
#
# Naměřené následky výchozí `false`:
#   1. Resolver plnil `*_UPSTREAM_MESH` NEMESHOVOU adresou. Proměnná, jejímž
#      jediným smyslem je nést meshovou adresu, tiše nesla jinou.
#   2. edge jel v režimu `public`: mesh vznikla, peeři byli `connected` —
#      a NEPOUŽÍVALA JI ANI JEDNA služba.
#   3. Cold-start má pojistku „MESH_ENABLED není deklarované — 'nevím' není 'ne'".
#      Tahle výchozí hodnota ji UMLČELA: nikdy nebyla prázdná, takže se
#      pojistka nikdy nespustila.
#
# Bod 3 je obecný: výchozí hodnota v konfiguraci vypne fail-closed pojistku
# stejně spolehlivě jako její smazání — jen to není vidět v diffu.
# ⛔ VĚDOMÁ VÝJIMKA z pravidla „šablona nepřebíjí deklaraci" (níž u EXTRANET_ENABLED):
# mesh NENÍ volba instance, je to podmínka platformy — hlídá brána `mesh-toggle`,
# která tady doslovné `MESH_ENABLED=true` VYŽADUJE. Proto tu přepis je záměr.
MESH_ENABLED=true

# ── Intranet (Appsmith "Story Intra") feature flag (H1 / W4-03) ──────────────
# The SINGLE cold-start switch that governs BOTH the gateway /intranet route
# (services/gateway/src/config.ts intranetEnabled ← INTRANET_ENABLED) AND intranet
# app provisioning (scripts/provision-intranet.sh, which refuses to run unless
# this is 'true'). Default OFF so the intranet is opt-in and can never be
# half-deployed (route on but app absent, or vice versa). Flip to true once the
# Appsmith admin stack + intranet OIDC client are provisioned.
# ⛔ ŠABLONA NESMÍ PŘEBÍT DEKLARACI (naměřeno 2026-09-16 při studeném startu).
# Tenhle soubor se sourcuje JAKO POSLEDNÍ (lib/resolve-domains-env.sh: operátorský
# trezor → resolver topologie → tady), takže DOSLOVNÁ hodnota přepíše i to, co
# instance výslovně deklarovala. `EXTRANET_ENABLED=false` tak přebilo
# `EXTRANET_ENABLED=1` z trezoru instance: story-init vyhodnotil bránu provisioningu
# jako vypnutou, aplikaci extranetu NEZALOŽIL a deploy-init pak hlásil „stack je
# v manifestu, ale aplikace v Coolify NENÍ". Studený start doběhl s dírou.
# Výchozí hodnota platformy se proto píše tvarem `${KLIC:-výchozí}`: platí, když
# nikdo nedeklaroval, a mlčí, když ano. Hlídá brána `sablona-neprebiji-deklaraci`.
INTRANET_ENABLED=${INTRANET_ENABLED:-false}

# ── Extranet (zákaznický povrch) feature flag ───────────────────────────────
# config/services.json u služby `extranet` deklaruje provision_when_env:
# EXTRANET_ENABLED, ale sám příznak nebyl deklarovaný NIKDE. Důsledek nebyl
# tichý: derivace pak nevydala EXTRANET_DOMAIN ani EXTRANET_DOMAIN_PUBLIC,
# compose preflight spadl na „required variable EXTRANET_DOMAIN is missing
# a value" a s ním CELÝ cold-start (změřeno 2026-07-30).
#
# Opt-in default vypnuto, stejně jako intranet výš: instance bez extranetu
# nesmí selhat při nasazení. Vypnutý stav je přitom PLNĚ definovaný — derivace
# vydá `extranet-disabled.invalid`, takže Traefik label má hodnotu a compose
# se interpoluje. Instance ho zapíná ve svém env (EXTRANET_ENABLED=true).
EXTRANET_ENABLED=${EXTRANET_ENABLED:-false}

# =============================================================================
# SSRF — kam služba SMÍ volat. ODVOZENO, ne udržováno.
# =============================================================================
# ⛔ NAMĚŘENO 2026-08-19. Do dneška to byl ruční seznam ve compose a rozešel se
# se skutečností všude, kam jsme sáhli:
#     ai-chat měl v seznamu   aisha-openclaw        (jméno CIZÍ instance)
#     ...a volal na           <x>-companion.mesh.<tld>   (z OPENCLAW_URL)
#     svc-blockchain měl      local-postgrest, local-keycloak
#     ...a volal na           aisha-postgrest, localhost, <x>-cosmos-node
# Tři ze čtyř položek mimo, a to u JEDNÉ služby; `SSRF_HOST_ALLOWLIST` čte 10+.
# Nebyla to nepozornost — byla to druhá kopie informace, kterou už drží ta URL.
#
# TÝŽ MECHANISMUS JAKO CORS (viz ALLOWED_ORIGINS výš): hostitel se BERE Z ADRESY,
# kterou služba dostala v konfiguraci. Adresa se změní → seznam se změní s ní.
# Do seznamu se nová služba dostane tím, že VZNIKNE, ne tím, že si na ni někdo
# vzpomene. Hodnota se proto v `.env.coolify` NEEDITUJE — dopočítá ji
# scripts/deploy/derive-composites.sh, a chybějící položka je vada DODÁVKY.
#
# Dvoukrokové loupání je záměr: `#*://` sundá schéma, `%%:*` port. Jedním
# rozvinutím to nejde a emulovat regulárním výrazem se tu už jednou nevyplatilo.
OPENCLAW_HOSTPORT=${OPENCLAW_URL:+${OPENCLAW_URL#*://}}
OPENCLAW_HOST=${OPENCLAW_HOSTPORT:+${OPENCLAW_HOSTPORT%%:*}}
COSMOS_NODE_HOST=${APP_NAME_PREFIX}-cosmos-node

# Vnější poskytovatelé modelů. Jediné, co se tu VYJMENOVÁVÁ — jsou to cizí
# služby na internetu, které žádnou naši proměnnou nemají. Prázdný `:+` tvar
# drží seznam bez visících čárek, stejně jako u origins.
LLM_PROVIDER_HOSTS=${LLM_PROVIDER_HOSTS:-api.openai.com,api.anthropic.com,generativelanguage.googleapis.com}

AI_CHAT_SSRF_ALLOWLIST=${LLM_PROVIDER_HOSTS}${OPENCLAW_HOST:+,${OPENCLAW_HOST}}
COSMOS_SSRF_ALLOWLIST=${COSMOS_NODE_HOST}
