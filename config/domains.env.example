# ==============================================================================
# config/domains.env — JEDINÝ source of truth pro doménové URL AISHA stacku.
# ==============================================================================
#
# POZNÁMKA (.example): všechny domény v tomto souboru jsou GENERICKÉ placeholdery
# (aisha.example.com / internal.example.com / mesh.example.internal). Nahraďte je
# vlastními TLD — buď přes operator env (.env-prod-backup), nebo kopií tohoto
# souboru do config/domains.env s reálnými hodnotami.
#
# ZÓNY:
#
#   PUBLIC   *.<PUBLIC_TLD>            (zde: *.aisha.example.com)
#     - DNS A-record → veřejná IP serveru `frontend`.
#     - Wildcard cert `*.<PUBLIC_TLD>` terminován Traefikem na frontend.
#     - JEN služby, které:
#         (a) koncoví uživatelé volají z internetu (web, api, auth, n8n, …),
#         (b) externí klienti/agenti potřebují endpoint
#             (NetBird mesh enrollment, Docker registry pull, PKI cert,
#              Matrix federace, LiveKit TURN/STUN, oauth callbacks).
#     - MUSÍ deployovat na server `frontend` (servers.json `stacks[]`).
#
#   INTERNAL   <svc>.<server>.<INTERNAL_TLD>   (zde: *.<server>.internal.example.com)
#     - Per-server wildcard zóna. `<server>` ∈ {frontend, backend, experimental, build}
#       a MUSÍ odpovídat skutečnému deploy targetu v servers.json.
#     - Použito pro admin/dev/ops nástroje (pgadmin, nocodb, appsmith, logs, …)
#       — chráněno OAuth2-Proxy + role-based přístup, NIKDY veřejnou doménou.
#     - Cert: per-server wildcard `*.<server>.<INTERNAL_TLD>` terminovaný lokálním
#       Traefikem na daném serveru.
#
# PRAVIDLA (vynucováno gate testem `src/tests/gates/domain-zoning.gate.test.ts`):
#   1. Žádná internal služba NESMÍ dostat *.<PUBLIC_TLD>
#   2. Žádná veřejná služba NESMÍ dostat *.<INTERNAL_TLD>
#   3. Subdoména v INTERNAL zóně MUSÍ obsahovat hostname serveru
#   4. Nikdy `:port` v URL — Traefik routuje port-less, port se řeší přes expose
#
# JAK PŘESUNOUT SLUŽBU NA JINÝ SERVER:
#   1. Změnit `coolify/servers.json` — přesunout položku v `stacks[]`
#   2. Tady upravit doménu (nahradit `<starý>` za `<nový>` server hostname)
#   3. Spustit `bash scripts/aisha-cold-start.sh --skip-create` (re-pushne envs)
# ==============================================================================

# ── TLD CONVENTION ─────────────────────────────────────────────────────────
# Declarative top-level domains. Compose files reference these instead of
# repeating literals — single place to rotate any TLD if migration ever needs.
# Enforced by src/tests/gates/mesh-naming-convention.gate.test.ts.
PUBLIC_TLD=aisha.example.com                 # client-facing routes
INTERNAL_TLD=internal.example.com            # admin via <svc>.<server>.<INTERNAL_TLD>
MESH_TLD=mesh.example.internal                    # NetBird peer-to-peer mesh DNS
# Public web design folder (folder-name == domain): /seed-default auto-imports
# domains/templates/<AISHA_SEED_DOMAIN>/ at boot when a matching folder exists.
# = PUBLIC_TLD for the main site; empty → neutral domains/default/.
AISHA_SEED_DOMAIN=aisha.example.com          # = PUBLIC_TLD; design submodule folder
# Public web brand subdomains (CSV). Derived as <alias>.${PUBLIC_TLD} by the
# edge (coolify-deploy-init) → route+cert; runtime maps them via
# branding_hostname_mapping. Empty → only the canonical web host. No brand
# hostname is hardcoded anywhere — declare every public face here.
AISHA_WEB_PUBLIC_ALIASES=web,corp            # → web.${PUBLIC_TLD} + corp.${PUBLIC_TLD}
AISHA_WEB_APEX_MODE=redirect                 # apex (bare PUBLIC_TLD): redirect|serve
# Private instance-data repo (operators + NN_*.sql incl. 01_web.sql) cloned by
# the migrate hook; optional private web-design repo (build-time overlay).
# Token from FORGEJO_API_TOKEN; never commit the value. Empty → community no-op.
# Format (set in .env-prod-backup, or auto-derived from FORGEJO_URL+token):
#   https://oauth2:<token>@<host>/<org>/aisha-instance-data.git#main
AISHA_INSTANCE_DATA_GIT_URL=
# Format: https://<host>/<org>/aisha-guru-web.git
AISHA_WEB_DESIGN_GIT_URL=

# ── PUBLIC ZONE — *.${PUBLIC_TLD} — frontend only ───────────────────────────────
# Jen služby fyzicky deploynuté na Frontend (Traefik + wildcard `*.<PUBLIC_TLD>`).
APP_DOMAIN=web.aisha.example.com
NETBIRD_DOMAIN=netbird.aisha.example.com
# Internal mesh hostname for NetBird control plane. Resolves only via
# per-stack `extra_hosts` to NETBIRD_MGMT_HOST (Frontend LAN IP). Used by
# all internal mesh agents instead of NETBIRD_DOMAIN — bypasses Coolify
# Traefik (avoids LE-cert SNI issues on LAN interface) and uses cert
# issued by AISHA PKI (the stack's Root CA chain). See
# docker-compose.coolify-netbird.yml#netbird-internal-tls.
NETBIRD_MESH_HOST=netbird.mesh.example.internal
REGISTRY_DOMAIN=cache.aisha.example.com
# Forgejo git server — hosts evymo-ai-orchestrator repo + AISHA org. Used by
# build pipelines (Coolify pulls source from here) and by Node tooling
# (scripts/lib/env.mjs derives FORGEJO_URL = https://${FORGEJO_DOMAIN}).
FORGEJO_DOMAIN=repo.internal.example.com
# n8n public entrypoint (OAuth2 Proxy → n8n editor); MCP integrations point here.
MCP_DOMAIN=mcp.aisha.example.com
# "Dirigent" — orchestration-layer public alias for the same n8n/MCP service
# (additional Traefik router on the same edge mesh-proxy). Use this domain
# when documenting the platform's public orchestration API.
DIRIGENT_DOMAIN=dirigent.aisha.example.com
# Apex host routed by edge-proxy: bare PUBLIC_TLD answers HTTP 308 →
# https://${APP_DOMAIN}${uri}. Resolver-derived (derive-domains.mjs): equals
# PUBLIC_TLD when the apex rule applies (PUBLIC_TLD set and != APP_DOMAIN),
# else the unroutable sentinel apex-redirect-disabled.invalid.
EDGE_APEX_DOMAIN=aisha.example.com

# ── MESH ZONE — *.${MESH_TLD} — NetBird peer-to-peer ─────────────────────────
# ⛔ ODSTRANĚNO 2026-09-13: CORE_MESH_HOST, EDGE_MESH_HOST, LEDGER_MESH_HOST,
# INTEGRATION_MESH_HOST, BACKEND_MESH_HOST. Nečte je žádný kód (git grep mimo
# docs a komentáře: nula), šablona config/domains.env je vyřadila 2026-08-25/09-01
# (brána sablona-nema-mrtve-promenne). Tady přežily — a cold-start je z tohoto
# souboru DOSAZOVAL do prostředí jako „placeholder" (naměřeno na nasazené instanci:
# přesně těchto pět, nic jiného). Jméno mesh peera instance odvozuje resolver topologie.

# ── INTERNAL ZONE — <svc>.<server>.<INTERNAL_TLD> ────────────────────────────
# Per-server Traefik s lokálním wildcard certem `*.<server>.<INTERNAL_TLD>`.
# Přístup obvykle přes NetBird mesh; PUBLIC frontend (APP_DOMAIN) k nim
# přistupuje server-side přes mesh, klientské volání musí mít mesh tunel.

# Backend backend (core, identity, orchestration, observability, messaging, pki)
# DIRECT internal route — *.backend.<INTERNAL_TLD> is the bypass / fallback for mesh-mediated access.
API_DOMAIN=api.backend.internal.example.com
# PUBLIC route — same backend, accessed via Frontend edge-proxy through mesh (NEW).
# Browser/external clients should use this; *.backend.<INTERNAL_TLD> is admin/dev only.
API_DOMAIN_PUBLIC=api.aisha.example.com
# pgAdmin — dual access:
#   PUBLIC (přes Frontend proxy → backend mesh):  db.<PUBLIC_TLD>
#   DIRECT (na backend Traefik z mesh):         db.backend.<INTERNAL_TLD>
# STUDIO_DOMAIN je proxy/public entry (OAuth2 callback URL); STUDIO_DOMAIN_DIRECT
# je server-side mesh shortcut pro admin nástroje běžící v backend/experimental mesh.
STUDIO_DOMAIN=db.aisha.example.com
STUDIO_DOMAIN_DIRECT=db.backend.internal.example.com
KEYCLOAK_DOMAIN=auth.backend.internal.example.com
KEYCLOAK_DOMAIN_PUBLIC=auth.aisha.example.com
AUTH_DOMAIN_PUBLIC=auth.aisha.example.com
# Realm name — operator-defined SoT (so the stack can be reused for other
# tenants without code edits). Referenced as `${KEYCLOAK_REALM}` in scripts,
# compose files, and product code (Vite/Expo build-time injection).
KEYCLOAK_REALM=aisha
N8N_DOMAIN=n8n.backend.internal.example.com
LANGFUSE_DOMAIN=langfuse.backend.internal.example.com
MATRIX_DOMAIN=matrix.backend.internal.example.com
ELEMENT_DOMAIN=element.backend.internal.example.com
ELEMENT_CALL_DOMAIN=call.backend.internal.example.com
LIVEKIT_DOMAIN=livekit.backend.internal.example.com
TURN_DOMAIN=turn.backend.internal.example.com
PKI_DOMAIN=pki.backend.internal.example.com

# Backend admin (NocoDB + Appsmith)
NOCODB_DOMAIN=nocodb.backend.internal.example.com
APPSMITH_DOMAIN=appsmith.backend.internal.example.com
INTRANET_DOMAIN=intranet.backend.internal.example.com

# Phase 2 autopilot domains are derived by scripts/lib/derive-domains.mjs from
# config/services.json + per-profile service_overrides.legacy_env_var, NOT
# declared statically here. Resolver emits at cold-start:
#   - LLM_GATEWAY_DOMAIN=gateway.backend.<INTERNAL_TLD>    (legacy_env_var "LLM_GATEWAY")
#   - OPENCLAW_DOMAIN=companion.backend.<INTERNAL_TLD>     (legacy_env_var "OPENCLAW")
#   - GATEWAY_DOMAIN=gateway.backend.<INTERNAL_TLD>        (canonical subdomain form)
# Plus *_PUBLIC_DOMAIN / *_DOMAIN_PUBLIC variants for public scope.
#
# Knowledge MCP — openclaw fetches MCP from AISHA backend (numbered
# dependency openclaw → core). docker-compose.coolify-openclaw.yml hard-
# wires AISHA_MCP_URL=https://${API_DOMAIN}/mcp directly — no
# MCP_KNOWLEDGE_DOMAIN var or override. If knowledge MCP grows its own
# dedicated server, declare it in config/services.json and let the resolver
# own its domain. See docs/architecture/CAPABILITY_GATES.md (vestigial-
# defaults audit).

# Dozzle (logs) — frontend (monitoring stack)
DOZZLE_DOMAIN=logs.frontend.internal.example.com

# ── DERIVED URLs (computed from above; nepište ručně) ────────────────────────
KEYCLOAK_URL=https://${KEYCLOAK_DOMAIN}
AISHA_API_URL=https://${API_DOMAIN}
AISHA_BACKEND_URL=https://${API_DOMAIN}
NETBIRD_API_URL=https://${NETBIRD_DOMAIN}
TURN_REALM=${TURN_DOMAIN}
SYNAPSE_SERVER_NAME=${MATRIX_DOMAIN}
PUBLIC_SITE_URL=https://${APP_DOMAIN}

# Vite build-time (frontend bundle)
VITE_PUBLIC_SITE_URL=https://${APP_DOMAIN}
VITE_API_URL=https://${API_DOMAIN_PUBLIC}
VITE_AISHA_BACKEND_URL=https://${API_DOMAIN_PUBLIC}
VITE_AISHA_GATEWAY_URL=https://${API_DOMAIN_PUBLIC}
VITE_KC_URL=https://${AUTH_DOMAIN_PUBLIC}
VITE_KC_AUTHORITY=https://${AUTH_DOMAIN_PUBLIC}/realms/${KEYCLOAK_REALM}
VITE_AUTH_REDIRECT_URI=https://${APP_DOMAIN}/auth/callback
VITE_AUTH_POST_LOGOUT_URI=https://${APP_DOMAIN}

# CORS / OIDC redirect whitelist
ALLOWED_ORIGINS=https://${APP_DOMAIN},https://${API_DOMAIN_PUBLIC},https://${API_DOMAIN}
ADDITIONAL_REDIRECT_URLS=https://${APP_DOMAIN}/auth/callback,https://${APP_DOMAIN}/auth/v1/callback,https://${API_DOMAIN_PUBLIC}/auth/v1/callback,https://${API_DOMAIN}/auth/v1/callback,aisha-dirigent://oauth-callback,vscode://aisha.aisha-dirigent/did-authenticate,vscode://aisha.aisha-dirigent/did-authenticate/,vscode-insiders://aisha.aisha-dirigent/did-authenticate,vscode-insiders://aisha.aisha-dirigent/did-authenticate/,https://vscode.dev/redirect*,https://insiders.vscode.dev/redirect*

# Webhook URLs (cross-stack)
RAGNAROK_URL=https://${API_DOMAIN}
LIVEKIT_WEBHOOK_URL=https://${API_DOMAIN}/functions/v1/livekit-webhook
MATRIX_WEBHOOK_URL=https://${API_DOMAIN}/functions/v1/matrix-webhook

# ── MESH on/off switch ───────────────────────────────────────────────────────
# Single switch for edge-proxy backend reach strategy:
#   false (default): edge-proxy → public *.backend.<INTERNAL_TLD> over TLS via
#                    Backend Traefik. Cross-server (Frontend→Backend) without
#                    NetBird mesh dependency. The current de-facto stable state.
#   true:            edge-proxy → mesh-router (DNAT) → wt0 → core peer
#                    over WireGuard. Requires healthy netbird-internal-tls
#                    + valid AISHA PKI cert.
#
# Toggle via:
#   node scripts/aisha-mesh-toggle.mjs --status  # show current
#   node scripts/aisha-mesh-toggle.mjs --on      # enable mesh + redeploy edge
#   node scripts/aisha-mesh-toggle.mjs --off     # disable mesh + redeploy edge
#
# Default OFF: cold-start brings the platform up via public-TLS path so it
# works without waiting for cert acquisition / OpenXPKI bootstrap to settle.
# Flip to ON when mesh has been validated end-to-end.
MESH_ENABLED=false

# ── Intranet (Appsmith "Story Intra") feature flag (H1 / W4-03) ──────────────
# Single cold-start switch gating BOTH the gateway /intranet route AND intranet
# app provisioning (provision-intranet.sh). Default OFF (opt-in) so the intranet
# can never be half-deployed. Flip to true once the Appsmith admin stack +
# intranet OIDC client are provisioned.
INTRANET_ENABLED=false

# ── PKI resource ceilings (blast-radius caps) ────────────────────────────────
# Declared here so they travel through the pipeline (generate → .env.coolify →
# coolify-sync-envs) instead of being typed into the Coolify UI per install.
#
# Defaults are sized for the SMALLEST supported box — a 1-core single-user VPS.
# The docker daemon refuses --cpus above the host core count, so a default of 2.0
# would make pki-server fail to start there; raise these on bigger nodes instead
# of editing the compose. Leave unset to accept the compose defaults.
#
# PKI_SERVER_MEM is sized from CONCURRENCY, not idle footprint: openxpki
# server.yaml prefork max_servers=25 + 10 watchdog workers at ~62 MiB each is
# ~2.2 GiB, so anything at or below 2g risks an OOM kill mid-issuance. Change it
# and max_servers together.
# PKI_SERVER_CPUS=1.0
# PKI_SERVER_MEM=3g
# PKI_DB_CPUS=1.0
# PKI_DB_MEM=1g
# PKI_DB_MAX_CONN must stay ABOVE what the watchdog can open
# (config.d/system/watchdog.yaml max_worker_count x ~3 connections each).
# MariaDB's default 151 sat right at the old 50 workers x 3 = 150, and a burst
# then exhausted the pool — every workflow failed with "Too many connections",
# which fed still more exception workflows back to the watchdog.
# PKI_DB_MAX_CONN=200
