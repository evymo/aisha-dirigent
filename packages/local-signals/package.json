{
  "name": "@aisha/local-signals",
  "version": "0.1.3",
  "license": "Elastic-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ensure:deps": "node -e \"try{require.resolve('typescript/package.json');require.resolve('zod/package.json')}catch{process.exit(1)}\" || npm ci --ignore-scripts --no-audit --no-fund",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
