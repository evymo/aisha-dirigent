  "pruvodce": {
    "aria": {
      "deck": "AISHA guide — slide deck with a quiz",
      "nav": "Guide navigation",
      "prev": "Previous",
      "next": "Next",
      "answered": "{{answered}} of {{total}} questions answered"
    },
    "quiz": {
      "counter": "Question {{num}} / {{total}}",
      "next": "Next",
      "evaluate": "Evaluate"
    },
    "s0": {
      "eyebrow": "Quick guide · 5 minutes",
      "heading": "Is AI the thing<br/>you mistype into<br/><accent>Google</accent>?",
      "body": "Maybe AISHA is a bit early for you. But if you're curious, let's walk it together — what AI actually is, why it isn't magic, and why AISHA makes your decisions easier. It ends with a five-question test so you can see where you stand.",
      "cta_go": "Let's go",
      "cta_skip": "Let me through, I'm a pro"
    },
    "s1": {
      "eyebrow": "01 · What AI actually is",
      "heading": "AI is a <accent>brilliant</accent><br/>donkey.",
      "body": "It can think about anything in the world — word by word it guesses what you'd say next. But it stays completely <strong>dumb</strong> until you tell it where it stands, where it's going and what to deliver there. Without context it just brays.",
      "lbl_dumb": "Dumb donkey",
      "arrow": "+ CONTEXT →",
      "lbl_genius": "Genius",
      "caption": "Hallucination = a donkey nobody asked where it was going."
    },
    "s2": {
      "eyebrow": "02 · There is no single AI",
      "heading": "There are <accent>dozens</accent>.<br/>Each good at something else.",
      "body": "OpenAI, Anthropic, Google, Meta, xAI, Mistral... Every provider ships <strong>whole families</strong> of models. Some write brilliantly, others code, others converse, others see images. They differ in speed, price and what they're good for.",
      "tag_universal": "universal · reasoning",
      "tag_code": "code · long context",
      "tag_fast": "fast · cheap · vision",
      "tag_local": "local · free",
      "caption": "You don't need to know them one by one. AISHA does.",
      "line_openai": "GPT-4o · GPT-5 · o3-mini",
      "line_anthropic": "Opus · Sonnet · Haiku",
      "line_google": "Gemini 2.5 Flash · Pro",
      "line_local": "Llama · Qwen · Gemma"
    },
    "s3": {
      "eyebrow": "03 · Same question, different answers",
      "heading": "<accent>Context</accent> is everything.",
      "body": "The same question gets a completely different answer in a different context. Without your documents, rules and history, AISHA guesses generically. With them, it speaks <strong>for you</strong>. That's called a <em>knowledgebase</em> — your private base of knowledge AISHA reaches into.",
      "lbl_without": "Without context",
      "answer_without": "“Generally it is recommended…”",
      "lbl_with": "With your knowledgebase",
      "answer_with": "“Your project uses X, so do Y and avoid Z.”",
      "caption": "Your documents never leave. They only help AISHA understand you."
    },
    "s4": {
      "eyebrow": "04 · Work can be spread out",
      "heading": "Not everything needs<br/>the <accent>priciest</accent> model.",
      "body": "An expensive model for everything = an expensive bill. AISHA knows when a local Qwen is enough, when a small Flash will do, and when Opus or GPT-5 has to step in. <strong>Batch processing</strong> adds a 50% discount at OpenAI and Anthropic — send it the queries that don't need an answer right away.",
      "row_greeting": "Greeting",
      "row_routine": "Routine",
      "row_analysis": "Analysis",
      "row_deep": "Deep work",
      "tier_local": "Local",
      "caption": "Five tiers. AISHA picks. You pay the minimum bill."
    },
    "s5": {
      "eyebrow": "05 · What it's good for",
      "heading": "It's not just <accent>chat</accent>.",
      "body": "Programming is only one of the domains. Here's a handful of ideas — pick yours. AISHA helps you build a knowledgebase and expert rules for any of them.",
      "uc1_name": "Marketing copy",
      "uc1_desc": "Texts in your brand voice, from the studio, blog, e-shop.",
      "uc2_name": "Code review",
      "uc2_desc": "Your team's rules, not generic advice from the internet.",
      "uc3_name": "Customer service",
      "uc3_desc": "First line of answers, escalation to a human specialist.",
      "uc4_name": "Legal research",
      "uc4_desc": "Find citations, similar cases, clauses.",
      "uc5_name": "Clinical research",
      "uc5_desc": "Protocols, audit trail, data-driven recommendations.",
      "uc6_name": "Finance & accounting",
      "uc6_desc": "Categorization, invoice checks, exports.",
