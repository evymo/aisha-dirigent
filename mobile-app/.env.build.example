# AISHA Dirigent Mobile — Build Configuration
# Copy to .env.build.local and fill in your values

# ============================================
# REQUIRED — Apple Developer Account
# ============================================
APPLE_TEAM_ID="YOUR_TEAM_ID"
APP_STORE_CONNECT_API_KEY_ID=""
APP_STORE_CONNECT_API_ISSUER_ID=""
APP_STORE_CONNECT_API_KEY_PATH=""

# REQUIRED FOR TESTER-READY iOS BUILD
# Place GoogleService-Info.plist into mobile-app/ root locally.
# Do not commit it to git.

# REQUIRED — Sentry dSYM upload (self-hosted: sentry.id3a.cz)
# build-ios.sh uploads the archive's dSYMs to Sentry on EVERY build (by design)
# and FAILS the build if this token is missing — a release without dSYMs means
# unsymbolicated crashes. Reuse SENTRY_TOKEN from .env-prod-backup or mint an
# org auth token at sentry.id3a.cz. (SENTRY_TOKEN is also accepted as a fallback.)
SENTRY_AUTH_TOKEN=""
#
# OPTIONAL — Sentry overrides. Default from version.json brand.sentry
# (project/org/url); set these only to override for a one-off build.
# SENTRY_ORG="sentry"
# SENTRY_PROJECT="aisha-dirigent"

# ============================================
# OPTIONAL — Instance env derivation (white-label builds)
# ============================================
# Point at the instance deployment env and build-ios.sh derives the whole
# runtime EXPO_PUBLIC_* set from it (PUBLIC_TLD, API_DOMAIN_PUBLIC → gateway,
# ANON_KEY, KEYCLOAK_REALM) plus version.json brand (scheme → redirect URL,
# brand.oauthClientId → KC client). No hand-written .env.production needed;
# any explicitly set EXPO_PUBLIC_* still wins.
# AISHA_INSTANCE_ENV="/path/to/instance/.env.coolify"

# ============================================
# App Identity — NOT set here
# ============================================
# App name, bundle id, slug, scheme, background colour, Sentry target and the
# umbrella/pinned gateway flag all come from mobile-app/version.json ("app" and
# "brand" blocks) — the single identity source consumed by app.config.ts and the
# build scripts. To re-skin for a client, edit version.json (and the design-tokens
# brand file); do NOT reintroduce APP_NAME/IOS_BUNDLE_ID/ANDROID_PACKAGE here —
# nothing reads them.

# ============================================
# CODE SIGNING (iOS)
# ============================================
# CODE_SIGN_IDENTITY="Apple Distribution"
# PROVISIONING_PROFILE_SPECIFIER=""

# ============================================
# ANDROID SIGNING
# ============================================
# Čte je plugins/withReleaseSigning.js (do build.gradle se píše jen čtení
# z prostředí, NIKDY hodnota). Bez nich se release podepíše VEŘEJNÝM ladicím
# klíčem šablony (CN=Android Debug):
#   · --bundle / --playstore (AAB pro Play) → build.sh SKONČÍ dřív, než začne,
#   · --apk (testy, Firebase)               → projde, ale s varováním.
# Hotové AAB se navíc ověří podle podpisu (keytool) — ladicí klíč = chyba.
#
# Klíč je UPLOAD klíč pro Google Play (Play App Signing drží podpisový klíč
# u Googlu). Ztracený upload klíč jde u Googlu vyměnit, ale jen přes podporu.
# Soubor patří do trezoru, ne do repa (*.keystore i *.jks jsou v .gitignore).
# ANDROID_KEYSTORE_PATH=""
# ANDROID_KEYSTORE_ALIAS=""
# ANDROID_KEYSTORE_PASSWORD=""
# ANDROID_KEY_PASSWORD=""
