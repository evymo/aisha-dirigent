{
  "permissions": {
    "allow": [
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(npm run build*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint*)",
      "Bash(npm run i18n:*)",
      "Bash(npm run db:types:*)",
      "Bash(npm run db:migrate:local*)",
      "Bash(npm run db:status*)",
      "Bash(npm run db:migration:register*)",
      "Bash(npm run db-mgr:*)",
      "Bash(npm run db:seed:local*)",
      "Bash(npm run func:validate*)",
      "Bash(npm run func:list*)",
      "Bash(npm run validate:static*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx vitest run*)",
      "Bash(npx eslint*)",
      "Bash(npx supabase status*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(cat .aisha/*)",
      "mcp__evymo-knowledge__*",
      "Bash(cat .claude/*)",
      "Bash(cat .mcp.json)",
      "Bash(ls /tmp/aisha-advise-*)",
      "Bash(rm -f /tmp/aisha-advise-*)",
      "Bash(bash .claude/hooks/aisha-*)",
      "mcp__aisha-knowledge__*"
    ],
    "deny": [
      "Bash(npm run supabase:reset*)",
      "Bash(*refreshdb*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-baseline-edit.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-rpc.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "rpc-only",
              "managed": true
            }
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-console.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "no-console",
              "managed": true
            }
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-any.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "no-any",
              "managed": true
            }
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-ts-ignore.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "ts-ignore",
              "managed": true
            }
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-select-star.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "select-star",
              "managed": true
            }
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-i18n.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "i18n",
              "managed": true
            }
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-scope-adjacency.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "scope-adjacency"
            }
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-impact-consistency.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "impact-consistency"
            }
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-context-reuse.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "context-reuse"
            }
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q 'git push'; then echo 'Pre-push validation: run npm run test:gates && npm run build before pushing'; fi"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-migration-check.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-bash-risk.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "bash-risk",
              "managed": true
            }
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-repo-state.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "repo-state"
            }
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-placeholder-cmd.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "placeholder-cmd"
            }
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-retry-loop.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "retry-loop"
            }
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-supervisor-relay.mjs pre_tool",
            "_aisha": {
              "kind": "relay",
              "event": "pre_tool",
              "managed": true
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q 'src/hooks/'; then npx tsc --noEmit 2>&1 | head -20; fi"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/migration-sot-pair-check.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/n8n-workflow-validation.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/edge-fn-validation.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-supervisor-relay.mjs post_tool",
            "_aisha": {
              "kind": "relay",
              "event": "post_tool",
              "managed": true
            }
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "echo '--- Story Context ---' && cat .aisha/story.json 2>/dev/null || echo 'No active story' && echo '--- Branch ---' && git branch --show-current && echo '--- Status ---' && git status --short | head -10"
          },
          {
            "type": "command",
            "command": "echo '--- AISHA Skills available ---' && ls .claude/skills/ 2>/dev/null | sed 's/^/  - /'"
          },
          {
            "type": "command",
            "command": "echo '--- AISHA work (pull) ---' && echo 'Before starting work, pull it from AISHA under your own MCP login (server aisha-knowledge): call my_next_steps, then get_story_context for the story in .aisha/story.json. Report with report_progress and close steps with complete_step — see /aisha-next. If aisha-knowledge needs a login, ask the user to run /mcp.'"
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-supervisor-relay.mjs session_start",
            "_aisha": {
              "kind": "relay",
              "event": "session_start",
              "managed": true
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-closure-backlog.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "closure-backlog"
            }
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-advise-open-state.sh",
            "_aisha": {
              "kind": "advisory",
              "rule": "open-state"
            }
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/aisha-supervisor-relay.mjs stop",
            "_aisha": {
              "kind": "relay",
              "event": "stop",
              "managed": true
            }
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_PROJECT_DIR}/.claude/statusline.sh",
    "padding": 0,
    "_aisha": {
      "kind": "statusline",
      "managed": true
    }
  },
  "_aisha_managed": {
    "version": "1.2.0",
    "principle": "advisory-only — hooks emit additionalContext, never deny actions",
    "generator": "adapter-claude-overlay",
    "bindings_count": 7,
    "relay_events": [
      "session_start",
      "pre_tool",
      "post_tool",
      "stop"
    ],
    "regenerate_with": "npm run gen:ide -- --format=claude-overlay"
  }
}
