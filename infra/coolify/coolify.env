# coolify.env — DEKLARACE, proti čemu jsou patche v `diff/`. Jediný domov těchto
# hodnot; `apply-coolify-patch.sh` je čte odsud a bez nich skončí.
#
# ⛔ VERZE JE SOUČÁST PATCHE: diffy jsou proti konkrétní vrstvě obrazu. Po bumpu
# Coolify se musí přegenerovat, ne aplikovat naslepo — proto to skript kontroluje.
COOLIFY_CONTAINER=coolify
COOLIFY_IMAGE=docker.io/coollabsio/coolify:4.3.16
