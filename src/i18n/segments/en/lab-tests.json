    "products": {
      "retisin": {
        "name": "Retisin",
        "description": "Cellular energy and tissue regeneration support based on ATP precursors",
        "mechanism": "Supports aerobic metabolism utilization by providing ATP – the energy mediator. By supplying products of aerobic metabolism that would otherwise arise from glucose oxidation, users feel better due to energy in the form of nucleotides. It first increases hemoglobin, then red blood cells, and supports tissue regenerative capacity.",
        "production": "Made from bovine blood pigment, which is processed immediately after collection without added citrates and dried. The dried blood pigment is then processed by gentle extraction using alcohol. From one liter of fresh blood, we obtain approximately 12g of active ingredients.",
        "substances": "Contains adenosine monophosphate (AMP), cytidine monophosphate (CMP), inosine monophosphate (IMP), guanosine monophosphate (GMP), uridine monophosphate (UMP), free amino acids and defensins with antimicrobial activity."
      },
      "lyastin": {
        "name": "Lyastin",
        "description": "Microcirculation and tissue nutrition support based on phospholipids and cell membrane fragments",
        "mechanism": "Acts vasodilatory by reducing atherosclerotic cholesterol deposits. It stimulates oxidative processes in tissues and improves impaired trophics of ischemic tissue. It has the ability to balance n-3 and n-6 fatty acid ratios (healthy ratio is 1:5, today it's more like 1:20 due to different diet).",
        "production": "Lipid extract containing glycerophospholipids and sphingomyelins. These substances form cellular and organelle membranes. Sufficient phospholipids are essential for proper nervous system function.",
        "substances": "Contains glycerophospholipids, sphingomyelins, phosphatidylcholines, phosphoethanolamines, triacylglycerides, sterols and lysophospholipids."
      },
      "floristen": {
        "name": "Floristen",
        "description": "Plant-based preparation for anti-inflammatory support from St. John's Wort",
        "mechanism": "Contains primarily hypericin (antiviral effects), hyperforin (antimicrobial, anti-inflammatory, and antidepressant effects), and flavonoids such as quercetin and myricetin with antioxidant capabilities. Purified extract containing only water-soluble substances.",
        "production": "Made from the upper part of St. John's Wort (Hypericum perforatum), which is chopped to about 3cm size after light wilting and dried. Production is carried out exclusively from St. John's Wort obtained on registered land blocks under organic farming.",
        "substances": "Contains hypericin, hyperforin, quercetin, myricetin, flavonoids and other water-soluble plant metabolites.",
        "contraindications": "Contraindicated in TB, toxoplasmosis, irregular bleeding due to hormonal disorders and in menopause."
      },
      "silexil": {
        "name": "Silexil",
        "description": "Mineral complex for joint and connective tissue health support based on marine complexes",
        "mechanism": "Mineral complex containing silicon and other minerals supporting connective tissue and joint structure. Product for arthrosis of all localizations.",
        "production": "Mineral complex with trace elements important for collagen synthesis and connective tissue health.",
        "substances": "Contains silicon compounds, marine minerals, trace elements and collagen precursors."
      }
