#!/bin/sh
# =============================================================================
# Pre-commit hook — rychle kontroly (<30s)
# =============================================================================
# Skip: HUSKY=0 git commit ...
# nebo:  git commit --no-verify
# =============================================================================

# Ensure Node.js from .nvmrc (shell default may be a stale system version)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
nvm use >/dev/null 2>&1 || true

echo "Pre-commit: rychle kontroly..."

# 0. Explicitní přidávání souborů — žádné nové soubory bez potvrzení
#    Blokuje accidentální commit debug souborů, generátů apod.
#    Override: ALLOW_NEW_FILES=1 git commit ...
NEW_FILES=$(git diff --cached --name-status --diff-filter=A | awk '{print $2}')
if [ -n "$NEW_FILES" ] && [ "$ALLOW_NEW_FILES" != "1" ]; then
  echo ""
  echo "⚠️  NOVÉ SOUBORY detekovány ve staging area:"
  echo "$NEW_FILES" | while read -r f; do echo "    + $f"; done
  echo ""
  echo "  Pravidlo: Nové soubory musí být přidány EXPLICITNĚ (git add <file>),"
  echo "  ne hromadně (git add . / git add -A)."
  echo ""
  echo "  Pokud jsou tyto soubory zamýšlené, potvrď:"
  echo "    ALLOW_NEW_FILES=1 git commit -m \"...\""
  echo ""
  echo "FAIL Nepotvrzené nové soubory — viz výše"
  exit 1
fi

# 1. TypeScript
echo "  > TypeScript..."
npx tsc --noEmit -p tsconfig.app.json || {
  echo "FAIL TypeScript chyby — oprav pred commitem"
  exit 1
}

# 2. ESLint
echo "  > ESLint..."
npm run lint || {
  echo "FAIL ESLint chyby — oprav pred commitem"
  exit 1
}

# 3. i18n segmenty
echo "  > i18n segmenty..."
npm run i18n:segments:check 2>/dev/null || {
  echo "FAIL i18n chyby — oprav pred commitem"
  exit 1
}

# 3b. i18n parita instance overlayů — KAŽDÝ t('app.*') použitý v shellu musí
# existovat v KAŽDÉ locale KAŽDÉHO overlaye. Jiná kontrola než segmenty výše:
# ta řeší segmenty aplikace, tahle klíče povrchů. Pravidlo přišlo z CI
# rozpuštěného aisha-multi-surface repa a při rozpuštění se ztratilo — chyběl
# rok, během kterého mohl klíč zmizet a nikdo by se to nedozvěděl.
echo "  > i18n parita overlayů..."
npm run check:i18n || {
  echo "FAIL i18n parita — chybejici/driftujici klice, oprav pred commitem"
  exit 1
}

# 3c. Split-rule — generický kanál nesmí pojmenovat instanci. Ze stejného
# ztraceného CI jako 3b, a stejný důvod ji mít i tady: 0,6 s, a chytá to
# v okamžiku, kdy to vzniká. Identifikátory se odvozují z instances/.
echo "  > split-rule (instance v generickém kódu)..."
npm run gate || {
  echo "FAIL Instance literal v generickem kanalu — viz vypis vyse"
  exit 1
}

# 4. Legacy prefix guard (compose)
echo "  > compose legacy guard..."
bash scripts/verify-no-evymo.sh || {
  echo "FAIL Legacy _evymo_ hodnoty nalezeny v compose"
  exit 1
}

# 4b. Developer / account codes guard (staged)
#     No Apple Team ID / App Store Connect key id / personal account email /
#     real AuthKey_<id>.p8 in committed files — pull them from env instead.
echo "  > dev-codes guard..."
node scripts/verify-no-dev-codes.mjs --staged || {
  echo "FAIL Developer/account kódy ve staged souborech — viz výše (tahej z env)"
  exit 1
}

# 5. Auto-publish stale-publish guard
#    Catches packages/<pkg>/src/** changes without packages/<pkg>/package.json
#    version bump — without this, the auto-publish workflow runs but no-ops on
#    version match, leaving Verdaccio stale (the PR #73 failure mode).
#    Override (rare, document why): ALLOW_STALE_PACKAGE_VERSION=1 git commit ...
echo "  > stale-publish guard..."
node scripts/aisha-packages-version-check.mjs || {
  echo "FAIL Stale-publish guard — see above"
  exit 1
}

echo "OK Pre-commit: vse OK"
