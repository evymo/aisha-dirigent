# ============================================
# AISHA GATEWAY (backend API)
# ============================================
# Default = local stack gateway (scripts/local-warmup.sh → :3001); overridable
# at runtime in Settings. iOS simulator reaches the host as localhost, the
# Android emulator as 10.0.2.2. For your deployed AISHA use https://<api-domain>.
# Canonical var names; the legacy EXPO_PUBLIC_AISHA_POSTGREST_* names are
# still read as a fallback by config/api.ts + the build scripts.
EXPO_PUBLIC_AISHA_GATEWAY_URL=http://localhost:3001
EXPO_PUBLIC_AISHA_GATEWAY_ANON_KEY=your_anon_key_here

# ============================================
# OAUTH & DEEP LINKING
# ============================================
EXPO_PUBLIC_REDIRECT_URL=aisha-dirigent://oauth-callback

# ============================================
# LIVEKIT (video consultation calls)
# ============================================
# Media-server WebSocket URL (e.g. wss://livekit.<your-domain>). Required by
# useConsultationCall to join a real Room; the hook fails loud when unset.
# EXPO_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# ============================================
# FIREBASE (FCM Push Notifications)
# ============================================
# google-services.json (Android) and GoogleService-Info.plist (iOS)
# must be placed in the project root
# Your Firebase project's sender ID (Firebase console → Project settings → Cloud Messaging)
EXPO_PUBLIC_FCM_SENDER_ID=

# ============================================
# SENTRY (Error Tracking — self-hosted)
# ============================================
# EXPO_PUBLIC_SENTRY_DSN=http://key@localhost:9000/project-id
# EXPO_PUBLIC_SENTRY_IOS_DSN=http://key@localhost:9000/ios-project-id
# EXPO_PUBLIC_SENTRY_ANDROID_DSN=http://key@localhost:9000/android-project-id
# EXPO_PUBLIC_SENTRY_ENV=development
# SENTRY_AUTH_TOKEN=sntrys_...

# ============================================
# APP INTEGRITY
# ============================================
# EXPO_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=<your-gcp-project-number>

# ============================================
# DEPLOYED AISHA (your own instance)
# ============================================
# EXPO_PUBLIC_AISHA_GATEWAY_URL=https://api.<your-domain>
# EXPO_PUBLIC_AISHA_GATEWAY_ANON_KEY=your-anon-key

# ============================================
# COSMOS (AISHA App-Chain)
# ============================================
# RPC endpoint for CosmJS signing client (mobile wallet)
EXPO_PUBLIC_COSMOS_RPC=http://localhost:26657
# REST API for proposal queries
EXPO_PUBLIC_COSMOS_API=http://localhost:1317
# Chain ID
EXPO_PUBLIC_COSMOS_CHAIN_ID=aisha-1
