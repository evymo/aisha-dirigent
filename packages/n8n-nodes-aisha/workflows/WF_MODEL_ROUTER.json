    {
      "parameters": {
        "jsCode": "// Extract routing parameters from incoming webhook\nconst input = $input.first().json;\nconst task = input.body?.task || input.task || '';\nconst context = input.body?.context || input.context || '';\nconst provider = input.body?.provider || input.provider || 'auto';\nconst model = input.body?.model || input.model || '';\nconst systemPrompt = input.body?.system_prompt || input.system_prompt || '';\nconst maxTokens = input.body?.max_tokens || input.max_tokens || 4096;\nconst temperature = input.body?.temperature ?? input.temperature ?? 0.4;\nconst jsonMode = input.body?.json_mode || input.json_mode || false;\n\n// Auto-resolve provider from model string if not explicit\nlet resolvedProvider = provider;\nif (provider === 'auto' && model) {\n  if (model.startsWith('gemini')) resolvedProvider = 'google';\n  else if (model.startsWith('claude')) resolvedProvider = 'anthropic';\n  else resolvedProvider = 'openai';\n}\n\n// Default model per provider\nlet resolvedModel = model;\nif (!resolvedModel) {\n  switch (resolvedProvider) {\n    case 'google': resolvedModel = 'gemini-2.5-flash'; break;\n    case 'anthropic': resolvedModel = 'claude-3-5-sonnet-20241022'; break;\n    default: resolvedModel = 'gpt-4o'; break;\n  }\n}\n\nreturn [{\n  json: {\n    task,\n    context,\n    provider: resolvedProvider,\n    model: resolvedModel,\n    systemPrompt,\n    maxTokens,\n    temperature,\n    jsonMode,\n    routedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "prepare-input",
      "name": "Prepare & Route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
