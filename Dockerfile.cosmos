# Dockerfile.cosmos
#
# AISHA Cosmos App-Chain Node
#
# Uses official Cosmos SDK simapp binary which includes all standard modules:
# - x/bank, x/gov, x/staking, x/auth, x/mint, x/evidence, x/feegrant
#
# Architecture: Single-validator setup for private app-chain.
# NOT a public chain — serves as immutable audit ledger for governance & AISHA tokens.
#
# Build: docker build -f Dockerfile.cosmos -t aisha-cosmos-node .

ARG REGISTRY_PROXY=
FROM ghcr.io/cosmos/simapp:v0.54 AS base

# ── Runtime ──────────────────────────────────────────────────
FROM ${REGISTRY_PROXY}library/alpine:3.20

RUN apk add --no-cache ca-certificates curl jq bash

# Copy simapp binary and rename to aishad for consistency
COPY --from=base /usr/bin/simd /usr/local/bin/aishad

# Genesis and config templates
COPY cosmos/config/ /cosmos-config/
COPY cosmos/scripts/init-node.sh /init-node.sh
RUN chmod +x /init-node.sh

EXPOSE 26656 26657 1317 9090

VOLUME ["/root/.aisha"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
  CMD curl -fsS http://localhost:26657/health || exit 1

ENTRYPOINT ["/init-node.sh"]
