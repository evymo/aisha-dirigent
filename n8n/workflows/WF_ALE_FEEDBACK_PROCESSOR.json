{
  "name": "WF_ALE_FEEDBACK_PROCESSOR",
  "nodes": [
    {
      "parameters": {
        "authentication": "headerAuth",
        "path": "ale-feedback-process",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REMAP__",
          "name": "AISHA Webhook Auth"
        }
      },
      "id": "ale-webhook-001",
      "name": "Feedback Ready Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json.body || $input.first().json;\nconst minBatchSize = Number(input.min_batch_size || 3);\nconst minRating = Number(input.min_rating || 4);\nconst limit = Number(input.limit || 50);\nconst pendingCount = Number(input.pending_count || 0);\nconst hasCorrection = Boolean(input.has_correction);\nconst force = Boolean(input.force);\nconst shouldProcess = force || hasCorrection || pendingCount >= minBatchSize;\n\nreturn [{\n  json: {\n    feedbackId: input.feedback_id || null,\n    orgId: input.org_id || null,\n    storyId: input.story_id || null,\n    runId: input.run_id || null,\n    rating: input.rating ?? null,\n    domainTags: Array.isArray(input.domain_tags) ? input.domain_tags : [],\n    hasCorrection,\n    pendingCount,\n    minBatchSize,\n    minRating,\n    limit,\n    force,\n    shouldProcess,\n    source: input.source || 'webhook',\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "ale-parse-002",
      "name": "Parse Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.shouldProcess }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "ale-if-003",
      "name": "Should Process Now?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.AISHA_POSTGREST_URL || 'http://127.0.0.1:57421') + '/rest/v1/rpc/ensure_feedback_training_dataset' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_org_id: $json.orgId, p_story_id: $json.storyId, p_domain_tags: $json.domainTags, p_name: null }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "ale-ensure-004",
      "name": "Ensure Dataset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REMAP__",
          "name": "AISHA Gateway (Service Role)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.AISHA_POSTGREST_URL || 'http://127.0.0.1:57421') + '/rest/v1/rpc/process_feedback_to_training' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_dataset_id: $('Ensure Dataset').item.json.dataset_id, p_org_id: $('Parse Payload').item.json.orgId, p_limit: $('Parse Payload').item.json.limit, p_min_rating: $('Parse Payload').item.json.minRating }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "ale-process-005",
      "name": "Process Feedback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REMAP__",
          "name": "AISHA Gateway (Service Role)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const parsed = $('Parse Payload').item.json;\nconst dataset = $('Ensure Dataset').item.json;\nconst result = $input.first().json;\n\nreturn [{\n  json: {\n    success: true,\n    processed: true,\n    source: parsed.source,\n    org_id: parsed.orgId,\n    story_id: parsed.storyId,\n    feedback_id: parsed.feedbackId,\n    pending_count: parsed.pendingCount,\n    dataset_id: dataset.dataset_id,\n    dataset_created: dataset.created,\n    result,\n    completedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "ale-success-006",
      "name": "Build Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.AISHA_POSTGREST_URL || 'http://127.0.0.1:57421') + '/rest/v1/rpc/log_n8n_trace_event' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_event_type: 'n8n_workflow', p_run_kind: 'doc_update', p_agent_slug: 'ale-feedback-processor', p_operation: 'process_feedback_to_training', p_status: 'ok', p_request_summary: { feedback_id: $json.feedback_id, org_id: $json.org_id, story_id: $json.story_id, pending_count: $json.pending_count }, p_response_summary: { dataset_id: $json.dataset_id, dataset_created: $json.dataset_created, total_processed: $json.result?.total_processed || 0, dpo_pairs: $json.result?.dpo_pairs || 0, sft_pairs: $json.result?.sft_pairs || 0 } }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "ale-log-007",
      "name": "Log Trace",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REMAP__",
          "name": "AISHA Gateway (Service Role)"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Build Success Response').item.json) }}",
        "options": {}
      },
      "id": "ale-respond-008",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1780,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { success: true, processed: false, reason: 'batch_threshold_not_met', feedback_id: $json.feedbackId, org_id: $json.orgId, story_id: $json.storyId, pending_count: $json.pendingCount, min_batch_size: $json.minBatchSize, has_correction: $json.hasCorrection } }];"
      },
      "id": "ale-skip-009",
      "name": "Build Skip Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        160
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "ale-respond-skip-010",
      "name": "Respond Skip",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1120,
        160
      ]
    }
  ],
  "connections": {
    "Feedback Ready Webhook": {
      "main": [
        [
          {
            "node": "Parse Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Payload": {
      "main": [
        [
          {
            "node": "Should Process Now?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Process Now?": {
      "main": [
        [
          {
            "node": "Ensure Dataset",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Build Skip Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ensure Dataset": {
      "main": [
        [
          {
            "node": "Process Feedback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Feedback": {
      "main": [
        [
          {
            "node": "Build Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Success Response": {
      "main": [
        [
          {
            "node": "Log Trace",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Skip Response": {
      "main": [
        [
          {
            "node": "Respond Skip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Trace": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "timezone": "Europe/Prague",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  }
}
