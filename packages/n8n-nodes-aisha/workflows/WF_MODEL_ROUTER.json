        "jsCode": "// Format the agent response into a standardized output\nconst agentOutput = $input.first().json;\nconst routeData = $('Prepare & Route').first().json;\n\nconst output = agentOutput?.output || agentOutput?.text || JSON.stringify(agentOutput);\n\nreturn [{\n  json: {\n    success: true,\n    provider: routeData.provider,\n    model: routeData.model,\n    response: output,\n    metadata: {\n      routed_at: routeData.routedAt,\n      completed_at: new Date().toISOString(),\n      task_preview: routeData.task.substring(0, 100)\n    }\n  }\n}];"
