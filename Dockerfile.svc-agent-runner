# syntax=docker/dockerfile:1
# Dockerfile.svc-agent-runner — isolated execution plane service (port 3030)
# Standalone Dockerfile (build CONTEXT = REPO ROOT) — avoids Coolify's ARG explosion.
#
# Registry-free workspace build. @aisha/* are monorepo WORKSPACE packages
# (packages/*), resolved via npm workspace symlinks and built from source — NO
# Verdaccio, NO VERDACCIO_TOKEN, NO .npmrc. Internal code never round-trips a
# registry, so cold-start rebuilds are deterministic and no npm auth token ever
# enters the build.
#
# NOTE: At runtime, the container needs:
#   - /var/run/docker.sock mounted (Docker backend) OR KATA_GRPC_ENDPOINT set
#   - Env vars: POSTGREST_URL, POSTGREST_SERVICE_TOKEN, KEYCLOAK_URL, KEYCLOAK_REALM,
#               BROKER_TOKEN_SECRET, RUNNER_BACKEND (docker|kata)
ARG REGISTRY_PROXY=
FROM ${REGISTRY_PROXY}library/node:22-alpine AS build
WORKDIR /app
# Whole repo so npm resolves the full workspace graph + symlinks @aisha/*.
COPY . .
RUN npm ci --workspace=@aisha/svc-agent-runner --include-workspace-root --include=dev --ignore-scripts
RUN npm run build --workspace=@aisha/security && \
    npm run build --workspace=@aisha/svc-agent-runner
# Prod-only deps via a CLEAN reinstall (NOT `npm prune` — the workspace prune has
# evicted hoisted prod deps on deep trees). packages/*/dist built above survive
# the node_modules wipe; `npm ci` recreates the @aisha/* workspace symlinks.
RUN rm -rf node_modules services/svc-agent-runner/node_modules \
 && npm ci --workspace=@aisha/svc-agent-runner --omit=dev --ignore-scripts
# Guarantee the service's own node_modules dir exists so the runtime COPY never fails.
RUN mkdir -p services/svc-agent-runner/node_modules
# Fail LOUD: every declared prod dep must resolve in the image, or the BUILD breaks
# here instead of crash-looping in prod. Generic guard, no hardcoded names.
RUN node scripts/verify-runtime-deps.mjs services/svc-agent-runner

FROM ${REGISTRY_PROXY}library/node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
# git: per-run worktree lifecycle for claude_cli_task runs (Component 4 E4).
RUN apk add --no-cache git
# Root-hoisted node_modules + the workspace package dir required by the symlinked
# @aisha/security dependency (its target must travel, else ERR_MODULE_NOT_FOUND).
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/packages/security packages/security
COPY --from=build /app/services/svc-agent-runner/package.json services/svc-agent-runner/package.json
COPY --from=build /app/services/svc-agent-runner/dist services/svc-agent-runner/dist
# Nested (non-hoisted) service deps must travel too.
COPY --from=build /app/services/svc-agent-runner/node_modules services/svc-agent-runner/node_modules
WORKDIR /app/services/svc-agent-runner
EXPOSE 3030
# Mesh routu staví entrypoint v compose JAKO ROOT a práva hned zahodí přes
# `exec su-exec node …` (vzor: gateway, brána mesh-lane-miri-jmenem-ne-hopem).
# ⛔ NAMĚŘENO 2026-09-16 na guru: s `USER node` v obrazu služba routu postavit
# nemohla, mesh jméno se přeložilo a NESPOJILO — svc-ai-chat vypršel na PostgREST,
# MCP, lokálním modelu, companion i integration, a nic to nehlásilo jako chybu.
RUN apk add --no-cache su-exec iproute2
CMD ["node", "dist/server.js"]
