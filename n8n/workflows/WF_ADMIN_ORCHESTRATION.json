      "parameters": {
        "jsCode": "// Validate and route incoming admin bridge request\nconst body = $input.item.json.body || {};\nconst { service, operation, params } = body;\n\nif (!service || !operation) {\n  return [{\n    json: {\n      error: true,\n      message: 'Missing required fields: service, operation',\n      validServices: ['nocodb', 'langfuse', 'health'],\n      example: { service: 'nocodb', operation: 'list_tables', params: {} }\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    service,\n    operation,\n    params: params || {},\n    requestedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "validate-request",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        304
      ]
    },
