{
  "name": "WF_APPSMITH_DASHBOARD_BUILDER",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        260
      ]
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "httpMethod": "POST",
        "path": "appsmith-rebuild",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REMAP__",
          "name": "AISHA Webhook Auth"
        }
      },
      "id": "webhook-trigger",
      "name": "Manual Rebuild Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "// Determine trigger source + force flag\nconst input = $input.first().json;\nconst isWebhook = !!input.body || !!input.params;\nconst force = isWebhook && (input.query?.force === 'true' || input.body?.force === true);\nreturn [{\n  json: {\n    triggered_by: isWebhook ? 'manual_webhook' : 'cron_30min',\n    force,\n    started_at: new Date().toISOString(),\n  },\n}];"
      },
      "id": "init-context",
      "name": "Init Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        340
      ]
    },
    {
      "parameters": {
        "command": "={{ 'node /workspace/scripts/build-aisha-appsmith.mjs --json' + ($json.force ? ' --force' : '') }}",
        "options": {}
      },
      "id": "run-builder",
      "name": "Run Builder Script",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        660,
        340
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Parse builder output\nconst raw = $input.first().json.stdout || $input.first().json;\nlet result;\ntry {\n  result = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  return [{ json: { parse_error: true, error: e.message, raw: String(raw).slice(0, 500) } }];\n}\nreturn [{ json: result }];"
      },
      "id": "parse-result",
      "name": "Parse Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        340
      ]
    },
    {
      "parameters": {
        "category": "custom",
        "functionName": "log_integration_action",
        "rpcParams": "={{ JSON.stringify({ p_service_name: 'appsmith', p_action: 'dashboard_rebuild_' + ($json.status || 'unknown'), p_action_detail: { hash: $json.hash, duration_ms: $json.duration_ms, triggered_by: $('Init Context').item.json.triggered_by, status: $json.status, error: $json.error }, p_status: ($json.status === 'published' || $json.status === 'skipped' || $json.status === 'dry_run') ? 'success' : 'failure', p_duration_ms: $json.duration_ms || 0 }) }}",
        "authMode": "service_role",
        "options": {
          "timeout": 5000,
          "auditTrail": true
        },
        "onError": "continueRegularOutput"
      },
      "id": "log-completion",
      "name": "Log Completion",
      "type": "n8n-nodes-aisha.aishaRpc",
      "typeVersion": 1,
      "position": [
        1100,
        340
      ],
      "credentials": {
        "aishaPostgrestApi": {
          "id": "__REMAP__",
          "name": "AISHA PostgREST"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"{{ $('Parse Result').item.json.status }}\", \"hash\": \"{{ $('Parse Result').item.json.hash }}\", \"duration_ms\": {{ $('Parse Result').item.json.duration_ms || 0 }}, \"triggered_by\": \"{{ $('Init Context').item.json.triggered_by }}\" }",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1320,
        340
      ]
    }
  ],
  "connections": {
    "Every 30 Minutes": {
      "main": [
        [
          {
            "node": "Init Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Rebuild Webhook": {
      "main": [
        [
          {
            "node": "Init Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Init Context": {
      "main": [
        [
          {
            "node": "Run Builder Script",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Builder Script": {
      "main": [
        [
          {
            "node": "Parse Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Result": {
      "main": [
        [
          {
            "node": "Log Completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Completion": {
      "main": [
        [
          {
            "node": "Respond Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "timezone": "Europe/Prague",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  }
}
