+    /**
+     * Commands that write a base64 payload to a file, in chunks.
+     *
+     * Linux caps a SINGLE argv entry at MAX_ARG_STRLEN (128 KiB), and Coolify ships
+     * file contents as `echo '<base64>' | base64 -d`, i.e. one argument. Anything
+     * whose size scales with the number of environment variables eventually crosses
+     * that line and the deployment dies before it starts. Measured 2026-08-16:
+     * aisha-core produced a 133394 B compose argument and a 162136 B Dockerfile
+     * argument; aisha-registry projects to 103189 B for its .env alone.
+     *
+     * Single quoting needs no escaping here: the base64 alphabet is A-Za-z0-9+/=
+     * and can never contain a quote.
+     */
+    private function base64WriteCommands(string $base64, string $path, ?string $inDockerUuid = null): array
+    {
+        $tmp = $path.'.b64';
+        $commands = [];
+        foreach (str_split($base64, 24000) as $index => $chunk) {
+            $redirect = $index === 0 ? '>' : '>>';
+            $command = "printf '%s' '{$chunk}' {$redirect} {$tmp}";
+            $commands[] = $inDockerUuid ? executeInDocker($inDockerUuid, $command) : $command;
+        }
+        $command = "base64 -d {$tmp} > {$path} && rm -f {$tmp}";
+        $commands[] = $inDockerUuid ? executeInDocker($inDockerUuid, $command) : $command;
+
+        return $commands;
+    }
