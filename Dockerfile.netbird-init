# Dockerfile.netbird-init — Init container for NetBird management.json
# Bakes management.json template + envsubst from repo into image.
# Avoids Coolify bind-mount trap (file bind on remote may resolve to dir).
ARG REGISTRY_PROXY=
FROM ${REGISTRY_PROXY}library/alpine:3.20
RUN apk add --no-cache gettext
# Instance stacku (config/netbird-instances.json) si vybírá svou šablonu; výchozí = hlavní řídicí rovina.
ARG NETBIRD_MGMT_SABLONA=coolify/netbird-management.json.template
COPY ${NETBIRD_MGMT_SABLONA} /staging/management.json.template
