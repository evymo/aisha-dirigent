<%
// Eta template: claude-code/instructions.eta — Phase 13 WP 13.2
// Receives: it = WorkspaceContextEnvelope (Zod-validated upstream)
// Output:   text/markdown — CLAUDE.md content with safe-write delimiters
//
// Local helpers (kept inside the template — Eta runs in isolated scope per
// render so no leakage across requests).
function bullet(items, fn, empty) {
  if (!items || items.length === 0) return empty;
  return items.map(fn).join("\n");
}
function renderStory(s) {
  const badge = s.is_stack_default ? " [STACK DEFAULT]" : "";
  const branch = s.default_branch ? " (branch: " + s.default_branch + ")" : "";
  const status = s.status || "unknown";
  const delivery = s.delivery_status ? "/" + s.delivery_status : "";
  return "- **" + s.title + "** — `" + s.id + "` — status: `" + status + delivery + "`" + branch + badge;
}
function renderRun(r) {
  return "- `" + (r.current_agent_slug || r.kind) + "` on story `" + (r.story_id || "(none)") + "` — kind: `" + r.kind + "`, started: " + r.started_at;
}
function renderApproval(a) {
  return "- **" + a.story_title + "** (`" + a.story_id + "`) — delivery_status: `" + (a.delivery_status || "unknown") + "`";
}
function renderAudit(a) {
  const sev = a.severity || "info";
  const area = a.area || "general";
  const sum = a.summary ? " — " + a.summary : "";
  return "- `" + sev + "/" + area + "` `" + a.action + "` at " + a.created_at + sum;
}
function renderDeploy(d) {
  return "- **" + d.app_name + "** — active: `" + d.active_slot + "`, last switch: " + (d.last_switch_at || "(never)") + ", health: blue=`" + d.blue_health + "` green=`" + d.green_health + "`";
}
%># CLAUDE.md — AISHA Platform (dynamic)

> Auto-generated by svc-ide-context at <%= it.generated_at %>.
> Workspace: `<%= it.workspace_id || "(unset)" %>`. User: `<%= it.user_id %>` (<%= it.is_privileged ? "admin/staff" : "user" %>).
> AISHA-managed block below is rewritten on every sync. **DO NOT edit between delimiters.**

<!-- AISHA-MANAGED-START -->

## Current workspace state

### Active stories
<%~ bullet(it.stories, renderStory, "- No active stories yet.") %>

### Running agent runs
<%~ bullet(it.active_runs, renderRun, "_No agent runs currently in flight._") %>

### Pending approvals
<% if (!it.pending_approvals || it.pending_approvals.length === 0) { %>_No pending approvals._<% } else { %>⚠ Pending approvals — respect approval gate before related work:
<%~ it.pending_approvals.map(renderApproval).join("\n") %><% } %>

### Recent audit entries (your scope)
<%~ bullet((it.recent_audit || []).slice(0, 10), renderAudit, "_No recent audit entries._") %>

### Deploy state (blue/green slots)
<%~ bullet(it.deploy_state, renderDeploy, "_No deploy state visible._") %>

<!-- AISHA-MANAGED-END -->

<!-- USER-CUSTOM-START -->

<!-- Anything you put here is preserved across AISHA syncs. -->

<!-- USER-CUSTOM-END -->
