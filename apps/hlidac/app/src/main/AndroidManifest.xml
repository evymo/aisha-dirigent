<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Síť JEN kvůli přímé aktualizaci appek (Aktualizace.java): balíček se
         stáhne, ověří otisk a nainstaluje. Hlídač sám nic nevysílá. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+: bez tohohle hlídač kioskovou aplikaci ani Obchod Play „nevidí“. -->
    <queries>
        <package android:name="${kioskPackage}" />
        <!-- Obchod Play: Kiosk Admin ho v kiosku SKRÝVÁ (Play Protect, 2026-09-28) a musí poznat, jestli na tabletu je. -->
        <package android:name="com.android.vending" />
        <!-- Systémový fotoaparát — kiosková aplikace přes něj fotí evidenci. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- Domovská obrazovka: po startu a po pádu kioskové aplikace se vrací sem. -->
        <activity
            android:name=".DomovActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Android 12+: provisioning se zeptá na režim; bez téhle aktivity QR skončí chybou. -->
        <activity
            android:name=".ProvisioningModeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PolicyComplianceActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".SpravceReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver android:name=".StartReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Noční okno pro aktualizace; budík si hlídač plánuje sám. -->
        <receiver android:name=".OknoReceiver" android:exported="false" />
            <receiver android:name=".VysledekInstalace" android:exported="false" />
    </application>
</manifest>
