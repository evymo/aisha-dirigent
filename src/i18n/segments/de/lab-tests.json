    "products": {
      "retisin": {
        "name": "Retisin",
        "description": "Unterstützung der Zellenergie und Geweberegeneration auf Basis von ATP-Vorläufern",
        "mechanism": "Unterstützt den aeroben Stoffwechsel durch die Bereitstellung von ATP – dem Energiemediator. Durch die Zufuhr von Produkten des aeroben Stoffwechsels, die sonst durch Glukoseoxidation entstehen würden, fühlen sich Anwender dank der Energie in Form von Nukleotiden besser. Es erhöht zunächst das Hämoglobin, dann die roten Blutkörperchen und unterstützt die Regenerationsfähigkeit des Gewebes.",
        "production": "Hergestellt aus Rinderblutpigment, das unmittelbar nach der Entnahme ohne Zusatz von Citraten verarbeitet und getrocknet wird. Das getrocknete Blutpigment wird anschließend durch schonende Extraktion mit Alkohol verarbeitet. Aus einem Liter frischem Blut gewinnen wir etwa 12 g Wirkstoffe.",
        "substances": "Enthält Adenosinmonophosphat (AMP), Cytidinmonophosphat (CMP), Inosinmonophosphat (IMP), Guanosinmonophosphat (GMP), Uridinmonophosphat (UMP), freie Aminosäuren und Defensine mit antimikrobieller Wirkung."
      },
      "lyastin": {
        "name": "Lyastin",
        "description": "Unterstützung der Mikrozirkulation und Gewebeversorgung auf Basis von Phospholipiden und Zellmembranfragmenten",
        "mechanism": "Wirkt gefäßerweiternd, indem es arteriosklerotische Cholesterinablagerungen reduziert. Es stimuliert oxidative Prozesse im Gewebe und verbessert die gestörte Trophik ischämischen Gewebes. Es hat die Fähigkeit, das Verhältnis von n-3- und n-6-Fettsäuren auszugleichen (das gesunde Verhältnis beträgt 1:5, heute liegt es aufgrund unterschiedlicher Ernährungsgewohnheiten eher bei 1:20).",
        "production": "Lipidextrakt, der Glycerophospholipide und Sphingomyeline enthält. Diese Substanzen bilden Zell- und Organellenmembranen. Ausreichende Phospholipide sind für eine ordnungsgemäße Funktion des Nervensystems unerlässlich.",
        "substances": "Enthält Glycerophospholipide, Sphingomyeline, Phosphatidylcholine, Phosphoethanolamine, Triacylglyceride, Sterole und Lysophospholipide."
      },
      "floristen": {
        "name": "Floristen",
        "description": "Pflanzliches Präparat zur Unterstützung der Entzündungshemmung aus Johanniskraut",
        "mechanism": "Enthält hauptsächlich Hypericin (antivirale Wirkung), Hyperforin (antimikrobielle, entzündungshemmende und antidepressive Wirkung) sowie Flavonoide wie Quercetin und Myricetin mit antioxidativen Eigenschaften. Gereinigter Extrakt, der nur wasserlösliche Substanzen enthält.",
        "production": "Hergestellt aus dem oberen Teil des Johanniskrauts (Hypericum perforatum), das nach leichtem Welken auf eine Größe von etwa 3 cm zerkleinert und getrocknet wird. Die Produktion erfolgt ausschließlich aus Johanniskraut, das auf registrierten Landparzellen aus ökologischem Anbau gewonnen wird.",
        "substances": "Enthält Hypericin, Hyperforin, Quercetin, Myricetin, Flavonoide und andere wasserlösliche Pflanzenmetaboliten.",
        "contraindications": "Kontraindiziert bei Tuberkulose, Toxoplasmose, unregelmäßigen Blutungen aufgrund hormoneller Störungen und in den Wechseljahren."
      },
      "silexil": {
        "name": "Silexil",
        "description": "Mineralkomplex zur Unterstützung der Gesundheit von Gelenken und Bindegewebe auf Basis mariner Komplexe",
        "mechanism": "Mineralkomplex mit Silizium und anderen Mineralien zur Unterstützung des Bindegewebes und der Gelenkstruktur. Ergänzungsmittel bei Arthrose aller Lokalisationen.",
        "production": "Mineralstoffkomplex mit Spurenelementen, die für die Kollagensynthese und die Gesundheit des Bindegewebes wichtig sind.",
        "substances": "Enthält Siliziumverbindungen, Meeresmineralien, Spurenelemente und Kollagenvorläufer."
      }
    },
