# Client-side (public) AISHA backend config (Vite)
# NOTE: Do NOT commit real values to .env. Copy this file to .env locally.
#
# AISHA self-hosted stack uses Postgres17 + PostgREST + Fastify gateway,
# fronted by Keycloak (OIDC). Set these for the gateway endpoint.
VITE_API_URL=
VITE_GATEWAY_URL=

# Legacy aliases — DEPRECATED, kept for src/ compat during rename refactor.
# New code should read VITE_API_URL / VITE_GATEWAY_URL above.
VITE_AISHA_POSTGREST_URL=
VITE_AISHA_POSTGREST_PUBLISHABLE_KEY=
# Backward compatible (if publishable key not set)
VITE_AISHA_POSTGREST_ANON_KEY=

# Public VAPID key for browser Web Push subscription
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=

# LiveKit media-server WebSocket URL for video consultation calls
# (e.g. wss://livekit.<your-domain>). Required by useConsultationCall to join
# a real Room; the hook fails loud when unset (no default server).
VITE_LIVEKIT_URL=

# PDF.js assets:
# - auto (default): local first, then CDN fallback when local assets are unreachable
# - local: force bundled assets under /pdfjs/
# - cdn: force jsDelivr hosted assets matching the installed pdfjs-dist version
# VITE_PDFJS_ASSETS_MODE=auto
# Legacy toggle (still supported):
# VITE_PDFJS_USE_CDN=true
# Runtime override for quick debugging:
# /archive/<slug>?pdfjsAssets=cdn

# ============================================================================
# API SECRETS - Required for E2E tests (seeded into app_secrets via npm run db:seed:secrets:local)
# In production, set these via Admin UI using set_api_key_admin() RPC
# ============================================================================

# OpenAI (for AI analysis features — primary LLM provider)
OPENAI_API_KEY=

# Google AI / Gemini (multi-model routing — secondary provider)
GOOGLE_AI_API_KEY=

# Anthropic / Claude (multi-model routing — tertiary provider)
ANTHROPIC_API_KEY=

# xAI / Grok (multi-model routing — disabled, pending benchmark evaluation)
XAI_API_KEY=

# Stripe (test mode for E2E)
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_CARD_NO=4242424242424242

# Packeta/Zásilkovna (for delivery integration)
PACKETA_API_KEY=
PACKETA_API_PASSWORD=
PACKETA_SENDER_ID=platform

# DeepL (for translations)
DEEPL_API_KEY=

# ── n8n Workflow Engine (Dirigent Governor) ────────────────────────────────
# Production n8n public webhook URL (edge proxy)
N8N_WEBHOOK_URL=https://mcp.aisha.guru
# Client-accessible n8n webhook URL (exposed to browser via Vite)
VITE_N8N_WEBHOOK_URL=https://mcp.aisha.guru
# n8n API key for authenticated calls (Settings → API → Create API Key)
N8N_API_KEY=

# ── MCP (Model Context Protocol) ──────────────────────────────────────────
# MCP authentication is Keycloak/OAuth based. CLI smoke/provisioning can use
# a short-lived Keycloak bearer via AISHA_ACCESS_TOKEN; VS Code signs in via AISHA ID.
AISHA_ACCESS_TOKEN=
# Webhook secret for GitHub → n8n webhook bridge (shared secret)
GITHUB_WEBHOOK_SECRET=

# Web Push (VAPID) for backend Edge Functions
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Example: mailto:ops@your-domain.tld
WEB_PUSH_VAPID_SUBJECT=

# Firebase Cloud Messaging (HTTP v1)
# Project ID example: aisha-dirigent
FCM_PROJECT_ID=
# Full JSON service account content (single line JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Cosmos App-Chain (AISHA) ────────────────────────────────
# Deployed on Experimental server. Edge functions connect via the aisha network.
COSMOS_CHAIN_ID=aisha-1
COSMOS_RPC_URL=http://cosmos-node:26657
COSMOS_REST_URL=http://cosmos-node:1317
# Backend signer: 24-word BIP39 mnemonic (SENSITIVE — never commit!)
COSMOS_SIGNER_MNEMONIC=
# Pre-computed bech32 address of the backend signer (cosmos1...)
COSMOS_SIGNER_ADDRESS=
# Public RPC endpoint for mobile wallet CosmJS connections
VITE_COSMOS_API=https://api.aisha.guru

# ─── External source federation (svc-source-broker) ──────────
# Generic source-broker config. A "source" is any external system of record
# (CRM, e-shop/orders, ERP, booking, community platform, …) onboarded via the
# Source Onboarding Contract. Set these per deployed source — NO source-specific
# values are committed here. All optional; the broker is dormant until set.
# Source API endpoint (GraphQL)
SOURCE_API_URL=
# Service-level machine user credentials (12-factor; NEVER in DB)
SOURCE_SERVICE_EMAIL=
SOURCE_SERVICE_PASSWORD=
# Source read-only PG connection — dedicated read-only role, GRANT EXECUTE on
# the source's exposed read functions only (NEVER raw table access).
SOURCE_PG_URL=
# Webhook HMAC shared secret — the source signs webhook payloads
SOURCE_WEBHOOK_HMAC_SECRET=
# Optional auth-handshake constants some sources require in their login mutation
# SOURCE_AUTH_HANDSHAKE_OUT=
# SOURCE_AUTH_HANDSHAKE_IN=
# JWT cache TTL (default 1h)
# SOURCE_JWT_CACHE_TTL_MS=3600000
# Sync schedule interval (default 24h)
# SOURCE_SYNC_INTERVAL_MS=86400000
