      "main": [
        [
          {
            "node": "Split Per Batch Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Per Batch Job": {
      "main": [
        [
          {
            "node": "Route By Provider",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route By Provider": {
      "main": [
        [
          {
            "node": "Fetch Anthropic Result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fetch OpenAI Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Anthropic Result": {
      "main": [
        [
          {
            "node": "Normalize Batch Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch OpenAI Result": {
      "main": [
        [
          {
            "node": "Normalize Batch Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Batch Result": {
      "main": [
        [
          {
            "node": "Persist Result + Flip Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Persist Result + Flip Status": {
      "main": [
        [
          {
            "node": "Resume Orchestrator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resume Orchestrator": {
      "main": [
        [
          {
            "node": "Audit Integration Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "pinData": {},
  "versionId": "",
  "triggerCount": 0,
  "tags": [
    {
      "name": "autopilot"
    },
    {
      "name": "batch"
    }
  ]
}
