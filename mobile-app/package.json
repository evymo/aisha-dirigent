{
  "name": "aisha-dirigent-mobile",
  "version": "1.0.0",
  "description": "AISHA Dirigent — Mobile Control Centre for project monitoring and AI-driven development",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint --no-config-lookup --config eslint.config.cjs .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "bash ./e2e/scripts/run-e2e.sh all",
    "test:e2e:smoke": "bash ./e2e/scripts/run-e2e.sh smoke",
    "test:e2e:auth": "bash ./e2e/scripts/run-e2e.sh auth",
    "postinstall": "patch-package",
    "prebuild:ios": "expo prebuild --platform ios --no-install && ./scripts/post-prebuild.sh && cd ios && pod install --repo-update",
    "prebuild:ios:clean": "expo prebuild --platform ios --clean --no-install && ./scripts/post-prebuild.sh && cd ios && pod install --repo-update",
    "prebuild:ios:prod": "source ./scripts/select-env.sh && expo prebuild --platform ios --no-install && ./scripts/post-prebuild.sh && cd ios && pod install --repo-update",
    "prepare:xcode:ios": "./scripts/prepare-xcode-build.sh",
    "prepare:xcode:ios:bump": "./scripts/prepare-xcode-build.sh --bump",
    "prebuild:android": "expo prebuild --platform android && ./scripts/post-prebuild-android.sh",
    "prebuild:android:clean": "expo prebuild --platform android --clean && ./scripts/post-prebuild-android.sh",
    "build:ios": "./scripts/build-ios.sh",
    "build:ios:clean": "./scripts/build-ios.sh --clean",
    "build:ios:upload": "./scripts/build-ios.sh --upload",
    "ios:dsyms": "./scripts/download-dsyms.sh",
    "build:android": "./scripts/build-android.sh --apk",
    "build:android:bundle": "./scripts/build-android.sh --bundle",
    "build:android:clean": "./scripts/build-android.sh --apk --clean",
    "version:patch": "./scripts/bump-version.sh patch",
    "version:minor": "./scripts/bump-version.sh minor",
    "version:major": "./scripts/bump-version.sh major",
    "version:build": "./scripts/bump-version.sh build",
    "release:ios": "./scripts/bump-version.sh build && npm run prebuild:ios:clean",
    "start:expo-go": "EXPO_GO_MOCKS=1 expo start",
    "start:expo-go:ios": "EXPO_GO_MOCKS=1 expo start --ios",
    "test:e2e:ridic": "bash ./e2e/scripts/run-e2e.sh ridic"
  },
  "dependencies": {
    "@aisha/extranet-sdk-native": "file:../packages/extranet-sdk/packages/native",
    "@aisha/extranet-sdk-tokens": "file:../packages/extranet-sdk/packages/tokens",
    "@aisha/knock-protocol": "file:../packages/knock-protocol",
    "@cosmjs/amino": "^0.38.1",
    "@cosmjs/crypto": "^0.38.1",
    "@cosmjs/encoding": "^0.38.1",
    "@cosmjs/proto-signing": "^0.38.1",
    "@cosmjs/stargate": "^0.38.1",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/app-integrity": "^0.1.10",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@livekit/react-native": "^2.11.1",
    "@livekit/react-native-webrtc": "^144.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "^23.8.4",
    "@react-native-firebase/messaging": "^23.8.4",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@sentry/react-native": "~7.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "@tanstack/react-query": "^5.28.0",
    "date-fns": "^4.1.0",
    "expo": "~54.0.36",
    "expo-auth-session": "~7.0.11",
    "expo-background-task": "^1.0.10",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "^1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "^14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "livekit-client": "^2.19.0",
    "lucide-react-native": "^1.7.0",
    "patch-package": "^8.0.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-udp": "^4.1.7",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "victory-native": "^41.20.2",
    "zod": "^4.3.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.16",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "license": "Elastic-2.0"
}
