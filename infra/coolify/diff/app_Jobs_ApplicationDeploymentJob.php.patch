+    /**
+     * Obrazy, které se PODLE DEKLARACE mají přenést.
+     *
+     * Coolify si do vyrenderovaného compose zapisuje ke KAŽDÉ službě s `build:`
+     * explicitní `image: <uuid>_<sluzba>:<commit>`. Tahle množina je tedy
+     * deklarace, ne pozorování — a právě proto se z ní smí měřit.
+     *
+     * Výjimka se NEODPOUŠTÍ: nečitelný compose znamená, že o očekávané množině
+     * nic nevíme, a tichá prázdná množina by vypnula obě kontroly níž.
+     */
+    private function images_declared_by_compose()
+    {
+        // ⛔ DVA KANÁLY TÉŽE HODNOTY, a každý buildpack plní JINÝ.
+        // `$this->docker_compose` plní jen `generate_compose_file()` (ne-compose
+        // buildpacky, ř. ~3880). Buildpack `dockercompose` — tedy TEN, na kterém
+        // přenos obrazů vůbec běží — plní v `deploy_docker_compose_buildpack()`
+        // (ř. ~735) POUZE `$this->docker_compose_base64`.
+        //
+        // ⭐ NAMĚŘENO 2026-09-06: první podoba testovala jen `$this->docker_compose`
+        // a shodila KAŽDÉ dockercompose nasazení všech instancí (12 výjimek
+        // „the rendered compose is empty" za tři hodiny). Ověřoval jsem PRAVIDLO
+        // proti compose souboru na disku, ne to, že ta property je naplněná NA
+        // TÉHLE cestě.
+        //
+        // Není to fallback pro nejistotu: obě property nesou TÝŽ dokument, jen
+        // jiným kanálem. Když nemá hodnotu ani jeden, pořád je to STOP.
+        $yaml = filled($this->docker_compose)
+            ? $this->docker_compose
+            : base64_decode((string) $this->docker_compose_base64);
+
+        if (blank($yaml)) {
+            throw new \RuntimeException('cannot determine which images to transfer: the rendered compose is empty');
+        }
+
+        $parsed = Yaml::parse($yaml);
+        $prefix = "{$this->application->uuid}_";
+
+        return collect(data_get($parsed, 'services', []))
+            ->filter(fn ($service) => filled(data_get($service, 'build')))
+            ->map(fn ($service) => data_get($service, 'image'))
+            ->filter(fn ($image) => is_string($image) && str_starts_with($image, $prefix))
+            ->values();
+    }
