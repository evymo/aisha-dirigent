# =============================================================================
# cold-start-timeouts.env — Konfigurovatelné timeouts pro cold-start orchestrace
# =============================================================================
# Single source of truth pro magic numbers v `aisha-redeploy.mjs`,
# `aisha-cold-start.sh` a souvisejících skriptech.
#
# Per-environment override: source-uj specific .env před spuštěním cold-startu:
#   ENV=staging bash scripts/aisha-cold-start.sh
# Tyto hodnoty mají precedenci přes hardcoded defaulty v skriptech.
#
# Tuning rules:
#   - Ladiž timeouts NAHORU pro slow nodes / pomalé image pulls.
#   - Ladiž STABLE_POLLS NAHORU pro app, které mají flaky startup (false-positive
#     "stable" by acceptlo neúspěšný app).
#   - HEALTH_POLL_S < 5s = zbytečné API calls; > 30s = pomalé feedback.
# =============================================================================

# ── aisha-redeploy.mjs ──────────────────────────────────────────────────────
# Timeout per wave (deploy trigger + health wait). Default 300s = 5 min.
# Bumpni na 600 (10 min) pro slow build pipelines (ledger Cosmos chain init,
# Synapse first-time DB migrations).
AISHA_WAVE_TIMEOUT_S=420

# Polling interval pro health/deployment status checks. Default 5s.
# Snižování pod 5s = hyperaktivní API spam; nad 30s = pomalý feedback.
AISHA_HEALTH_POLL_S=5

# Konsekutivní polls pro acceptaci "stable starting/unhealthy" stavů.
# Default 2 = 10s tolerance (při 5s interval). Bumpni na 6-12 pro production reliability,
# kdy app může dočasně showovat unhealthy během DB migrací.
AISHA_STABLE_POLLS=2

# Wave timeout pro Phase A (waves 1-3: registry + core/pki/edge + keycloak).
# Keycloak first-boot realm import může trvat déle — default 720s.
AISHA_PHASE_A_WAVE_TIMEOUT_S=720

# ── aisha-cold-start.sh ─────────────────────────────────────────────────────
# Curl timeout pro Coolify API calls. Default 30s.
AISHA_COOLIFY_API_TIMEOUT_S=30

# Curl timeout pro git host (origin) reachability checks.
AISHA_GIT_HOST_TIMEOUT_S=10

# Jak dlouho čekat, než Coolify potvrdí smazání aplikací při --wipe (step 2c).
#
# NAMĚŘENO 2026-08-13: ten poll lhůtu NEMĚL (`while true`), takže se u riqu točil
# 185 kol nad jedinou aplikací, jejíž záznam Coolify nedokázal smazat — kontejnery
# byly dávno pryč. Příčina ležela o patro výš: tabulka logů nasazení přerostla
# strop paměti PHP, takže Coolifymu padal i jeho VLASTNÍ úklid zaseknutých úloh.
# Poll bez konce nemůže nikdy dojít k závěru „řídicí rovina to nedokáže" — čeká
# napořád na něco, co se samo nespraví.
#
# ⛔ VÝZNAM ZMĚNĚN 2026-08-26: tohle už NENÍ rozpočet na celé mazání, ale na
# STÁNÍ — jak dlouho se nesmí pohnout NIC. Dokud počet zbývajících aplikací
# klesá, čeká se dál.
#
# Proč: Coolify maže SÉRIOVĚ (`DeleteResourceJob`, 30 s až 1 m 35 s na aplikaci),
# takže 33 aplikací trvá ~25 minut. Strop na celkový čas utnul frontu, která
# pracovala správně — a po pádu skriptu domazala zbytek sama (10 → 7 → 4 → 2 → 1
# během čtyř minut). Hypotéza o paměti PHP výš se přitom NEPOTVRDILA
# (`grep -c "memory size"` = 0), takže hláška posílala operátora na špatnou stopu.
#
# 300 s beze změny je velkorysé: nejdelší jednotlivé mazání trvalo 1 m 35 s.
# Absolutní strop se z téhle hodnoty ODVOZUJE (dvanáctinásobek), aby nebyl
# druhým knoflíkem na tutéž věc.
AISHA_WIPE_CONFIRM_TIMEOUT_S=300

# Wait pro Keycloak readiness po deploy (step 6a). Default 600s = 10 min.
# KC realm import + theme bootstrap může být pomalý při first cold-start.
AISHA_KEYCLOAK_READY_TIMEOUT_S=600

# Wait pro n8n readiness po deploy (step 6b). Default 300s = 5 min.
AISHA_N8N_READY_TIMEOUT_S=300

# Čekání na VERDIKT bootstrapu n8n (klíč → credentials → workflows) z init
# kontejneru; nahraje ~90 workflowů, na vytíženém uzlu to trvá minuty (krok 6).
AISHA_N8N_VERDIKT_TIMEOUT_S=900

# Čekání na EMBEDDING MODEL prostoru v1 před embed kickstartem (krok 6b).
# Vstup kroku přichází pozdě: svc-model se nasazuje až po ai-chat a při prvním
# startu stahuje váhy (naměřeno 2026-09-13: HF ~29,5 MB/s, chat + embed + embed2
# = 5,63 GB ≈ 190 s + načtení). Discovery se od 2026-09-15 VYŽÁDÁ ze smyčky
# čekání (C6), takže na periodu discovery (15 min) se už nečeká.
# ⚠ Hodnota 1500 s vznikla jako „jedna perioda discovery + stažení s rezervou";
# po C6 ji perioda neurčuje. Nová horní mez = stažení + načtení vah + změření
# rozměru embeddingu — načtení a sonda NEZMĚŘENY, proto hodnota zatím beze změny.
AISHA_EMBED_MODEL_TIMEOUT_S=1500

# ── doctor / preflight ──────────────────────────────────────────────────────
# Timeout pro per-API check v cold-start-doctor.sh.
AISHA_DOCTOR_API_TIMEOUT_S=10

# ── local-warmup ────────────────────────────────────────────────────────────
# Timeout pro health-wait po `docker compose up -d` v lokálním warmupu.
AISHA_LOCAL_HEALTH_TIMEOUT_S=180
