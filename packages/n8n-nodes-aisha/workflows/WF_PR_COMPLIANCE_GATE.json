        "url": "={{ $env?.AISHA_POSTGREST_URL || '' }}/rest/v1/rpc/create_ai_run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_kind\": \"pr_gate\",\n  \"p_story_id\": {{ $('Extract PR Context').item.json.story_id ? '\"' + $('Extract PR Context').item.json.story_id + '\"' : 'null' }},\n  \"p_route_plan\": {\n    \"pr_number\": {{ $('Extract PR Context').item.json.pr_number }},\n    \"repo\": \"{{ $('Extract PR Context').item.json.repo_full_name }}\"\n  }\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "create-ai-run",
      "name": "Create AI Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        500
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Z7oSSowoqk0ZgB8X",
          "name": "AISHA Supabase (Service Role)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Evaluate compliance result\nconst complianceResult = $('Validate Compliance').item.json;\nconst rules = complianceResult?.result?.content || [];\nconst prContext = $('Extract PR Context').item.json;\n\n// Simple pass/fail: if we got rules back, compliance context exists\nconst hasRuleset = rules.some(r => r.type === 'resource' && r.resource);\nconst pass = hasRuleset; // In production: run LLM evaluation of diff against rules\n\nreturn {\n  pass,\n  pr_number: prContext.pr_number,\n  repo: prContext.repo_full_name,\n  head_sha: prContext.head_sha,\n  summary: pass \n    ? '✅ Compliance gate passed — rules coverage verified'\n    : '❌ Compliance gate failed — no ruleset pinned or rules violated',\n  violations: pass ? [] : ['No active ruleset found for this story'],\n};"
      },
