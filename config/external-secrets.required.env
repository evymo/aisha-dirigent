# ==============================================================================
# external-secrets.required.env — Onsite MUST-PROVIDE keys for AISHA stack
# ==============================================================================
#
# Cold-start auto-generuje 227 z 239 env vars (95%). Tyto klíče (25 external +
# 9 tool-filled placeholderů) potřebují user input nebo Phase 6 bootstrap.
#
# USAGE (manual onsite setup):
#   1. cp config/external-secrets.required.env .env-prod-backup
#   2. Vyplň hodnoty per provider accounts (viz @source)
#   3. ./scripts/aisha-cold-start.sh
#
# WIZARD USAGE (Dirigent extension / AISHA workbench):
#   Parser čte @-annotated komentáře pro každý klíč:
#     @required:  true (stack-blocking) | false (graceful degraded)
#     @purpose:   1-line popis k čemu klíč slouží
#     @source:    URL nebo příkaz, kde získat hodnotu
#     @degraded:  Co se stane bez klíče (pro graceful keys)
#     @critical:  Speciální poznámka (rotation risk, etc.)
# ==============================================================================

# =============================================================================
# CATEGORY: LLM PROVIDERS (Insight stack — Maestro + Ragnarok)
# =============================================================================

# @required true
# @purpose Primary LLM backend pro Maestro dialog + Ragnarok RAG
# @source https://platform.openai.com/api-keys
# @fallback INSIGHT_LLM_BACKEND=vLLM pro on-prem GPU node (vyžaduje vLLM stack)
# @degraded Maestro story-consult selže, Ragnarok generation neaktivní
OPENAI_API_KEY=

# @required false
# @purpose Anthropic Claude pro multi-provider routing (svc-ai-chat)
# @source https://console.anthropic.com/settings/keys
# @degraded Claude models nedostupné v ai-chat; OpenAI/Maestro pokračují
ANTHROPIC_API_KEY=

# @required false
# @purpose Google AI (Gemini) pro multi-provider routing
# @source https://aistudio.google.com/apikey
# @degraded Gemini models nedostupné; ostatní providers funkční
GOOGLE_AI_API_KEY=

# @required false
# @purpose Cohere rerank backend (Maestro/Ragnarok retrieval boost)
# @source https://dashboard.cohere.com/api-keys
# @degraded Reranking off, vector-only retrieval (kvalitativně mírně horší)
COHERE_API_KEY=

# =============================================================================
# CATEGORY: BLOCKCHAIN (Cosmos validator)
# =============================================================================

# @required true (pokud ledger stack je aktivní)
# @purpose 24-word BIP39 mnemonic pro Cosmos validator identity
# @source openssl rand -hex 32 | xxd -r -p | python3 -c "import bip39; ..." NEBO hardware wallet
# @degraded aisha-ledger app nestartuje, chain neaktivní
# @critical NIKDY nesmí rotovat — ztráta = nepoužitelný chain state, ztráta stake/voting power
COSMOS_SIGNER_MNEMONIC=

# =============================================================================
# CATEGORY: MESH NETWORKING (NetBird zero-trust VPN)
# =============================================================================

# @required true (pro multi-server deploy Frontend+Backend+Experimental)
# @purpose Personal Access Token pro netbird-bootstrap.sh setup-key generation
# @source https://netbird.<your-domain> → Settings → Users → API Tokens
# @degraded netbird-bootstrap.sh selže → setup keys neexistují → cross-server mesh broken
NETBIRD_API_TOKEN=

# =============================================================================
# CATEGORY: EMAIL DELIVERY
# =============================================================================

# @required false
# @purpose Resend.com mailer (transactional emails — confirmation, recovery)
# @source https://resend.com/api-keys
# @fallback SMTP přes ${SMTP_HOST}/${SMTP_USER}/${SMTP_PASS} (nakonfigurováno v .env-prod-backup)
# @degraded Email signup flow používá SMTP fallback (pomalejší, méně reliable)
RESEND_API_KEY=

# =============================================================================
# CATEGORY: 3RD-PARTY MESSAGING BRIDGES (Mautrix Matrix bridges)
# =============================================================================

# @required false
# @purpose Telegram bot bridge — propojí AISHA Matrix room s Telegram chatem
# @source https://my.telegram.org/apps (API_ID + API_HASH) + @BotFather (BOT_TOKEN)
# @degraded Telegram bridge container nestartuje, Matrix funkce zůstávají
TELEGRAM_API_HASH=
TELEGRAM_API_ID=
TELEGRAM_BOT_TOKEN=

# =============================================================================
# CATEGORY: ENTERPRISE SOURCE ONBOARDING (svc-source-broker — federation ingest)
# =============================================================================
# Opt-in per source (tier=optional). Setting SOURCE_API_URL provisions the
# ${prefix}-source-broker Coolify app (coolify-story-init.sh). Note:
# SOURCE_WEBHOOK_HMAC_SECRET is GENERATED by generate-secrets — mirror ITS value
# on the source's webhook signer (it is not an operator input).

# @required false
# @purpose Federated source app base URL — its users (OTP + mantra) → gateway /token-exchange → authenticated aisha session. Empty on non-federated forks (broker not provisioned).
# @source The external source application's public API URL (NOT host.docker.internal)
# @degraded svc-source-broker not provisioned — no external-source ingest
SOURCE_API_URL=

# @required false
# @purpose Read-replica Postgres URL for the source's read-only PG driver (index without exposing).
# @source The source DB read-replica connection string, sslmode=require (TLS enforced)
# @degraded PG-driver source reads unavailable (GraphQL/API driver may still work)
SOURCE_PG_URL=

# @required false
# @purpose Outbound handshake mantra — the phrase svc-source-broker SENDS to authenticate to the source (safe-communication handshake).
# @source Agreed out-of-band with the source operator; must match the source's expected inbound value
# @degraded Source auth handshake fails — broker cannot establish the federated session
SOURCE_AUTH_HANDSHAKE_OUT=

# @required false
# @purpose Inbound handshake mantra — the reply phrase svc-source-broker EXPECTS back from the source.
# @source Agreed out-of-band; must match the source's outbound reply
# @degraded Source auth handshake fails — inbound replies rejected
SOURCE_AUTH_HANDSHAKE_IN=

# =============================================================================
# CATEGORY: OBSERVABILITY (Sentry — error monitoring)
# =============================================================================

# @required false
# @purpose Sentry release tracking + error aggregation
# @source https://sentry.io → Settings → Auth Tokens (scope: project:releases)
# @degraded Sentry monitoring off, production errors nejdou do dashboardu
SENTRY_AUTH_TOKEN=
SENTRY_URL=https://sentry.io
SENTRY_ORG=
SENTRY_PROJECT=

# @required false
# @purpose Sentry DSN injektovaný do frontend buildu (VITE_*)
# @source Sentry → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# =============================================================================
# CATEGORY: WEB PUSH (browser notifications)
# =============================================================================

# @required false
# @purpose VAPID public key pro Web Push API (PWA notifications)
# @source npx web-push generate-vapid-keys (private key v .env-prod-backup separátně)
# @degraded Push notifications off, in-app notifications fungují
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=

# =============================================================================
# CATEGORY: REGISTRY PROXY (your registry-proxy host auth — opt-in private registry)
# =============================================================================

# @required false
# @purpose Pull-through cache credentials pro your registry-proxy host registry
# @source AISHA infra admin (interní registr image cache)
# @degraded Image pulls jdou přímo na docker.io/ghcr.io (rate limits možné)
REGISTRY_PROXY_USERNAME=
REGISTRY_PROXY_PASSWORD=

# =============================================================================
# CATEGORY: COOLIFY + FORGEJO INFRA TOKENS (cold-start orchestration)
# =============================================================================

# @required true (pro cold-start.sh)
# @purpose Coolify API token — vytváří/synchronizuje aplikace přes API
# @source https://<your-coolify-host> → Profile → API Tokens
# @degraded cold-start.sh nemůže vůbec běžet (Phase 0 doctor selže)
COOLIFY_API_KEY=

# @required true (pro deploy webhook setup)
# @purpose Forgejo API token — sets COOLIFY_WEBHOOK_URL secret v repo
# @source https://<your-forgejo-host> → Settings → Applications → Generate Token
# @degraded Coolify auto-deploy on push nebude fungovat; manual redeploy přes UI
FORGEJO_TOKEN=

# =============================================================================
# CATEGORY: AISHA AUTH (regenerated by cold-start, but exposed here for manual override)
# =============================================================================

# @required false (auto-regenerated by cold-start, override jen pro debug/migration)
# @generated true
# @purpose AISHA anonymous JWT (signed with JWT_SECRET, role=anon, 15-year exp)
# @source cold-start.sh gen_aisha_jwt() — necpat manuálně pokud nevíš proč
ANON_KEY=

# @required false (auto-regenerated by cold-start)
# @generated true
# @purpose AISHA service-role JWT (signed with JWT_SECRET, role=service_role)
# @source cold-start.sh gen_aisha_jwt() — necpat manuálně
SERVICE_ROLE_KEY=

# @required false (vygeneruje n8n při first start)
# @generated true
# @purpose n8n Personal API Key — zápis workflows přes API
# @source n8n UI → Settings → API → Create API Key (po prvním přihlášení)
# @degraded npm run aisha:workflows:deploy selže (Phase 6 step) → workflows musí ručně přes UI
N8N_API_KEY=
