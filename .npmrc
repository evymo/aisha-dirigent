# =============================================================================
# AISHA / Evymo NPM Registry Configuration
# =============================================================================
# @aisha/* and @evymo/* packages → private Verdaccio registry (VERDACCIO_URL)
# Everything else → default npmjs.org (via Verdaccio proxy)
#
# Set VERDACCIO_URL=https://npm.<your-internal-tld>/ and VERDACCIO_TOKEN in env.
# CI sets them from repository secrets/variables; local dev reads from .env-prod-backup.
# See scripts/n8n-release.mjs + scripts/aisha-packages-publish.mjs for publishing.
# =============================================================================

@aisha:registry=${VERDACCIO_URL}
@aisha:_authToken=${VERDACCIO_TOKEN}
@evymo:registry=${VERDACCIO_URL}
@evymo:_authToken=${VERDACCIO_TOKEN}
