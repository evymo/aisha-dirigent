+# -*- coding: utf-8 -*-
+"""
+    maestro.api.readiness
+    ~~~~~~~~~~~~~~~~~~~~~
+
+    Readiness probe with USP integrity gate.
+
+    Distinct from ``/health`` (liveness — process running with healthy
+    CPU/disk/memory). ``/health/ready`` adds Maestro-specific readiness
+    checks that gate traffic on USP correctness.
+
+    Multi-turn dialog coherence (Alquist Insight USP, Alexa Prize heritage)
+    requires ``CONTEXT_ENABLED=True``. If the env var was misconfigured
+    (e.g., manually overridden in Coolify UI), the process keeps running
+    but Maestro silently degrades to single-turn responses — the loss of
+    USP is invisible to liveness probes. The readiness probe surfaces this
+    by returning 503 when CONTEXT_ENABLED is false at runtime.
+
+    Used by ``docker-compose.coolify-integration.yml`` healthcheck so that
+    Coolify marks the container ``unhealthy`` and Traefik routes around it
+    until the operator restores correct configuration.
+"""
+
+from datetime import datetime
+
+from dateutil import tz
+from fastapi import status
+from fastapi.responses import Response
+from fastapi.routing import APIRouter
+from pydantic import BaseModel
+
+from common.api.health import HealthService, cpu_checker, disk_checker, memory_checker
+from common.config import CONFIG
+
+router = APIRouter()
+
+
+class Readiness(BaseModel):
+    results: list[HealthService]
+    status: str
+    timestamp: float
+
+
+def context_enabled_checker() -> HealthService:
+    """Verify Maestro multi-turn USP is active.
+
+    Reads ``CONFIG.CONTEXT_ENABLED`` at runtime (Pydantic settings — single
+    source of truth, no hardcoded fallback). The compose contract sets the
+    env var to ``true`` for the Maestro service; this checker ensures the
+    runtime configuration matches the contract.
+    """
+    enabled = CONFIG.CONTEXT_ENABLED
+    return HealthService(
+        checker=context_enabled_checker.__name__,
+        output=str(enabled),
+        passed=bool(enabled),
+    )
+
+
+@router.get(
+    "/health/ready",
+    response_model=Readiness,
+    status_code=status.HTTP_200_OK,
+    summary="Readiness probe — USP integrity gate",
+)
+def get_readiness(response: Response) -> Readiness:
+    results = [
+        cpu_checker(),
+        disk_checker(),
+        memory_checker(),
+        context_enabled_checker(),
+    ]
+
+    if all(r.passed for r in results):
+        r_status = "success"
+    else:
+        r_status = "failed"
+        response.status_code = status.HTTP_503_SERVICE_UNAVAILABLE
+
+    return Readiness(
+        results=results,
+        status=r_status,
+        timestamp=datetime.now(tz=tz.UTC).timestamp(),
+    )
