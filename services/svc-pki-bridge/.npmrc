# Local copy of the root .npmrc — needed because the Dockerfile builds with
# context = ./services/svc-pki-bridge, so files outside this directory are not
# in the build context. Mirrors the root .npmrc form (env-driven, NO hardcoded
# registry host).
#
# Scope mappings (both scopes → the private Verdaccio at $VERDACCIO_URL):
#   @aisha/*  → workspace packages from packages/
#   @evymo/*  → legacy @evymo-scoped packages
#
# VERDACCIO_URL + VERDACCIO_TOKEN are resolved at npm-install time from the
# environment (npm interpolates ${VAR} in .npmrc). In Docker builds both are
# passed via build-arg → ENV (see Dockerfile). The file holds only ${VAR}
# placeholders — never literal host or credentials — and the build stage rm's
# the resolved auth before the runtime stage.

@aisha:registry=${VERDACCIO_URL}
@aisha:_authToken=${VERDACCIO_TOKEN}
@evymo:registry=${VERDACCIO_URL}
@evymo:_authToken=${VERDACCIO_TOKEN}
